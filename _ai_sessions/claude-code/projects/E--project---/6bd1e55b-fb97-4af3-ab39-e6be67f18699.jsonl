   return bool(b.is_connected())\n+        # 兜底：看 pages 能否访问\n+        _ = browser_or_ctx.pages\n+        return True\n+    except Exception:\n+        return False\n+\n+\n+def safe_close(obj, label=\"\"):\n+    \"\"\"安静关闭 page/context/browser，已死也不抛。\"\"\"\n+    if obj is None:\n+        return\n+    try:\n+        obj.close()\n+    except Exception as e:\n+        if label:\n+            log(f\"[浏览器] 关闭{label}时忽略: {e}\")\n+\n+\n+def reopen_erp(p, old_ctx=None, old_page=None):\n+    \"\"\"ERP 持久化 context 被关掉后重新打开。\n+    返回 (ctx, page)。先尽量关旧的（释放 profile 锁），再 launch_persistent_context。\n+    调用方应再 ensure_erp / wait_for_erp_relogin 确认会话。\"\"\"\n+    safe_close(old_page, \"旧ERP page\")\n+    safe_close(old_ctx, \"旧ERP context\")\n+    # Windows 上 profile 锁偶发未立刻释放，稍等再开\n+    time.sleep(1.5)\n+    log(\"[浏览器] ERP 窗口已关/失效 → 重新启动持久化浏览器…\")\n+    ctx = open_context(p)\n+    page = ctx.pages[0] if ctx.pages else ctx.new_page()\n+    try:\n+        maximize_page(page)\n+    except Exception:\n+        pass\n+    log(\"[浏览器] ERP 浏览器已重启\")\n+    return ctx, page\n+\n+\n+def reopen_wms_browser(p, old_browser=None):\n==== NOTIFY DIFF ====\nwarning: in the working copy of 'sellfox-bridge/bridge/notify.py', LF will be replaced by CRLF the next time Git touches it\ndiff --git a/sellfox-bridge/bridge/notify.py b/sellfox-bridge/bridge/notify.py\nindex 1bd9214..61514cf 100644\n--- a/sellfox-bridge/bridge/notify.py\n+++ b/sellfox-bridge/bridge/notify.py\n@@ -1,28 +1,126 @@\n-\"\"\"告警：飞书群机器人 webhook；未配置时仅写日志。\"\"\"\n+\"\"\"告警：飞书群机器人 webhook（交互卡片）；未配置时仅写日志。\"\"\"\n+from __future__ import annotations\n+\n import logging\n+from datetime import datetime\n+from typing import Iterable, Mapping, Optional, Sequence\n \n import requests\n \n log = logging.getLogger(__name__)\n \n+# 飞书 header.template 色板\n+TEMPLATE = {\n+    \"high\": \"red\",       # 严重\n+    \"medium\": \"orange\",  # 需关注\n+    \"warn\": \"orange\",\n+    \"ok\": \"green\",       # 成功/一致\n+    \"info\": \"blue\",      # 一般信息\n+  