{"timestamp":1785313903,"method":"session/update","params":{"sessionId":"019fab7f-7ed9-7553-a471-73b6cca96147","update":{"sessionUpdate":"tool_call_update","toolCallId":"call-d37213b6-18cc-4611-a8da-b6af4a73ab7c-149","status":"completed","content":[{"type":"diff","path":"E:\\project\\清泉跨境系统（企业级）\\backend\\app\\api\\ingest.py","oldText":"    await db.execute(\n        text(\n            \"\"\"\n            INSERT INTO fact_ads_campaign_daily (\n                id, shop_id, shop_external_id, shop_name, biz_date, campaign_name,\n                spend, orders, roi, revenue, currency, row_status, source_url,\n                collected_at, ingest_id, created_at, updated_at\n            ) VALUES (\n                :id, :shop_id, :shop_external_id, :shop_name, :biz_date, :campaign_name,\n                :spend, :orders, :roi, :revenue, :currency, :row_status, :source_url,\n                :collected_at, :ingest_id, now(), now()\n            )\n            ON CONFLICT (shop_external_id, campaign_name, biz_date) DO UPDATE SET\n                spend = EXCLUDED.spend,\n                orders = EXCLUDED.orders,\n                roi = EXCLUDED.roi,\n                revenue = EXCLUDED.revenue,\n                currency = EXCLUDED.currency,\n                row_status = EXCLUDED.row_status,\n                source_url = EXCLUDED.source_url,\n                collected_at = EXCLUDED.collected_at,\n                ingest_id = EXCLUDED.ingest_id,\n                shop_id = COALESCE(EXCLUDED.shop_id, fact_ads_campaign_daily.shop_id),\n                shop_name = COALESCE(EXCLUDED.shop_name, fact_ads_campaign_daily.shop_name),\n                updated_at = now()\n            \"\"\"\n        ),\n        {\n            \"id\": str(uuid4()),\n            \"shop_id\": shop_uuid,\n            \"shop_external_id\": env.shop_id,\n            \"shop_name\": env.shop_name,\n            \"biz_date\": env.biz_date,\n            \"campaign_name\": campaign,\n            \"spend\": float(p.get(\"spen