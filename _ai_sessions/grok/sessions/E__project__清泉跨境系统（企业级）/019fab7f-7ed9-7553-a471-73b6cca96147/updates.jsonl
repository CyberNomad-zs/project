') -or\n      ($names -contains 'before') -or ($names -contains 'after') -or\n      ($names -contains 'clicked') -or ($names -contains 'matched') -or\n      ($names -contains 'range') -or ($names -contains 'panelOpen')\n    )\n  }\n  return Get-PageExecJsonPayload $execOut $shape\n}\n\nfunction Get-ScrapePayload([string]$execOut) {\n  # Our scraper returns JSON.stringify({ ok, rows, source, url, error })\n  $shape = {\n    param($o)\n    if ($null -eq $o) { return $false }\n    if ($o -is [string]) { return $false }\n    $names = @($o.PSObject.Properties.Name)\n    return ($names -contains 'rows') -or (($names -contains 'ok') -and ($names -contains 'source' -or $names -contains 'error'))\n  }\n  $hit = Get-PageExecJsonPayload $execOut $shape\n  if ($hit) { return $hit }\n  if ($execOut -match '(?s)(\\{\\s*\"ok\"\\s*:\\s*(?:true|false)\\s*,\\s*\"source\"[\\s\\S]*?\"rows\"\\s*:\\s*\\[[\\s\\S]*?\\})') {\n    return (ConvertFrom-JsonSafe $Matches[1])\n  }\n  return $null\n}","replace_all":false},"_meta":{"x.ai/tool":{"version":1,"name":"search_replace","kind":"edit","namespace":"grok_build","label":"Edit","read_only":false,"input":{"path":"E:\\project\\清泉跨境系统（企业级）\\collectors\\tiktok-ads\\scripts\\run-multi-store.ps1"}}}},"_meta":{"totalTokens":311518,"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-34690","agentTimestampMs":1785386224308,"promptId":"065075da-d882-4b40-a553-30b2883f8998","streamStartMs":1785386194372,"turnStartMs":1785385319846,"updateType":"ToolCallUpdate","updateParams":{"toolCallId":"call-b289b95e-9b86-49ac-bc74-4e96307303b7-271","status":null}}}}
