(function () {
  function t(el) {
    return (el && el.textContent ? el.textContent : '').replace(/\s+/g, ' ').trim().slice(0, 120);
  }
  var out = {
    url: location.href,
    title: document.title,
    tables: document.querySelectorAll('table').length,
    roleRows: document.querySelectorAll('[role="row"]').length,
    roleGrids: document.querySelectorAll('[role="grid"],[role="table"]').length,
    ths: [],
    bodyPreview: (document.body && document.body.innerText ? document.body.innerText : '').slice(0, 2000),
    candidates: [],
    topClasses: []
  };
  var ths = document.querySelectorAll('th');
  for (var i = 0; i < ths.length && i < 25; i++) out.ths.push(t(ths[i]));

  // header-like cells
  var heads = document.querySelectorAll('[class*="header"],[class*="Header"],[class*="column"],[class*="Column"]');
  for (var h = 0; h < heads.length && out.candidates.length < 40; h++) {
    var s = t(heads[h]);
    if (!s || s.length > 40) continue;
    if (/商品|产品|SKU|库存|价格|状态|销量|Product|Stock|Price|Status/i.test(s)) {
      out.candidates.push({
        tag: heads[h].tagName,
        text: s,
        cls: (heads[h].className || '').toString().slice(0, 80)
      });
    }
  }

  var all = document.querySelectorAll('div,span,th,td,a,button');
  for (var j = 0; j < all.length && out.candidates.length < 50; j++) {
    var s2 = t(all[j]);
    if (!s2 || s2.length > 40) continue;
    if (/^商品名称$|^产品名称$|^库存$|^价格$|^状态$|^销量$|Seller SKU|商品ID|Product ID/i.test(s2)) {
      out.candidates.push({
        tag: all[j].tagName,
        text: s2,
        cls: (all[j].className || '').toString().slice(0, 80)
      });
    }
  }

  // class hints
  var classHints = {};
  var els = document.querySelectorAll('[class*="product"],[class*="Product"],[class*="table"],[class*="list"],[class*="sku"],[class*="SKU"]');
  for (var c = 0; c < els.length; c++) {
    var cn = (els[c].className || '').toString().split(/\s+/).slice(0, 3).join('.');
    if (!cn) continue;
    classHints[cn] = (classHints[cn] || 0) + 1;
  }
  var keys = Object.keys(classHints);
  keys.sort(function (a, b) { return classHints[b] - classHints[a]; });
  for (var k = 0; k < keys.length && k < 20; k++) {
    out.topClasses.push({ c: keys[k], n: classHints[keys[k]] });
  }

  // sample first table rows if any
  var tables = document.querySelectorAll('table');
  if (tables.length) {
    var trs = tables[0].querySelectorAll('tr');
    out.sampleRows = [];
    for (var r = 0; r < trs.length && r < 3; r++) {
      var cells = [];
      var tds = trs[r].querySelectorAll('th,td');
      for (var d = 0; d < tds.length && d < 12; d++) cells.push(t(tds[d]).slice(0, 80));
      out.sampleRows.push(cells);
    }
  }
  return JSON.stringify(out);
})();
