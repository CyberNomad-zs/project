# backfill null biz_date from raw_extra.create_time_raw
import json
import os
import re
from datetime import date, datetime, timedelta

from sqlalchemy import create_engine, text

WEEKDAY = {"一": 0, "二": 1, "三": 2, "四": 3, "五": 4, "六": 5, "日": 6, "天": 6}


def parse_dt(v, ref: datetime):
    if not v:
        return None
    s = str(v).strip()
    if re.search(r"截止|送达日期|delivery\s*by", s, re.I) and not re.search(
        r"分钟前|小时前|天前|今天|昨天|星期|周", s
    ):
        return None
    s2 = re.sub(r"57\d{16}", " ", s)
    s2 = re.sub(r"\b\d{15,20}\b", " ", s2)
    s2 = re.sub(r"\s+", " ", s2).strip()
    m = re.search(r"(\d{1,4})\s*分钟前", s2)
    if m:
        return ref - timedelta(minutes=int(m.group(1)))
    m = re.search(r"(\d{1,4})\s*小时前", s2)
    if m:
        return ref - timedelta(hours=int(m.group(1)))
    m = re.search(r"(\d{1,4})\s*天前", s2)
    if m:
        return ref - timedelta(days=int(m.group(1)))
    m = re.search(r"(今天|昨天)\s*(\d{1,2}):(\d{2})(?::(\d{2}))?", s2)
    if m:
        day = ref.date() if m.group(1) == "今天" else (ref.date() - timedelta(days=1))
        sec = int(m.group(4) or 0)
        return datetime(day.year, day.month, day.day, int(m.group(2)), int(m.group(3)), sec)
    m = re.search(r"(?:星期|周)([一二三四五六日天])\s*(\d{1,2}):(\d{2})(?::(\d{2}))?", s2)
    if m:
        tw = WEEKDAY.get(m.group(1))
        if tw is not None:
            delta = (ref.weekday() - tw) % 7
            day = ref.date() - timedelta(days=delta)
            sec = int(m.group(4) or 0)
            return datetime(day.year, day.month, day.day, int(m.group(2)), int(m.group(3)), sec)
    for fmt in (
        "%Y-%m-%d %H:%M:%S",
        "%Y/%m/%d %H:%M:%S",
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%d",
        "%Y/%m/%d",
    ):
        try:
            return datetime.strptime(s2, fmt)
        except ValueError:
            pass
    return None


def main() -> None:
    url = os.environ.get("DATABASE_URL", "")
    url = url.replace("postgresql+asyncpg://", "postgresql://")
    if not url:
        raise SystemExit("no DATABASE_URL")
    eng = create_engine(url)
    with eng.begin() as conn:
        rows = conn.execute(
            text(
                """
                SELECT id::text, raw_extra, collected_at
                FROM tk.fact_tiktok_order
                WHERE biz_date IS NULL
                  AND raw_extra ? 'create_time_raw'
                  AND coalesce(raw_extra->>'create_time_raw','') <> ''
                """
            )
        ).fetchall()
        print("candidates", len(rows))
        updated = 0
        skipped = 0
        for rid, raw, coll in rows:
            if isinstance(raw, str):
                raw = json.loads(raw)
            raw = raw or {}
            ctr = raw.get("create_time_raw") or raw.get("createTimeRaw")
            ref = coll or datetime.utcnow()
            if getattr(ref, "tzinfo", None):
                ref = ref.replace(tzinfo=None)
            dt = parse_dt(ctr, ref)
            if not dt:
                skipped += 1
                continue
            biz = dt.date()
            ref_day = ref.date()
            if biz > ref_day + timedelta(days=1):
                skipped += 1
                continue
            conn.execute(
                text(
                    """
                    UPDATE tk.fact_tiktok_order
                    SET create_time = :ct, biz_date = :bd, updated_at = now()
                    WHERE id = CAST(:id AS uuid)
                    """
                ),
                {"ct": dt, "bd": biz, "id": rid},
            )
            updated += 1
        print("updated", updated, "skipped", skipped)
        n = conn.execute(
            text(
                "SELECT count(*) FILTER (WHERE biz_date IS NULL), count(*) FROM tk.fact_tiktok_order"
            )
        ).one()
        print("null_biz", n[0], "total", n[1])


if __name__ == "__main__":
    main()
