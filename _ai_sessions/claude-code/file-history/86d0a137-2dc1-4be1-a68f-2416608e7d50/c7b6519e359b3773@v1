// 隔离世界：① 注入 inject.js；② 转发接口响应(带当前店名)；③ 读流量待关注 chip；
// ④ 接收后台指令自动切店(轮巡用)。
(function () {
  const LOG = (...a) => { try { console.log('[TemuMon]', ...a); } catch (e) {} };
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

  // 注入 MAIN world hook
  try {
    const s = document.createElement('script');
    s.src = chrome.runtime.getURL('inject.js');
    s.onload = () => s.remove();
    (document.head || document.documentElement).appendChild(s);
  } catch (e) { /* ignore */ }

  // ---------- 读当前店铺名（右上角英文店名） ----------
  function findStoreNameEl() {
    const W = window.innerWidth;
    let best = null;
    for (const el of document.querySelectorAll('span,a,div,button,p')) {
      const t = (el.textContent || '').trim();
      if (!/^[A-Za-z][A-Za-z0-9]*(?:\s[A-Za-z0-9]+){0,3}$/.test(t)) continue;
      if (t.length < 2 || t.length > 30) continue;
      if (/^(Seller Central|Beta|NEW|SKC|SKU|USD|Best Seller)$/i.test(t)) continue;
      if (el.children.length > 2) continue;
      const r = el.getBoundingClientRect();
      if (r.width === 0 || r.top < 0 || r.top > 90) continue;
      if (r.left < W * 0.5) continue;
      if (!best || r.left > best.left) best = { el, left: r.left };
    }
    return best ? best.el : null;
  }
  function readStoreName() { const el = findStoreNameEl(); return el ? (el.textContent || '').trim() : null; }

  // ---------- 转发接口响应 ----------
  window.addEventListener('message', (e) => {
    if (e.source !== window) return;
    const d = e.data;
    if (!d || d.__temuMon !== true) return;
    try { chrome.runtime.sendMessage({ type: 'capture', kind: d.kind, url: d.url, body: d.body, store: readStoreName() }); } catch (err) {}
  });

  // ---------- 读流量异常：两类「快速筛选」chip 的计数 ----------
  // 两个 chip 是常驻筛选项：「商品流量待关注 N」「商品流量近期有下降 N」，各带自己的数字。
  // 关键：不能靠"标签文本是否存在"判断有无异常——标签一直在，只有 N>0 才是真有异常。
  // （之前用存在性判断，导致每个店都误报"流量下降 有"。）
  function readChipCount(all, label) {
    const re = new RegExp(label);
    const labels = all
      .filter((e) => re.test(e.textContent || '') && (e.textContent || '').trim().length < 24)
      .sort((a, b) => (a.textContent || '').length - (b.textContent || '').length);
    for (const el of labels) {
      // 标签后允许 0~3 个非数字字符（空格/冒号/括号），避免误吞相邻 chip 的数字
      for (const cand of [el, el.parentElement, el.parentElement && el.parentElement.parentElement]) {
        if (!cand) continue;
        const m = (cand.textContent || '').match(new RegExp(label + '[^\\d]{0,3}([\\d,]+)'));
        if (m) return Number(m[1].replace(/,/g, ''));
      }
      // 数字在标签之后的独立兄弟徽标里（未与标签拼接进同一文本）
      let sib = el.nextElementSibling;
      for (let i = 0; i < 3 && sib; i++, sib = sib.nextElementSibling) {
        const st = (sib.textContent || '').trim();
        if (/^[\d,]+$/.test(st)) return Number(st.replace(/,/g, ''));
      }
    }
    return null; // 读不到 → 未知（不当作 0，也不当作"有"）
  }
  // 「商品流量近期有下降」不是带计数的筛选 chip，而是逐行的红色徽标（列「商品优化事项」下）。
  // 因此按"当前页可见的行内徽标个数"来统计。注意：只覆盖当前页（默认 20 条/页），
  // 下降商品若在其它页则数不到——被动读数的固有限制，要精确总数得点筛选（主动模式）。
  function countDeclineBadges(all) {
    let n = 0;
    for (const e of all) {
      const t = (e.textContent || '').trim();
      if (!/商品流量近期有下降/.test(t) || t.length > 20) continue;
      // 只数最内层节点，避免父容器重复计数
      if ([...e.children].some((c) => /商品流量近期有下降/.test(c.textContent || ''))) continue;
      const r = e.getBoundingClientRect();
      if (r.width > 0 && r.height > 0) n++; // 只数真正渲染出来的行徽标，排除隐藏的筛选项/图例
    }
    return n;
  }
  function readTraffic() {
    const all = [...document.querySelectorAll('*')];
    return {
      watch: readChipCount(all, '商品流量待关注'),
      decline: countDeclineBadges(all),
    };
  }
  let tries = 0;
  const iv = setInterval(() => {
    tries++;
    // 商品表格是否已渲染出行——下降徽标在行里，必须等行出来再数，否则会在徽标出现前就读成 0
    const gridReady = !!document.querySelector('[data-testid="beast-core-table-body-tr"]');
    const { watch, decline } = readTraffic();
    const msg = { type: 'chipStats', store: readStoreName() };
    if (watch != null) msg.trafficWatch = watch;
    if (gridReady) msg.trafficDecline = decline; // 仅在表格渲染后 decline 才可信
    if (msg.trafficWatch != null || 'trafficDecline' in msg) {
      try { chrome.runtime.sendMessage(msg); } catch (e) {}
    }
    // 待关注读到且表格已渲染即定稿；否则最长约 40s
    if ((watch != null && gridReady) || tries > 20) clearInterval(iv);
  }, 2000);

  // ---------- 切店自动化（轮巡用，由后台指令驱动） ----------
  async function waitFor(fn, timeout, step) {
    const t0 = Date.now();
    for (;;) { let r; try { r = fn(); } catch (e) { r = null; } if (r) return r; if (Date.now() - t0 > (timeout || 6000)) return null; await sleep(step || 200); }
  }
  function textEls(re, maxLen) {
    return [...document.querySelectorAll('*')].filter((e) => { const t = (e.textContent || '').trim(); return re.test(t) && t.length <= (maxLen || 40); });
  }
  function innermost(els) { return els.slice().sort((a, b) => (a.textContent || '').length - (b.textContent || '').length)[0] || null; }
  function clickableAncestor(el) { let n = el; for (let i = 0; i < 5 && n; i++) { if (n.tagName === 'BUTTON' || n.tagName === 'A' || n.getAttribute('role') === 'button') return n; n = n.parentElement; } return el; }
  // 完整鼠标事件序列（很多组件要 mousedown/up 才触发，单纯 click 不生效）
  function realClick(el) {
    if (!el) return false;
    const opts = { bubbles: true, cancelable: true, view: window };
    try { el.scrollIntoView({ block: 'center' }); } catch (e) {}
    for (const type of ['pointerdown', 'mousedown', 'mouseup', 'click']) {
      try { el.dispatchEvent(new MouseEvent(type, opts)); } catch (e) {}
    }
    try { el.click(); } catch (e) {}
    return true;
  }
  function modalOpen() { return textEls(/切换店铺|您的账户存在/, 20).length > 0; }
  function closeModal() {
    const x = document.querySelector('[aria-label="Close"],[aria-label="关闭"],.beast-core-modal-close,.semi-modal-close,.SnowModal_closeIcon');
    if (x) { realClick(x); return; }
    document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', keyCode: 27, bubbles: true }));
  }

  // 压缩输出某元素的 HTML 骨架（去 style/data 属性），便于回传诊断
  function domSkel(el, maxLen) {
    if (!el) return 'null';
    let h = (el.outerHTML || '');
    h = h.replace(/\s(style|data-[\w-]+|aria-[\w-]+)="[^"]*"/g, '').replace(/>\s+</g, '><').replace(/\s{2,}/g, ' ');
    return h.slice(0, maxLen || 2200);
  }

  function visible(el) { const b = el.getBoundingClientRect(); return b.width > 0 && b.height > 0; }

  async function openStoreModal(diag) {
    diag = diag || [];
    if (modalOpen()) { diag.push('弹窗已开'); return true; }
    const nameEl = findStoreNameEl();
    diag.push('店名=' + (nameEl ? (nameEl.textContent || '').trim() : 'null'));
    if (nameEl) {
      // 只点一次触发下拉：点店名的可点祖先 + 店名右侧箭头坐标（避免多次点击把下拉又关掉）
      const r = nameEl.getBoundingClientRect();
      realClick(clickableAncestor(nameEl));
      const el = document.elementFromPoint(Math.min(window.innerWidth - 3, r.right + 14), r.top + r.height / 2);
      if (el && el !== nameEl) realClick(el);
    }
    // 下拉里“切换”按钮：只认可见的、精确文本“切换”，取最后一个（下拉通常在 DOM 靠后）
    const sw = await waitFor(() => {
      const cands = textEls(/^切换$/, 6).filter(visible);
      return cands.length ? clickableAncestor(cands[cands.length - 1]) : null;
    }, 3500);
    diag.push('下拉切换按钮=' + !!sw);
    if (sw) realClick(sw);
    const ok = !!(await waitFor(() => (modalOpen() ? true : null), 4500));
    diag.push('弹窗打开=' + ok);
    if (!ok) {
      const cands = textEls(/切换/, 8).map((e) => {
        const b = e.getBoundingClientRect();
        return e.tagName + '.' + String(e.className || '').split(' ')[0] + '[' + (e.textContent || '').trim().slice(0, 6) + ',y' + Math.round(b.top) + ',w' + Math.round(b.width) + ']';
      });
      diag.push('切换候选(' + cands.length + ')=' + cands.join(' '));
      diag.push('模态计数 切换店铺=' + textEls(/切换店铺/, 20).length + ' 您的账户=' + textEls(/您的账户/, 40).length);
    }
    return ok;
  }

  async function listStores() {
    if (!(await openStoreModal())) return [];
    await sleep(500);
    // 每个店铺行都带“半托管/全托管”标签；据此定位店名，避开背景页面的杂项英文
    const tags = textEls(/托管/, 6).filter(visible);
    const names = [];
    for (const tag of tags) {
      let row = tag.parentElement;
      for (let i = 0; i < 4 && row; i++) {
        const en = [...row.querySelectorAll('span,div,p,a')]
          .map((e) => (e.textContent || '').trim())
          .find((t) => /^[A-Za-z][A-Za-z0-9]*(?:\s[A-Za-z0-9]+){0,3}$/.test(t) && t.length >= 2 && t.length <= 30 && !/^(NEW|Beta)$/i.test(t));
        if (en) { names.push(en); break; }
        row = row.parentElement;
      }
    }
    closeModal();
    const uniq = [...new Set(names)];
    LOG('listStores =>', uniq);
    return uniq;
  }

  async function switchTo(target) {
    const diag = [];
    if (!(await openStoreModal(diag))) return { ok: false, msg: '打不开弹窗 | ' + diag.join(' ; ') };
    await sleep(300);
    const esc = String(target).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const rows = textEls(new RegExp(esc), 120).filter((e) => /切换/.test(e.textContent || ''));
    const row = innermost(rows);
    if (!row) { closeModal(); return { ok: false, msg: '弹窗里没找到店铺 ' + target }; }
    let btn = [...row.querySelectorAll('button,[role=button]')].find((b) => /切换/.test(b.textContent || '') && !b.disabled && b.getAttribute('aria-disabled') !== 'true');
    if (!btn) {
      const cands = textEls(/^切换$/, 6).map(clickableAncestor).filter((b) => b && !b.disabled);
      btn = cands.find((b) => row.contains(b) || (b.compareDocumentPosition(row) & Node.DOCUMENT_POSITION_CONTAINED_BY)) || null;
    }
    if (!btn) { closeModal(); return { ok: false, msg: '没找到可点的切换按钮(' + target + ')，可能已是当前店' }; }
    LOG('switchTo click', target);
    realClick(btn); // 触发切店（SPA 更新或整页重载）
    return { ok: true, msg: '已点击切换到 ' + target };
  }

  chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
    if (!msg || !msg.cmd) return;
    (async () => {
      try {
        if (msg.cmd === 'ping') { sendResponse({ store: readStoreName() }); return; }
        if (msg.cmd === 'listStores') { sendResponse({ names: await listStores() }); return; }
        if (msg.cmd === 'switchTo') { sendResponse(await switchTo(msg.target)); return; }
      } catch (e) { sendResponse({ ok: false, msg: String((e && e.message) || e) }); }
    })();
    return true;
  });
})();
