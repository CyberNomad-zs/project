\t    必须限定 :visible —— 页面存在多个隐藏 el-dialog，不限定会点到隐藏弹窗、可见弹窗关不掉，\n167\t    残留弹窗会拦截后续点击（2026-07-10 DRY 演练实测：全选被 el-dialog__wrapper 拦截超时）。\"\"\"\n168\t    for sel in (\".el-dialog:visible button:has-text('取 消')\",\n169\t                \".el-dialog:visible button:has-text('取消')\",\n170\t                \".el-dialog:visible .el-dialog__headerbtn\"):\n171\t        try:\n172\t            b = page.query_selector(sel)\n173\t            if b and b.is_visible():\n174\t                b.click(); time.sleep(0.6); return\n175\t        except Exception:\n176\t            pass\n177\t    try:\n178\t        page.keyboard.press(\"Escape\")\n179\t    except Exception:\n180\t        pass\n181\t    time.sleep(0.6)\n182\t\n183\t\n184\tdef batch_ship(page):\n185\t    \"\"\"点击'批量发货'，处理'预发货成功'提示。DRY_RUN 下不执行。\"\"\"\n186\t    if config.DRY_RUN:\n187\t        log(\"[WMS][DRY] 将点击'批量发货'（已跳过）\")\n188\t        return True\n189\t    try:\n190\t        page.click(\"button:has-text('批量发货')\", timeout=6000)\n191\t        time.sleep(2)\n192\t        # 可能的二次确认（限可见弹窗）\n193\t        for t in [\"确定\", \"确认\", \"ok\", \"OK\"]:\n194\t            b = page.query_selector(f\".el-message-box__wrapper:visible button:has-text('{t}'), .el-dialog:visible button:has-text('{t}')\")\n195\t            if b and b.is_visible():\n196\t                try: b.click(); time.sleep(1.5)\n197\t                except Exception: pass\n198\t                break\n199\t        time.sleep(2)\n200\t        tips = close_tips(page)   # 捕获并关闭 'Tip: 预发货成功'\n201\t        ok = any(\"预发货成功\" in t or \"成功\" in t for t in tips)\n202\t        log(f\"[WMS] 已执行批量发货  结果Tip={tips}\")\n203\t        return ok if tips else True\n204\t    except Exception as e:\n205\t        log(f\"[WMS] 批量发货失败: {e}\")\n206\t        return False\n207\t\n208\t\n209\tdef read_order_numbers(page):\n210\t    \"\"\"读当前未发货列表的平台订单号（去重）。订单号形如 P2AC6TCD61443。\"\"\"\n211\t    try:\n212\t        nums = page.evaluate(r\"\"\"() => {\n213\t            const s=new Set();\n214\t            document.querySelectorAll('.el-table__row').forEach(r=>{\n215\t                const m=(r.innerText||'').match(/P[0-9A-Z]{9,15}/g); if(m) m.forEach(x=>s.add(x));\n216\t            });\n217\t            return [...s];\n218\t        }\"\"\")\n219\t        return nums or []\n220\t    except Exception:\n221\t        return []\n222\t\n223\t\n224\tdef ship_shop(wms_browser, account, courier):\n225\t    \"\"\"给单个店铺发货：用【独立干净 WMS context】登录 + process_shop，用完即关。\n226\t    独立 context 是根治「多账号共用一个 context 时，第二个账号登录读到前一个账号会话」\n227\t    的关键（实测 2026-07-10：黑猫先登→金猫后登，金猫会读到黑猫的空列表=漏发）。\n228\t    wms_browser: 独立于 ERP 持久 context 的 browser（run_shipping/shipping_loop 里 launch）。\n229\t    返回 process_shop 的结果 dict。\"\"\"\n230\t    wctx = wms_browser.new_context(ignore_https_errors=True)\n231\t    wpage = wctx.new_page()\n232\t    try:\n233\t        return process_shop(wpage, account, courier)\n234\t    finally:\n235\t        try:\n236\t            wctx.close()\n237\t        except Exception:\n238\t            pass\n239\t\n240\t\n241\tdef process_shop(page, account, courier, already_logged_in=False):\n242\t    \"\"\"处理单个店铺：用【该渠道对应的单一快递方 courier】改快递方 + 批量发货一次。\n243\t    失败的单留在'未发货'即留存（不换别的快递方、不轮转，用户规则 2026-07-09）。\n244\t    返回 {shop, courier, before, left, left_orders}。\"\"\"\n245\t    log(f\"[WMS] === 处理店铺 {account['shop']}（{account['login']}），本渠道快递方 = {courier} ===\")\n246\t    if not courier:\n247\t        log(f\"[WMS] ⚠️ {account['shop']} 未解析出快递方，跳过发货（留存交上层处理）\")\n248\t        return {\"shop\": account[\"shop\"], \"courier\": \"\", \"error\": \"无快递方\", \"left_orders\": []}\n249\t    if not already_logged_in and not core.wms_login(page, account):\n250\t        log(f\"[WMS] {account['shop']} 登录失败，跳过\")\n251\t        return {\"shop\": account[\"shop\"], \"courier\": courier, \"error\": \"登录失败\", \"left_orders\": []}\n252\t    open_platform_orders(page)\n253\t    ensure_unshipped_filter(page)\n254\t\n255\t    total_before = count_rows(page)\n256\t    log(f\"[WMS] {account['shop']} 未发货订单 ≈ {total_before} 条\")\n257\t    if total_before == 0:\n258\t        log(f\"[WMS] {account['shop']} 无未发货订单\")\n259\t        return {\"shop\": account[\"shop\"], \"courier\": courier, \"before\": 0, \"left\": 0, \"left_orders\": []}\n260\t\n261\t    limit = config.MAX_ORDERS_PER_RUN\n262\t    if limit and total_before > limit:\n263\t        log(f\"[WMS][安全] 未发货 {total_before} > 单次上限 {limit}，建议调大 MAX_ORDERS_PER_RUN 或分批。\")\n264\t\n265\t    # 单一快递方：全选 -> 改成 courier -> 重新全选（改后列表刷新丢勾选） -> 批量发货。只一次，不轮转。\n266\t    log(f\"[WMS] 用快递方 [{courier}] 处理 {total_before} 条\")\n267\t    if not select_all(page):\n268\t        log(\"[WMS] 无法全选（可能无数据/禁用），本渠道未发货\")\n269\t    elif not set_courier(page, courier):\n270\t        log(f\"[WMS] 改快递方 {courier} 未成功，本渠道未发货\")\n271\t    elif not set_remote_filter(page, \"否\"):\n272\t        # 需求2：偏远筛选失败则不发货（宁可留存，也不误发偏远/全量单）\n273\t        log(\"[WMS] 设置偏远地区=否 未成功，为避免误发偏远单，本渠道未发货\")\n274\t    elif not select_all(page):\n275\t        log(\"[WMS] 改快递方后重新全选失败，本渠道未发货\")\n276\t    else:\n277\t        batch_ship(page)\n278\t        time.sleep(2)\n279\t\n280\t    open_platform_orders(page)\n281\t    ensure_unshipped_filter(page)\n282\t    left = count_rows(page)\n283\t    left_orders = read_order_numbers(page) if left else []\n284\t    dry = \"（DRY_RUN 未真正发货）\" if config.DRY_RUN else \"\"\n285\t    log(f\"[WMS] {account['shop']} 处理完成，仍未发货 ≈ {left} 条{dry}\")\n286\t    if left and not config.DRY_RUN:\n287\t        log(f\"[WMS] ⚠️ {account['shop']} 用 {courier} 发货后仍未发货（留存，不换快递方）：{left_orders}\")\n288\t    core.log.event(\"WMS发货汇总\", shop=account[\"shop\"], account=account[\"login\"], courier=courier,\n289\t                   before=total_before, shipped=max(0, total_before - left),\n290\t                   left=left, left_orders=left_orders)\n291\t    return {\"shop\": account[\"shop\"], \"courier\": courier, \"before\": total_before,\n292\t            \"left\": left, \"left_orders\": left_orders}\n293\t"}]},"uuid":"441ecdf3-fc69-4864-b8e7-c7e943923d8f","timestam