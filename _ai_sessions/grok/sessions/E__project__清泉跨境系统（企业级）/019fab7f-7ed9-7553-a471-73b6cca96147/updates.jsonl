{"timestamp":1785313490,"method":"session/update","params":{"sessionId":"019fab7f-7ed9-7553-a471-73b6cca96147","update":{"sessionUpdate":"tool_call","toolCallId":"call-7b3e45f6-b855-4af1-99f7-6d615aaf898d-109","title":"search_replace","rawInput":{"file_path":"E:\\project\\清泉跨境系统（企业级）\\collectors\\tiktok-ads\\logs\\_probe-ads-page.js","new_string":"(() => {\n  function clean(t) {\n    return String(t ?? '').replace(/\\s+/g, ' ').trim();\n  }\n  const url = location.href;\n  const title = document.title;\n  const text = clean((document.body && document.body.innerText) || '').slice(0, 4000);\n\n  // table headers\n  const headers = [];\n  document.querySelectorAll('table thead th, table thead td, [role=\"columnheader\"]').forEach((el) => {\n    const t = clean(el.innerText || el.textContent);\n    if (t && t.length < 80) headers.push(t);\n  });\n\n  // first data table sample cells\n  const firstRow = [];\n  const tr = document.querySelector('table tbody tr');\n  if (tr) {\n    tr.querySelectorAll('td, th').forEach((td) => {\n      firstRow.push(clean(td.innerText || td.textContent).slice(0, 60));\n    });\n  }\n\n  // nav / menu labels (seller center)\n  const nav = [];\n  document.querySelectorAll('nav a, [class*=\"menu\"] a, [class*=\"Menu\"] a, aside a').forEach((a) => {\n    const t = clean(a.innerText || a.textContent);\n    if (t && t.length < 40 && t.length > 1) nav.push(t);\n  });\n  const navUniq = [...new Set(nav)].slice(0, 40);\n\n  // metric cards / KPI labels near top\n  const kpiCandidates = [];\n  document.querySelectorAll('[class*=\"metric\"], [class*=\"Metric\"], [class*=\"stat\"], [class*=\"Stat\"], [class*=\"card\"], [class*=\"Card\"]').forEach((el) => {\n    const t = clean(el.innerText || el.textContent);\n    if (t && t.length > 2 && t.length < 120) kpiCandidates.push(t);\n  });\n\n  // performance resource hints (api paths from performance if any - limited)\n  const perf = (performance.getEntriesByType('resource') || [])\n    .map((e) => e.name)