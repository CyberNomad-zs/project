  "options": {
    "dryRun": true,
    "dateMode": "yesterday",
    "bizTimeZone": "Europe/London",
    "bizTimeZoneId": "GMT Standard Time",
    "minUkHourForToday": 20,
    "setPageDateRange": true,
    "waitAfterDateChangeMs": 8000,
    "closeAfter": true,
    "waitAfterOpenMs": 25000,
    "waitAfterVisitMs": 25000,
    "delayBetweenStoresMs": 5000,
    "scrapeRetries": 2,
    "scrapeRetryWaitMs": 12000,
    "maximizeWindow": true,
    "windowRatio": "full",
    "skipZeroDisabledCampaigns": true,
