def parse_date(val: Any) -> int | None:
    """Convert Excel date value to Feishu millisecond timestamp."""
    if val is None:
        return None
    if isinstance(val, datetime):
        return int(val.replace(tzinfo=timezone.utc).timestamp() * 1000)
    if isinstance(val, str):
        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d"):
            try:
                dt = datetime.strptime(val.strip(), fmt)
                return int(dt.replace(tzinfo=timezone.utc).timestamp() * 1000)
            except ValueError:
                continue
    return None


def safe_num(val: Any) -> float | None:
    """Convert to float, skip None/empty/formula errors."""
    if val is None:
        return None
    try:
        return float(val)
    except (TypeError, ValueError):
        return None


def read_excel() -> tuple[list[dict[str, Any]], dict[str, set[str]]]:
    """Read product master from Excel. Returns (rows, single_select_values)."""
    wb = openpyxl.load_workbook(EXCEL_PATH, data_only=True)
    ws = wb[SHEET_NAME]

    # Map Excel header -> column index
    excel_cols: dict[str, int] = {}
    for c in range(1, ws.max_column + 1):
        h = ws.cell(row=HEADER_ROW, column=c).value
        if h:
            excel_cols[str(h).strip()] = c

    # Collect single-select options from data
    single_values: dict[str, set[str]] = {k: set() for k in SINGLE_SELECT_COLS}

    rows: list[dict[str, Any]] = []
    for row_idx in range(DATA_START_ROW, ws.max_row + 1):
        asin = ws.cell(row=row_idx, column=excel_cols.get("ASIN", 0)).value
        if not asin:
            continue
        shop = str(ws.cell(row=row_idx, column=excel_cols.get("店铺", 0)).value or "").strip()
        asin_str = str(asin).strip()

        row: dict[str, Any] = {}
        for excel_name, feishu_name, ftype, _ in FIELD_DEFS:
            if excel_name == "主键":
                row["主键"] = f"{shop}|{asin_str}"
                continue

            col_idx = excel_cols.get(excel_name)
            if col_idx is None:
                continue
            val = ws.cell(row=row_idx, column=col_idx).value

            if ftype == 2:  # number
                row[feishu_name] = safe_num(val)
            elif ftype == 5:  # date
                row[feishu_name] = parse_date(val)
            elif ftype == 3:  # single select
                sv = str(val).strip() if val else ""
                # 过滤 Excel 错误值
                if sv and sv not in ("#N/A", "#VALUE!", "#REF!", "#DIV/0!", "#NAME?", "#NULL!", "#NUM!"):
                    single_values[feishu_name].add(sv)
                else:
                    sv = ""
                row[feishu_name] = sv or None
            else:  # text
                row[feishu_name] = str(val).strip() if val else None

        rows.append(row)

    wb.close()
    return rows, single_values


def analyze_data(rows: list[dict[str, Any]], single_values: dict[str, set[str]]) -> None:
    """Print data summary."""
    print(f"\n{'='*60}")
