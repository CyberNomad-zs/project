 | delivery_status \n----------------+---------+----------+------------+-------------+-----------------\n __smoke_test__ |  1.2300 | 2.000000 |   5.000000 | on          | 已生效\n 热销品7/17     | 56.1100 | 8.700000 |  10.000000 | off         | 已暂停\n 花园拱门7/17   | 42.7900 | 7.090000 |  10.000000 | off         | 已暂停\n 全站热品7/27   | 33.7600 | 4.610000 |  10.000000 | on          | 已生效\n(4 �м�¼)\n\n","exit_code":0,"command":"& \"E:\\project\\清泉跨境系统（企业级）\\backend\\.venv\\Scripts\\python.exe\" \"E:\\project\\清泉跨境系统（企业级）\\collectors\\tiktok-ads\\logs\\_ingest_deal.py\"\n$env:PGPASSWORD='postgres'\n& \"C:\\Program Files\\PostgreSQL\\16\\bin\\psql.exe\" -h 127.0.0.1 -U postgres -d qingquan -c \"SELECT shop_external_id, shop_name, count(*) n, round(sum(spend)::numeric,2) spend, round(sum(revenue)::numeric,2) rev FROM fact_ads_campaign_daily WHERE biz_date='2026-07-28' AND campaign_name NOT LIKE '\\_\\_%' ESCAPE '\\' GROUP BY 1,2 ORDER BY spend DESC;\"\n& \"C:\\Program Files\\PostgreSQL\\16\\bin\\psql.exe\" -h 127.0.0.1 -U postgres -d qingquan -c \"SELECT campaign_name, spend, roi, target_roi, plan_status, delivery_status FROM fact_ads_campaign_daily WHERE shop_external_id='27501502216807' AND biz_date='2026-07-28';\"\n","truncated":false,"signal":null,"timed_out":false,"description":"Post Deal rows and show DB summary","current_dir":"E:\\project\\清泉跨境系统（企业级）","output_file":"C:\\Users\\Administrator\\.grok\\sessions\\E%3A%5Cproject%5C%E6%B8%85%E6%B3%89%E8%B7%A8%E5%A2%83%E7%B3%BB%E7%BB%9F%EF%BC%88%E4%BC%81%E4%B8%9A%E7%BA%A7%EF%BC%89\\019fab7f-7ed9-7553-a471-73b6cca96147\\terminal\\call-391562de-17b2-4fb3-af9f-2b111c8f417c-193.log","total_bytes":2195}},"_meta":{"totalTokens":238271,"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-27373","agentTimestampMs":1785319259214,"promptId":"task-completed-call-e91e8f80-d8bf-42f7-ac98-7b8f64b96106-157","streamStartMs":1785319252721,"turnStartMs":1785317694312,"updateType":"ToolCallUpdate","updateParams":{"toolCallId":"call-391562de-17b2-4fb3-af9f-2