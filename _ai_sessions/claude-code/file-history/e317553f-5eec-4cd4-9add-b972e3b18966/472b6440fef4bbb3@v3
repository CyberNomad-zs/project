// Service worker：接收接口数据 → 解析 → 与上次快照对比 → 异常发飞书。
// 定时（chrome.alarms）刷新 Temu 后台标签页触发接口，从而拿到最新数据。
// 所有数据只存本机 chrome.storage.local，不上传任何服务器。

const GOODS_URL = 'https://agentseller.temu.com/goods/list';
const DEFAULT_CONFIG = { webhook: '', intervalMinutes: 15, enabled: true };

// ---------------- 解析 ----------------
function parseCountStatus(body) {
  try {
    const j = JSON.parse(body);
    const list = j && j.result && j.result.skcTopStatusCountList;
    if (!Array.isArray(list)) return null;
    const pick = (s) => {
      const x = list.find((e) => e && e.skcTopStatus === s);
      return x && typeof x.skcTotal === 'number' ? x.skcTotal : null;
    };
    return { onSale: pick(100), unpublished: pick(0), removed: pick(200), deleted: pick(300) };
  } catch (e) { return null; }
}

function parsePageQuery(body) {
  try {
    const j = JSON.parse(body);
    const r = j && j.result;
    if (!r) return null;
    const items = Array.isArray(r.pageItems) ? r.pageItems : [];
    // 抓每个商品里所有含 flow/traffic/limit/potential 的字段（用于定位「流量待关注」到底是哪个字段）
    const flowItems = items.map((it) => {
      const f = {};
      for (const k of Object.keys(it || {})) if (/flow|traffic|limit|potential/i.test(k)) f[k] = it[k];
      return f;
    });
    // 取值分布统计
    const dist = {};
    for (const f of flowItems) for (const k of Object.keys(f)) {
      const kk = k + '=' + JSON.stringify(f[k]);
      dist[kk] = (dist[kk] || 0) + 1;
    }
    return { total: r.total, sample: items.length, dist, flowItems };
  } catch (e) { return null; }
}

// ---------------- 存取 ----------------
async function getConfig() {
  const { config } = await chrome.storage.local.get('config');
  return Object.assign({}, DEFAULT_CONFIG, config || {});
}
async function getLatest() {
  const { latest } = await chrome.storage.local.get('latest');
  return latest || {};
}
async function setLatest(patch) {
  const latest = Object.assign(await getLatest(), patch, { ts: Date.now() });
  await chrome.storage.local.set({ latest });
  return latest;
}
async function getSnapshot() {
  const { snapshot } = await chrome.storage.local.get('snapshot');
  return snapshot || {};
}
async function setSnapshot(snapshot) {
  await chrome.storage.local.set({ snapshot });
}

// ---------------- 飞书 ----------------
async function sendFeishu(webhook, title, lines) {
  if (!webhook) return { ok: false, msg: '未配置飞书 webhook' };
  const card = {
    msg_type: 'interactive',
    card: {
      header: { title: { tag: 'plain_text', content: title }, template: 'red' },
      elements: [{ tag: 'div', text: { tag: 'lark_md', content: lines.join('\n') } }],
    },
  };
  try {
    const resp = await fetch(webhook, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(card),
    });
    const data = await resp.json().catch(() => ({}));
    // 飞书成功返回 {"code":0,...} 或 {"StatusCode":0}
    const ok = resp.ok && (data.code === 0 || data.StatusCode === 0 || data.code === undefined);
    return { ok, msg: ok ? '已发送' : ('飞书返回：' + JSON.stringify(data)) };
  } catch (e) {
    return { ok: false, msg: '发送失败：' + (e && e.message) };
  }
}

// ---------------- 对比 & 告警 ----------------
async function diffAndAlert() {
  const cfg = await getConfig();
  if (!cfg.enabled) return;
  const latest = await getLatest();
  const snap = await getSnapshot();
  const events = [];

  // 在售数量下降
  if (typeof latest.onSale === 'number' && typeof snap.onSale === 'number' && latest.onSale < snap.onSale) {
    events.push(`📉 在售数量下降：${snap.onSale} → ${latest.onSale}`);
  }

  if (events.length > 0) {
    const store = latest.store || '当前店铺';
    const lines = [`**🏬 ${store}**`, ...events, '', `_检查时间：${new Date().toLocaleString('zh-CN')}_`];
    const r = await sendFeishu(cfg.webhook, '🔔 Temu 店铺监测告警', lines);
    await chrome.storage.local.set({ lastAlert: { ts: Date.now(), ok: r.ok, msg: r.msg, lines } });
  }

  // 更新基准快照（幂等：同一数据不会反复告警；真实下降后基准跟进，只报一次）
  await setSnapshot({ onSale: latest.onSale, total: latest.total, ts: Date.now() });
}

// ---------------- 消息处理 ----------------
chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
  (async () => {
    if (msg.type === 'capture') {
      if (msg.kind === 'countStatus') {
        const p = parseCountStatus(msg.body);
        if (p && p.onSale != null) {
          await setLatest({ onSale: p.onSale, unpublished: p.unpublished, removed: p.removed, deleted: p.deleted });
          await diffAndAlert();
        }
      } else if (msg.kind === 'pageQuery') {
        const p = parsePageQuery(msg.body);
        if (p) {
          await setLatest({ total: p.total, flowDist: p.dist, sample: p.sample });
          // 筛选后的小结果集（如点「商品流量待关注」后返回的 2 条）单独存为诊断样本，
          // 用来确定「待关注」对应哪个流量字段/取值。
          if (p.total != null && p.total > 0 && p.total <= 20) {
            await chrome.storage.local.set({ trafficSample: { total: p.total, capturedAt: Date.now(), dist: p.dist, flowItems: p.flowItems } });
          }
        }
      }
      sendResponse({ ok: true });
      return;
    }
    if (msg.type === 'getStatus') {
      sendResponse({ config: await getConfig(), latest: await getLatest(), snapshot: await getSnapshot(), ...(await chrome.storage.local.get(['lastAlert', 'trafficSample'])) });
      return;
    }
    if (msg.type === 'checkNow') {
      const r = await pollNow();
      sendResponse(r);
      return;
    }
    if (msg.type === 'testFeishu') {
      const cfg = await getConfig();
      const r = await sendFeishu(cfg.webhook, '✅ Temu 监测测试', ['这是一条测试消息，收到说明飞书配置正常。', '', `_${new Date().toLocaleString('zh-CN')}_`]);
      sendResponse(r);
      return;
    }
  })();
  return true; // 异步 sendResponse
});

// ---------------- 定时轮询 ----------------
async function pollNow() {
  // 找一个 Temu 后台标签页，后台刷新它（不抢焦点）→ 页面重新发接口 → 被 hook 捕获
  const tabs = await chrome.tabs.query({ url: 'https://agentseller.temu.com/*' });
  let goods = tabs.find((t) => /goods\/list/.test(t.url || ''));
  if (goods) {
    await chrome.tabs.reload(goods.id, { bypassCache: false });
    return { ok: true, msg: '已刷新后台商品页，稍候查看数据' };
  }
  if (tabs[0]) {
    // 有 Temu 页但不在商品列表，导航过去
    await chrome.tabs.update(tabs[0].id, { url: GOODS_URL });
    return { ok: true, msg: '已导航到商品列表页' };
  }
  return { ok: false, msg: '未找到打开的 Temu 后台标签页，请先登录并打开商品列表页' };
}

chrome.alarms.onAlarm.addListener((a) => { if (a.name === 'poll') pollNow(); });

async function setupAlarm() {
  const cfg = await getConfig();
  await chrome.alarms.clear('poll');
  chrome.alarms.create('poll', { periodInMinutes: Math.max(1, cfg.intervalMinutes || 15) });
}
chrome.runtime.onInstalled.addListener(setupAlarm);
chrome.runtime.onStartup.addListener(setupAlarm);
// 配置变更（改了间隔）时重建 alarm
chrome.storage.onChanged.addListener((changes, area) => {
  if (area === 'local' && changes.config) setupAlarm();
});
