    vid = None
    if cr.get("code") == 0:
        vid = (cr.get("data") or {}).get("view", {}).get("view_id") or (cr.get("data") or {}).get("view_id")
    if vid:
        # try various patch bodies for filter
        bodies = [
            {
                "view": {
