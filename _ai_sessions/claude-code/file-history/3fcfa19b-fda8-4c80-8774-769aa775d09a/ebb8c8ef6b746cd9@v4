      api_secret: "78a4d04bdb0f4214928d19abc95d1e44"
  default_profile: jinmao   # 渠道未标 wms_profile 时的兜底

run:
  poll_interval_sec: 300
  purchase_date_days: 7
  # 金猫商贸授权店铺（2026-07-15 从赛狐实拉；Amazon店 Caldicotsales/起的快 尚未在WMS授权，授权后再加）
  shop_whitelist: ["396706", "398202", "398203"]   # Agnis / HomeCove / Twilight Cove
  hold_on_channel_mismatch: true  # WMS侧渠道与赛狐不一致时：暂停闭环+告警（赛狐为基准）
  auto_apply_track_no: false      # 灰度期：先只选渠道+指派，人工点下单
  keep_existing_channel: true     # 第一期：包裹已带渠道则不改，只兜底无渠道/渠道停用的
  # 无渠道策略（2026-07-21 业务确认）：人工在赛狐指派渠道；不靠 sku_weights 自动选。
  # 无渠道时程序告警/FAILED，人工补渠道后下一轮走「保留已有渠道」。
  ship_confirm_mode: auto         # auto=有重量称重，无重量 quick
  weighing_fallback_quick: true
  stale_new_days: 3               # 陈旧 NEW → STALE
  default_weight_unit: g
  default_country: GB             # TikTok/Temu 包裹地址脱敏取不到国家时的默认值（英国仓业务）

