    warehouse_id: 187323
    wms_profile: blackcat
    countries: [GB]
    max_weight_g: 30000
    cost_per_kg: 0
    base_cost: 0
    enabled: true
  - name: 昇新海外仓-RM
    sellfox_provider_auth_detail_id: 480
    expected_carrier: RM
    warehouse_id: 180617
    wms_profile: jinmao
    countries: [GB]
