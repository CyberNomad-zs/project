            ),
            {
                "id": str(uuid4()),
                "shop_id": shop["shop_uuid"],
                "shop_external_id": shop["ziniao_store_id"],
                "shop_name": shop["name"],
                "sellfox_shop_id": str(
                    r.get("shopId") or r.get("shopIds") or shop.get("sellfox_shop_id") or ""
                ),
