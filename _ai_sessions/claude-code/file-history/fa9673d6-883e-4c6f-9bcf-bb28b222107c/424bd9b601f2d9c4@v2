<style>
  :root{
    --bg:#EBEEF2; --panel:#FBFCFD; --panel-2:#F0F3F6; --panel-3:#E9EDF1;
    --ink:#131A22; --ink-2:#4A5563; --ink-3:#8A94A2;
    --line:#D6DDE5; --line-2:#E6EBF0;
    --accent:#1B7FC4; --accent-2:#1C9BB8;
    --crit:#D23B43; --crit-bg:rgba(210,59,67,.11); --crit-line:rgba(210,59,67,.4);
    --warn:#BC7714; --warn-bg:rgba(200,130,20,.13); --warn-line:rgba(200,130,20,.4);
    --good:#2A9666; --good-bg:rgba(42,150,102,.12); --good-line:rgba(42,150,102,.38);
    --shadow:0 1px 2px rgba(19,26,34,.05),0 6px 20px rgba(19,26,34,.07);
    --font-sans:"Microsoft YaHei","PingFang SC","Hiragino Sans GB","Noto Sans CJK SC",-apple-system,"Segoe UI",Roboto,sans-serif;
    --font-mono:"Cascadia Code","JetBrains Mono","SF Mono","Consolas",ui-monospace,Menlo,monospace;
  }
  @media (prefers-color-scheme:dark){
    :root{
      --bg:#0C1117; --panel:#141A22; --panel-2:#1A212B; --panel-3:#212a35;
      --ink:#E9EEF3; --ink-2:#99A5B3; --ink-3:#5E6A78;
      --line:#242D38; --line-2:#1D2530;
      --accent:#3AA4E6; --accent-2:#3FC0D4;
      --crit:#EF565C; --crit-bg:rgba(239,86,92,.15); --crit-line:rgba(239,86,92,.5);
      --warn:#E0A63B; --warn-bg:rgba(224,166,59,.15); --warn-line:rgba(224,166,59,.45);
      --good:#41BF89; --good-bg:rgba(65,191,137,.14); --good-line:rgba(65,191,137,.45);
      --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.36);
    }
  }
  :root[data-theme="light"]{--bg:#EBEEF2;--panel:#FBFCFD;--panel-2:#F0F3F6;--panel-3:#E9EDF1;--ink:#131A22;--ink-2:#4A5563;--ink-3:#8A94A2;--line:#D6DDE5;--line-2:#E6EBF0;--accent:#1B7FC4;--accent-2:#1C9BB8;--crit:#D23B43;--crit-bg:rgba(210,59,67,.11);--crit-line:rgba(210,59,67,.4);--warn:#BC7714;--warn-bg:rgba(200,130,20,.13);--warn-line:rgba(200,130,20,.4);--good:#2A9666;--good-bg:rgba(42,150,102,.12);--good-line:rgba(42,150,102,.38);--shadow:0 1px 2px rgba(19,26,34,.05),0 6px 20px rgba(19,26,34,.07);}
  :root[data-theme="dark"]{--bg:#0C1117;--panel:#141A22;--panel-2:#1A212B;--panel-3:#212a35;--ink:#E9EEF3;--ink-2:#99A5B3;--ink-3:#5E6A78;--line:#242D38;--line-2:#1D2530;--accent:#3AA4E6;--accent-2:#3FC0D4;--crit:#EF565C;--crit-bg:rgba(239,86,92,.15);--crit-line:rgba(239,86,92,.5);--warn:#E0A63B;--warn-bg:rgba(224,166,59,.15);--warn-line:rgba(224,166,59,.45);--good:#41BF89;--good-bg:rgba(65,191,137,.14);--good-line:rgba(65,191,137,.45);--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.36);}

  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-sans);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;}
  .mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums;}
  .app{max-width:1280px;margin:0 auto;padding:clamp(12px,2vw,22px);display:flex;flex-direction:column;gap:14px;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px;}
  button{font-family:inherit;cursor:pointer;}

  /* topbar */
  .top{display:flex;align-items:center;gap:14px 18px;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 18px;box-shadow:var(--shadow);}
  .brand{display:flex;align-items:center;gap:11px;}
  .brand .logo{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:grid;place-items:center;color:#fff;font-size:19px;position:relative;overflow:hidden;}
  .brand .logo::after{content:"";position:absolute;inset:0;background:conic-gradient(from 0deg,transparent 0deg,rgba(255,255,255,.35) 40deg,transparent 80deg);animation:sweep 3.4s linear infinite;}
  @keyframes sweep{to{transform:rotate(360deg);}}
  .brand .bt{font-weight:800;font-size:1.12rem;letter-spacing:-.01em;}
  .brand .bs{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);}
  .sources{display:flex;gap:8px;flex-wrap:wrap;margin-left:auto;}
  .src{display:flex;align-items:center;gap:7px;background:var(--panel-2);border:1px solid var(--line-2);border-radius:9px;padding:6px 11px;font-size:.78rem;}
  .src .dot{width:8px;height:8px;border-radius:50%;background:var(--good);box-shadow:0 0 0 3px var(--good-bg);}
  .src b{font-weight:700;}
  .src .c{font-family:var(--font-mono);color:var(--ink-3);font-size:.72rem;}
  .sync{font-size:.72rem;color:var(--ink-3);font-family:var(--font-mono);display:flex;align-items:center;gap:6px;}
  .demo-badge{font-family:var(--font-mono);font-size:.6rem;letter-spacing:.14em;color:var(--warn);border:1px solid var(--warn-line);background:var(--warn-bg);border-radius:6px;padding:3px 8px;font-weight:700;}

  /* AI summary */
  .ai{display:flex;gap:13px;align-items:flex-start;background:linear-gradient(100deg,var(--crit-bg),transparent 60%);border:1px solid var(--line);border-left:3px solid var(--crit);border-radius:12px;padding:14px 18px;}
  .ai .ic{font-size:17px;flex-shrink:0;margin-top:1px;}
  .ai .txt{font-size:.92rem;color:var(--ink);line-height:1.6;}
  .ai .txt b{color:var(--crit);font-weight:800;}
  .ai .txt .g{color:var(--warn);font-weight:700;}

  /* KPI */
  .kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:11px;}
  @media (max-width:900px){.kpis{grid-template-columns:repeat(3,1fr);}}
  @media (max-width:520px){.kpis{grid-template-columns:repeat(2,1fr);}}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 15px;box-shadow:var(--shadow);position:relative;overflow:hidden;}
  .kpi .l{font-size:.75rem;color:var(--ink-3);display:flex;align-items:center;gap:6px;}
  .kpi .v{font-family:var(--font-mono);font-size:1.85rem;font-weight:700;letter-spacing:-.02em;margin-top:5px;line-height:1;}
  .kpi .s{font-size:.68rem;color:var(--ink-3);margin-top:6px;font-family:var(--font-mono);}
  .kpi.crit{border-color:var(--crit-line);} .kpi.crit .v{color:var(--crit);}
  .kpi.warn{border-color:var(--warn-line);} .kpi.warn .v{color:var(--warn);}
  .kpi .tick{position:absolute;top:0;right:0;width:34px;height:34px;}
  .kpi .tick::before{content:"";position:absolute;top:11px;right:11px;width:7px;height:7px;border-radius:50%;}
  .kpi.crit .tick::before{background:var(--crit);animation:pulse 1.6s ease-in-out infinite;}
  @keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 var(--crit-bg);}50%{opacity:.6;box-shadow:0 0 0 6px transparent;}}

  /* controls */
  .controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow);}
  .nl{flex:1 1 300px;display:flex;align-items:center;gap:9px;background:var(--panel-2);border:1px solid var(--line-2);border-radius:9px;padding:8px 12px;min-width:220px;}
  .nl svg{flex-shrink:0;color:var(--accent);}
  .nl input{flex:1;border:none;background:transparent;color:var(--ink);font-family:inherit;font-size:.88rem;outline:none;}
  .nl input::placeholder{color:var(--ink-3);}
  .chips{display:flex;gap:7px;flex-wrap:wrap;}
  .chip{font-size:.76rem;border:1px solid var(--line);background:var(--panel-2);color:var(--ink-2);border-radius:99px;padding:5px 12px;transition:.14s;}
  .chip:hover{border-color:var(--accent);color:var(--ink);}
  .chip.on{background:var(--accent);border-color:var(--accent);color:#fff;}
  .chip.pf{display:flex;align-items:center;gap:6px;}
  .chip .pd{width:7px;height:7px;border-radius:50%;}
  .toggle{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--ink-2);}
  .sw{width:38px;height:22px;border-radius:99px;background:var(--panel-3);border:1px solid var(--line);position:relative;transition:.16s;}
  .sw::after{content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:var(--ink-3);transition:.16s;}
  .sw.on{background:var(--crit);border-color:var(--crit);}
  .sw.on::after{left:18px;background:#fff;}

  /* anomaly rail */
  .rail{display:flex;gap:10px;overflow-x:auto;padding-bottom:2px;}
  .acard{flex:1 1 0;min-width:172px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:13px 14px;box-shadow:var(--shadow);cursor:pointer;transition:.14s;border-top:3px solid var(--line);}
  .acard:hover{transform:translateY(-2px);}
  .acard.on{outline:2px solid var(--accent);outline-offset:1px;}
  .acard.sev-crit{border-top-color:var(--crit);}
  .acard.sev-warn{border-top-color:var(--warn);}
  .acard.sev-info{border-top-color:var(--accent);}
  .acard .an{font-size:.8rem;color:var(--ink-2);display:flex;align-items:center;gap:6px;}
  .acard .av{font-family:var(--font-mono);font-size:1.6rem;font-weight:700;margin-top:4px;line-height:1;}
  .acard.sev-crit .av{color:var(--crit);} .acard.sev-warn .av{color:var(--warn);} .acard.sev-info .av{color:var(--accent);}
  .acard .ad{font-size:.68rem;color:var(--ink-3);margin-top:5px;line-height:1.4;}

  /* table */
  .tablewrap{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden;}
  .thead-bar{display:flex;align-items:center;justify-content:space-between;padding:13px 16px;border-bottom:1px solid var(--line);gap:12px;flex-wrap:wrap;}
  .thead-bar h2{margin:0;font-size:1rem;font-weight:800;letter-spacing:-.01em;display:flex;align-items:center;gap:9px;}
  .thead-bar .cnt{font-family:var(--font-mono);font-size:.76rem;color:var(--ink-3);background:var(--panel-2);border:1px solid var(--line-2);border-radius:7px;padding:3px 9px;}
  .btn{font-size:.78rem;border:1px solid var(--line);background:var(--panel-2);color:var(--ink-2);border-radius:8px;padding:7px 13px;display:inline-flex;align-items:center;gap:6px;transition:.14s;}
  .btn:hover{border-color:var(--accent);color:var(--ink);}
  .scroll{overflow-x:auto;}
  table{border-collapse:collapse;width:100%;min-width:1000px;font-size:.83rem;}
  thead th{position:sticky;top:0;background:var(--panel-2);text-align:left;padding:10px 12px;font-size:.7rem;letter-spacing:.03em;color:var(--ink-3);font-weight:700;border-bottom:1px solid var(--line);white-space:nowrap;text-transform:uppercase;}
  tbody td{padding:11px 12px;border-bottom:1px solid var(--line-2);vertical-align:middle;white-space:nowrap;}
  tbody tr{transition:background .12s;}
  tbody tr:hover{background:var(--panel-2);}
  tbody tr.sev-crit{box-shadow:inset 3px 0 0 var(--crit);}
  tbody tr.sev-warn{box-shadow:inset 3px 0 0 var(--warn);}
  tbody tr.sev-info{box-shadow:inset 3px 0 0 var(--accent);}
  .oid{font-family:var(--font-mono);font-size:.8rem;color:var(--ink);}
  .buyer{font-size:.7rem;color:var(--ink-3);margin-top:1px;}
  .pf-cell{display:flex;align-items:center;gap:7px;font-size:.8rem;}
  .pf-cell .pd{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
  .sku{max-width:180px;overflow:hidden;text-overflow:ellipsis;}
  .qty{font-family:var(--font-mono);color:var(--ink-2);}
  .pill{display:inline-flex;align-items:center;gap:5px;font-size:.72rem;border-radius:7px;padding:3px 9px;font-weight:600;border:1px solid transparent;white-space:nowrap;}
  .pill.g{background:var(--good-bg);color:var(--good);border-color:var(--good-line);}
  .pill.w{background:var(--warn-bg);color:var(--warn);border-color:var(--warn-line);}
  .pill.c{background:var(--crit-bg);color:var(--crit);border-color:var(--crit-line);}
  .pill.n{background:var(--panel-3);color:var(--ink-3);border-color:var(--line);}
  .clock{font-family:var(--font-mono);font-weight:700;font-size:.82rem;display:inline-flex;align-items:center;gap:5px;}
  .clock.ok{color:var(--ink-2);} .clock.near{color:var(--warn);} .clock.over{color:var(--crit);}
  .track{font-family:var(--font-mono);font-size:.76rem;color:var(--ink-2);}
  .track.none{color:var(--crit);font-weight:600;}
  .flags{display:flex;gap:4px;flex-wrap:wrap;}
  .flag{font-size:.66rem;border-radius:6px;padding:2px 7px;font-weight:600;white-space:nowrap;}
  .flag.c{background:var(--crit-bg);color:var(--crit);}
  .flag.w{background:var(--warn-bg);color:var(--warn);}
  .flag.i{background:var(--panel-3);color:var(--accent);}
  .empty{padding:40px;text-align:center;color:var(--ink-3);font-size:.9rem;}

  footer{color:var(--ink-3);font-size:.74rem;text-align:center;padding:6px 0 2px;line-height:1.7;}
  footer .mono{color:var(--ink-2);}

  @media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important;}}
</style>

