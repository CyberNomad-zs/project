OT EXISTS idx_ingest_received\n    ON ingest_raw (received_at DESC);\n\n-- ---------------------------------------------------------------------------\n-- TK 广告事实（Phase0 优先接通）\n-- ---------------------------------------------------------------------------\nCREATE TABLE IF NOT EXISTS fact_ads_campaign_daily (\n    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    shop_id         UUID REFERENCES shop(id),\n    shop_external_id TEXT NOT NULL,\n    shop_name       TEXT,\n    biz_date        DATE NOT NULL,\n    campaign_name   TEXT NOT NULL,\n    spend           NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    orders          NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    roi             NUMERIC(18, 6),\n    revenue         NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    currency        TEXT DEFAULT 'GBP',\n    row_status      TEXT DEFAULT 'success',\n    source_url      TEXT,\n    collected_at    TIMESTAMPTZ,\n    ingest_id       UUID REFERENCES ingest_raw(id),\n    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at      TIMESTAMPTZ NOT NULL DEFAULT now(),\n    UNIQUE (shop_external_id, campaign_name, biz_date)\n);\n\nCREATE INDEX IF NOT EXISTS idx_ads_biz_date ON fact_ads_campaign_daily (biz_date DESC);\nCREATE INDEX IF NOT EXISTS idx_ads_shop_date ON fact_ads_campaign_daily (shop_id, biz_date DESC);\n\n-- ---------------------------------------------------------------------------\n-- 异常与任务\n-- ---------------------------------------------------------------------------\nCREATE TABLE IF NOT EXISTS anomaly_event (\n    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    platform        TEXT NOT NULL,\n    shop_id         UUID REFERENCES shop(id),\n    anomaly_type    TEXT NOT NULL,\n    biz_id          TEXT NOT NULL,\n    biz_id_type     TEXT NOT NULL DEFAULT 'unknown',\n    dedupe_key      TEXT NOT NULL,\n    severity        TEXT NOT NULL DEFAULT 'warn'\n                    CHECK (severity IN ('info', 'warn', 'high', 'critical')),\n    title           TEXT NOT NULL,\n    detail          TEXT,\n    payload         JSONB NOT NULL DEFAULT '{}'::jsonb,\n    detected_at     TIMESTAMPTZ NOT NULL DEFAULT now(),\n    resolved_at     TIMESTAMPTZ,\n    task_id         UUID,\n    created_at      TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE INDEX IF NOT EXISTS idx_anomaly_dedupe ON anomaly_event (dedupe_key, detected_at DESC);\nCREATE INDEX IF NOT EXISTS idx_anomaly_detected ON anomaly_event (detected_at DESC);\n\nCREATE TABLE IF NOT EXISTS task (\n    id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    dedupe_key          TEXT NOT NULL,\n    status              TEXT NOT NULL DEFAULT 'open'\n                        CHECK (status IN ('open', 'in_progress', 'resolved', 'cancelled')),\n    platform            TEXT NOT NULL,\n    shop_id             UUID REFERENCES shop(id),\n    anomaly_type        TEXT NOT NULL,\n    biz_id              TEXT NOT NULL,\n    title               TEXT NOT NULL,\n    owner_user_id       UUID REFERENCES org_user(id),\n    due_at              TIMESTAMPTZ,\n    progress_note       TEXT,\n    source_event_id     UUID REFERENCES anomaly_event(id),\n    created_at          TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at          TIMESTAMPTZ NOT NULL DEFAULT now(),\n    resolved_at         TIMESTAMPTZ\n);\n\n","total_lines":265}}},"_meta":{"totalTokens":26250,"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-647","agentTimestampMs":1785288905183,"promptId":"0526c8d0-8a0e-48ec-acc8-fce279033c11","streamStartMs":1785288902016,"turnStartMs":1785288896942,"updateType":"ToolCallUpdate","updateParams":{"toolCallId":"call-a41ec09c-a6d9-4ca5-a67b-713c45aab783-8","status":"Completed"}}}}
{"timestamp":1785288905,"method":"session/update","params":{"sessionId":"019fab7f-7ed9-7553-a471-73b6cca96147","update":{"sessionUpdate":"tool_call_update","toolCallId":"call-a41ec09c-a6d9-4ca5-a67b-713c45aab783-6","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1→# 清泉跨境系统 · 架构方案\n\n> 版本：v1.1  \n> 日期：2026-07-28  \n> 依据：技术会.xmind + 海外仓 / Temu 监测 / TK 广告 三项目盘点  \n> 产品组织视角补充：[中台产品蓝图.md](./中台产品蓝图.md)（来源 `中台.xmind`，2026-07-28）\n\n---\n\n10→## 1. 背景与目标\n\n### 1.1 业务目标\n\n建设企业私有化定制平台，汇总 **TikTok Shop、Temu、Amazon** 等电商平台运营数据，支撑：\n\n- 平台销售异常 / 账号异常监控与跟踪任务\n- 采购侧供应商、滞销断货、销售天数\n- 数据落 **线上数据库**，并 **同步导出到飞书多维表格**\n- 以 **企业智能体** 为主通道发送通知（会议红标重点）\n20→\n### 1.2 现有资产\n\n| 项目 | 路径 | 形态 | 数据落点 | 可复用 |\n|------|------|------|----------|--------|\n| 海外仓 | `E:\\project\\海外仓` | Python + Sellfox OpenAPI + WMS + SQLite | 本地 bridge.db | 赛狐鉴权、包裹流水线、WMS、飞书告警 |\n| Temu 监测 | `E:\\project\\temu` | Chrome MV3 + Node/Playwright | 本地 JSON | 后台 hook、赛狐商品、多店、飞书卡片 |\n| TK 广告 | `E:\\project\\海外TK店铺广告投流数据自动化监测` | Chrome MV3 + 紫鸟 CLI + PS | 飞书多维表 | DOM/API 抓取、Bitable 写入、日报、紫鸟编排 |\n\n共性：本机常驻 + 浏览器登录态 + 飞书触达。  \n30→缺口：无统一在线库、无统一任务引擎、无 Web 管理端。\n\n### 1.3 架构跃迁\n\n| 维度 | 现在 | 目标 |\n|------|------|------|\n| 存储 | 本机 JSON / SQLite / 直写飞书 | **PostgreSQL 为 SoT**，飞书为同步出口 |\n| 采集 | 三套独立脚本/插件 | 统一 Collector Agent + 平台适配器 |\n| 业务 | 告警为主 | 监控 → 任务闭环 → 运营看板 |\n| 部署 | 个人 PC 计划任务 | 中心服务 + 边缘采集节点 |\n40→\n---\n\n## 2. 总体架构\n\n### 2.1 逻辑分层\n\n```\n接入层   Web 管理端 │ 飞书多维表/机器人 │ 企业智能体 │ 邮件 │ OpenAPI\n应用层   运营监控 │ 任务引擎 │ 采购 │ 产品中心 │ 报表/导出 │ 权限组织\n50→领域层   异常判定 │ 去重/状态机 │ 调度 │ 飞书同步器 │ 通知编排\n数据层   PostgreSQL │ Redis │ 对象存储 │ 消息/Outbox\n采集层   Amazon插件 │ Temu插件/Monitor │ TK+紫鸟 │ 赛狐 Worker │ 海外仓 Bridge\n```\n\n### 2.2 部署拓扑\n\n```\n              ┌─────────────────────────┐\n              │  中心（固定 IP / 内网）    │\n60→              │  API + Web + PG + Redis  │\n              │  Scheduler + Worker      │\n              └───────────┬─────────────┘\n                          │ HTTPS\n     ┌────────────────────┼────────────────────┐\n     ▼                    ▼                    ▼\n采集机A（白名单IP）   采集机B（运营PC）      紫鸟环境\n赛狐 API Worker      Amazon/Temu 插件       TK 多店 RPA\n```\n\n70→**原则**\n\n1. 中心无头可集群；采集因登录态 / IP 白名单必须边缘化。\n2. 插件 **不直连数据库**，只调中心 Ingest API。\n3. 赛狐 Worker 与现有海外仓机器可共用固定出口 IP。\n\n### 2.3 技术选型\n\n| 层级 | 选型 | 说明 |\n|------|------|------|\n80→| 后端 | Python 3.12 + FastAPI | 复用海外仓 Python 资产 |\n| 队列 | ARQ 或 Celery + Redis | 定时拉取、异步写飞书 |\n| 主库 | PostgreSQL 16 | SoT；JSONB 兼容平台差异 |\n| 缓存 | Redis 7 | 锁、调度、token |\n| 前端 | Vue 3 + Element Plus | 中后台快速交付 |\n| 插件 | Chrome MV3 | 改造现有三套 |\n| TK 多店 | 紫鸟 + ziniao-cli | 已稳定，封装 Collector |\n| 对象存储 | MinIO 或本地盘 | 巡检截图 |\n| 飞书 | 自建应用 + Bitable + 机器人 | 从 TK 项目抽公共库 |\n| 部署 | Docker Compose | 私有化单机首选 |\n90→| 鉴权 | JWT + RBAC | 店铺数据权限 + 供应商脱敏 |\n\n---\n\n## 3. 核心子系统\n\n### 3.1 统一采集（Collector）\n\n```\ncollectors/\n100→├── agent-core/          # SDK：鉴权、心跳、上报、重试\n├── sellfox-worker/      # 源自海外仓 sellfox 客户端\n├── amazon-extension/    # 前台巡检 12 项（新建）\n├── temu-extension/      # 改造自 temu-plugin\n├── temu-monitor/        # 改造自 temu-monitor\n└── tiktok-ads/          # 改造自 TK 项目\n```\n\n上报统一报文：\n\n110→```json\n{\n  \"source\": \"tiktok_ads\",\n  \"platform\": \"tiktok\",\n  \"shop_id\": \"27501502216807\",\n  \"shop_name\": \"Deal to deal\",\n  \"biz_date\": \"2026-07-26\",\n  \"collected_at\": \"2026-07-27T17:20:00+08:00\",\n  \"idempotency_key\": \"tiktok_ads:27501502216807:拖把7/13:2026-07-26\",\n  \"payload\": {},\n120→  \"evidence\": { \"screenshot_url\": null, \"source_url\": \"...\" }\n}\n```\n\n`idempotency_key` 唯一约束 → 支持重跑不脏数据。\n\n### 3.2 任务引擎（会议规则）\n\n**去重键：** `platform + biz_id + anomaly_type`（如 ASIN + 异常类型）\n\n130→**状态机：**\n\n```\n检出异常\n  ├─ 存在未闭环同键任务 → 只更新进度/数据\n  └─ 否则 → 新建任务，指派第一负责人，写截止时间\nIN_PROGRESS\n  ├─ 每日固定提醒\n  ├─ 人工推进进度\n  └─ 异常消失 → RESOLVED（闭环）\n140→闭环后再次出现 → 新建（不复活旧单）\n```\n\n**账号异常：** 仅异常建任务，正常静默。\n\n### 3.3 调度（对齐会议）\n\n| Job | 时间 | 说明 |\n|-----|------|------|\n| 亚马逊销售异常 | 每日 07:00 | 拉昨日 |\n150→| 亚马逊账号异常 | 05:30 起每 8h，3 次/日 | 前台 + 绩效 |\n| 采购销售天数 | 每周一 07:00 | 赛狐 |\n| TK 广告 | 17:20 | 沿用现网，业务日=昨日 |\n| Temu 监测 | 15min + 09:30/16:30 必提醒 | |\n| 飞书同步 | 5–15min 或事件驱动 | |\n| 库存快照 | 日级 | FBA + FBM/WMS |\n\n### 3.4 飞书同步器\n\n- PostgreSQL = Source of Truth  \n160→- 飞书 = 协作视图 + 告警通道  \n- 维护 `sync_feishu_map(local_id ↔ record_id)`，支持 **update**，禁止只 append 导致重复  \n- 字段别名映射（复用 TK 项目逻辑）\n\n建议多维表：\n\n| 表 | 受众 |\n|----|------|\n| 运营_销售异常跟踪 | 运营 |\n| 运营_账号健康 | 运营 |\n170→| TK_广告日报 | 投流 |\n| Temu_流量与下架 | Temu |\n| 采购_滞销断货 | 采购 |\n| 采购_供应商（脱敏） | 全员 |\n\n### 3.5 通知编排\n\n```\n领域事件 → Router\n  ├─ 企业智能体 IM（主通道）\n180→  ├─ 飞书群机器人\n  └─ 邮件（采购试行）\n收敛：同负责人 N 分钟合并；必提醒可非异常汇总\n```\n\n### 3.6 权限与脱敏\n\n- 用户 → 部门 → 授权店铺  \n- 角色 `procurement_full` 可见供应商名称；其余 API 强制 `name → code`  \n- 采集端使用设备级 API Key + 店铺范围\n190→\n---\n\n## 4. 与现有项目关系\n\n| 项目 | 策略 |\n|------|------|\n| TK 广告 | **最先改造**：先 POST 中心，再由中心同步飞书 |\n| Temu | 插件/monitor 增加 report；下架/限流进任务 |\n| 海外仓发货 | **Phase 0–3 保持独立进程**；仅上报库存与异常事件 |\n200→| 赛狐客户端 | 从 sellfox-bridge 抽出只读 SDK 供 Worker |"}}],"rawOutput":{"type":"ReadFile","FileContent":{"content":"1→# 清泉跨境系统 · 架构方案\n\n> 版本：v1.1  \n> 日期：2026-07-28  \n> 依据：技术会.xmind + 海外仓 / Temu 监测 / TK 广告 三项目盘点  \n> 产品组织视角补充：[中台产品蓝图.md](./中台产品蓝图.md)（来源 `中台.xmind`，2026-07-28）\n\n---\n\n10→## 1. 背景与目标\n\n### 1.1 业务目标\n\n建设企业私有化定制平台，汇总 **TikTok Shop、Temu、Amazon** 等电商平台运营数据，支撑：\n\n- 平台销售异常 / 账号异常监控与跟踪任务\n- 采购侧供应商、滞销断货、销售天数\n- 数据落 **线上数据库**，并 **同步导出到飞书多维表格**\n- 以 **企业智能体** 为主通道发送通知（会议红标重点）\n20→\n### 1.2 现有资产\n\n| 项目 | 路径 | 形态 | 数据落点 | 可复用 |\n|------|------|------|----------|--------|\n| 海外仓 | `E:\\project\\海外仓` | Python + Sellfox OpenAPI + WMS + SQLite | 本地 bridge.db | 赛狐鉴权、包裹流水线、WMS、飞书告警 |\n| Temu 监测 | `E:\\project\\temu` | Chrome MV3 + Node/Playwright | 本地 JSON | 后台 hook、赛狐商品、多店、飞书卡片 |\n| TK 广告 | `E:\\project\\海外TK店铺广告投流数据自动化监测` | Chrome MV3 + 紫鸟 CLI + PS | 飞书多维表 | DOM/API 抓取、Bitable 写入、日报、紫鸟编排 |\n\n共性：本机常驻 + 浏览器登录态 + 飞书触达。  \n30→缺口：无统一在线库、无统一任务引擎、无 Web 管理端。\n\n### 1.3 架构跃迁\n\n| 维度 | 现在 | 目标 |\n|------|------|------|\n| 存储 | 本机 JSON / SQLite / 直写飞书 | **PostgreSQL 为 SoT**，飞书为同步出口 |\n| 采集 | 三套独立脚本/插件 | 统一 Collector Agent + 平台适配器 |\n| 业务 | 告警为主 | 监控 → 任务闭环 → 运营看板 |\n| 部署 | 个人 PC 计划任务 | 中心服务 + 边缘采集节点 |\n40→\n---\n\n## 2. 总体架构\n\n### 2.1 逻辑分层\n\n```\n接入层   Web 管理端 │ 飞书多维表/机器人 │ 企业智能体 │ 邮件 │ OpenAPI\n应用层   运营监控 │ 任务引擎 │ 采购 │ 产品中心 │ 报表/导出 │ 权限组织\n50→领域层   异常判定 │ 去重/状态机 │ 调度 │ 飞书同步器 │ 通知编排\n数据层   PostgreSQL │ Redis │ 对象存储 │ 消息/Outbox\n采集层   Amazon插件 │ Temu插件/Monitor │ TK+紫鸟 │ 赛狐 Worker │ 海外仓 Bridge\n```\n\n### 2.2 部署拓扑\n\n```\n              ┌─────────────────────────┐\n              │  中心（固定 IP / 内网）    │\n60→              │  API + Web + PG + Redis  │\n              │  Scheduler + Worker      │\n              └───────────┬─────────────┘\n                          │ HTTPS\n     ┌────────────────────┼────────────────────┐\n     ▼                    ▼                    ▼\n采集机A（白名单IP）   采集机B（运营PC）      紫鸟环境\n赛狐 API Worker      Amazon/Temu 插件       TK 多店 RPA\n```\n\n70→**原则**\n\n1. 中心无头可集群；采集因登录态 / IP 白名单必须边缘化。\n2. 插件 **不直连数据库**，只调中心 Ingest API。\n3. 赛狐 Worker 与现有海外仓机器可共用固定出口 IP。\n\n### 2.3 技术选型\n\n| 层级 | 选型 | 说明 |\n|------|------|------|\n80→| 后端 | Python 3.12 + FastAPI | 复用海外仓 Python 资产 |\n| 队列 | ARQ 或 Celery + Redis | 定时拉取、异步写飞书 |\n| 主库 | PostgreSQL 16 | SoT；JSONB 兼容平台差异 |\n| 缓存 | Redis 7 | 锁、调度、token |\n| 前端 | Vue 3 + Element Plus | 中后台快速交付 |\n| 插件 | Chrome MV3 | 改造现有三套 |\n| TK 多店 | 紫鸟 + ziniao-cli | 已稳定，封装 Collector |\n| 对象存储 | MinIO 或本地盘 | 巡检截图 |\n| 飞书 | 自建应用 + Bitable + 机器人 | 从 TK 项目抽公共库 |\n| 部署 | Docker Compose | 私有化单机首选 |\n90→| 鉴权 | JWT + RBAC | 店铺数据权限 + 供应商脱敏 |\n\n---\n\n## 3. 核心子系统\n\n### 3.1 统一采集（Collector）\n\n```\ncollectors/\n100→├── agent-core/          # SDK：鉴权、心跳、上报、重试\n├── sellfox-worker/      # 源自海外仓 sellfox 客户端\n├── amazon-extension/    # 前台巡检 12 项（新建）\n├── temu-extension/      # 改造自 temu-plugin\n├── temu-monitor/        # 改造自 temu-monitor\n└── tiktok-ads/          # 改造自 TK 项目\n```\n\n上报统一报文：\n\n110→```json\n{\n  \"source\": \"tiktok_ads\",\n  \"platform\": \"tiktok\",\n  \"shop_id\": \"27501502216807\",\n  \"shop_name\": \"Deal to deal\",\n  \"biz_date\": \"2026-07-26\",\n  \"collected_at\": \"2026-07-27T17:20:00+08:00\",\n  \"idempotency_key\": \"tiktok_ads:27501502216807:拖把7/13:2026-07-26\",\n  \"payload\": {},\n120→  \"evidence\": { \"screenshot_url\": null, \"source_url\": \"...\" }\n}\n```\n\n`idempotency_key` 唯一约束 → 支持重跑不脏数据。\n\n### 3.2 任务引擎（会议规则）\n\n**去重键：** `platform + biz_id + anomaly_type`（如 ASIN + 异常类型）\n\n130→**状态机：**\n\n```\n检出异常\n  ├─ 存在未闭环同键任务 → 只更新进度/数据\n  └─ 否则 → 新建任务，指派第一负责人，写截止时间\nIN_PROGRESS\n  ├─ 每日固定提醒\n  ├─ 人工推进进度\n  └─ 异常消失 → RESOLVED（闭环）\n140→闭环后再次出现 → 新建（不复活旧单）\n```\n\n**账号异常：** 仅异常建任务，正常静默。\n\n### 3.3 调度（对齐会议）\n\n| Job | 时间 | 说明 |\n|-----|------|------|\n| 亚马逊销售异常 | 每日 07:00 | 拉昨日 |\n150→| 亚马逊账号异常 | 05:30 起每 8h，3 次/日 | 前台 + 绩效 |\n| 采购销售天数 | 每周一 07:00 | 赛狐 |\n| TK 广告 | 17:20 | 沿用现网，业务日=昨日 |\n| Temu 监测 | 15min + 09:30/16:30 必提醒 | |\n| 飞书同步 | 5–15min 或事件驱动 | |\n| 库存快照 | 日级 | FBA + FBM/WMS |\n\n### 3.4 飞书同步器\n\n- PostgreSQL = Source of Truth  \n160→- 飞书 = 协作视图 + 告警通道  \n- 维护 `sync_feishu_map(local_id ↔ record_id)`，支持 **update**，禁止只 append 导致重复  \n- 字段别名映射（复用 TK 项目逻辑）\n\n建议多维表：\n\n| 表 | 受众 |\n|----|------|\n| 运营_销售异常跟踪 | 运营 |\n| 运营_账号健康 | 运营 |\n170→| TK_广告日报 | 投流 |\n| Temu_流量与下架 | Temu |\n| 采购_滞销断货 | 采购 |\n| 采购_供应商（脱敏） | 全员 |\n\n### 3.5 通知编排\n\n```\n领域事件 → Router\n  ├─ 企业智能体 IM（主通道）\n180→  ├─ 飞书群机器人\n  └─ 邮件（采购试行）\n收敛：同负责人 N 分钟合并；必提醒可非异常汇总\n```\n\n### 3.6 权限与脱敏\n\n- 用户 → 部门 → 授权店铺  \n- 角色 `procurement_full` 可见供应商名称；其余 API 强制 `name → code`  \n- 采集端使用设备级 API Key + 店铺范围\n190→\n---\n\n## 4. 与现有项目关系\n\n| 项目 | 策略 |\n|------|------|\n| TK 广告 | **最先改造**：先 POST 中心，再由中心同步飞书 |\n| Temu | 插件/monitor 增加 report；下架/限流进任务 |\n| 海外仓发货 | **Phase 0–3 保持独立进程**；仅上报库存与异常事件 |\n200→| 赛狐客户端 | 从 sellfox-bridge 抽出只读 SDK 供 Worker |","content_concise":"1→# 清泉跨境系统 · 架构方案\n\n> 版本：v1.1  \n> 日期：2026-07-28  \n> 依据：技术会.xmind + 海外仓 / Temu 监测 / TK 广告 三项目盘点  \n> 产品组织视角补充：[中台产品蓝图.md](./中台产品蓝图.md)（来源 `中台.xmind`，2026-07-28）\n\n---\n\n10→## 1. 背景与目标\n\n### 1.1 业务目标\n\n建设企业私有化定制平台，汇总 **TikTok Shop、Temu、Amazon** 等电商平台运营数据，支撑：\n\n- 平台销售异常 / 账号异常监控与跟踪任务\n- 采购侧供应商、滞销断货、销售天数\n- 数据落 **线上数据库**，并 **同步导出到飞书多维表格**\n- 以 **企业智能体** 为主通道发送通知（会议红标重点）\n20→\n### 1.2 现有资产\n\n| 项目 | 路径 | 形态 | 数据落点 | 可复用 |\n|------|------|------|----------|--------|\n| 海外仓 | `E:\\project\\海外仓` | Python + Sellfox OpenAPI + WMS + SQLite | 本地 bridge.db | 赛狐鉴权、包裹流水线、WMS、飞书告警 |\n| Temu 监测 | `E:\\project\\temu` | Chrome MV3 + Node/Playwright | 本地 JSON | 后台 hook、赛狐商品、多店、飞书卡片 |\n| TK 广告 | `E:\\project\\海外TK店铺广告投流数据自动化监测` | Chrome MV3 + 紫鸟 CLI + PS | 飞书多维表 | DOM/API 抓取、Bitable 写入、日报、紫鸟编排 |\n\n共性：本机常驻 + 浏览器登录态 + 飞书触达。  \n30→缺口：无统一在线库、无统一任务引擎、无 Web 管理端。\n\n### 1.3 架构跃迁\n\n| 维度 | 现在 | 目标 |\n|------|------|------|\n| 存储 | 本机 JSON / SQLite / 直写飞书 | **PostgreSQL 为 SoT**，飞书为同步出口 |\n| 采集 | 三套独立脚本/插件 | 统一 Collector Agent + 平台适配器 |\n| 业务 | 告警为主 | 监控 → 任务闭环 → 运营看板 |\n| 部署 | 个人 PC 计划任务 | 中心服务 + 边缘采集节点 |\n40→\n---\n\n## 2. 总体架构\n\n### 2.1 逻辑分层\n\n```\n接入层   Web 管理端 │ 飞书多维表/机器人 │ 企业智能体 │ 邮件 │ OpenAPI\n应用层   运营监控 │ 任务引擎 │ 采购 │ 产品中心 │ 报表/导出 │ 权限组织\n50→领域层   异常判定 │ 去重/状态机 │ 调度 │ 飞书同步器 │ 通知编排\n数据层   PostgreSQL │ Redis │ 对象存储 │ 消息/Outbox\n采集层   Amazon插件 │ Temu插件/Monitor │ TK+紫鸟 │ 赛狐 Worker │ 海外仓 Bridge\n```\n\n### 2.2 部署拓扑\n\n```\n              ┌─────────────────────────┐\n              │  中心（固定 IP / 内网）    │\n60→              │  API + Web + PG + Redis  │\n              │  Scheduler + Worker      │\n              └───────────┬─────────────┘\n                          │ HTTPS\n     ┌────────────────────┼────────────────────┐\n     ▼                    ▼                    ▼\n采集机A（白名单IP）   采集机B（运营PC）      紫鸟环境\n赛狐 API Worker      Amazon/Temu 插件       TK 多店 RPA\n```\n\n70→**原则**\n\n1. 中心无头可集群；采集因登录态 / IP 白名单必须边缘化。\n2. 插件 **不直连数据库**，只调中心 Ingest API。\n3. 赛狐 Worker 与现有海外仓机器可共用固定出口 IP。\n\n### 2.3 技术选型\n\n| 层级 | 选型 | 说明 |\n|------|------|------|\n80→| 后端 | Python 3.12 + FastAPI | 复用海外仓 Python 资产 |\n| 队列 | ARQ 或 Celery + Redis | 定时拉取、异步写飞书 |\n| 主库 | PostgreSQL 16 | SoT；JSONB 兼容平台差异 |\n| 缓存 | Redis 7 | 锁、调度、token |\n| 前端 | Vue 3 + Element Plus | 中后台快速交付 |\n| 插件 | Chrome MV3 | 改造现有三套 |\n| TK 多店 | 紫鸟 + ziniao-cli | 已稳定，封装 Collector |\n| 对象存储 | MinIO 或本地盘 | 巡检截图 |\n| 飞书 | 自建应用 + Bitable + 机器人 | 从 TK 项目抽公共库 |\n| 部署 | Docker Compose | 私有化单机首选 |\n90→| 鉴权 | JWT + RBAC | 店铺数据权限 + 供应商脱敏 |\n\n---\n\n## 3. 核心子系统\n\n### 3.1 统一采集（Collector）\n\n```\ncollectors/\n100→├── agent-core/          # SDK：鉴权、心跳、上报、重试\n├── sellfox-worker/      # 源自海外仓 sellfox 客户端\n├── amazon-extension/    # 前台巡检 12 项（新建）\n├── temu-extension/      # 改造自 temu-plugin\n├── temu-monitor/        # 改造自 temu-monitor\n└── tiktok-ads/          # 改造自 TK 项目\n```\n\n上报统一报文：\n\n110→```json\n{\n  \"source\": \"tiktok_ads\",\n  \"platform\": \"tiktok\",\n  \"shop_id\": \"27501502216807\",\n  \"shop_name\": \"Deal to deal\",\n  \"biz_date\": \"2026-07-26\",\n  \"collected_at\": \"2026-07-27T17:20:00+08:00\",\n  \"idempotency_key\": \"tiktok_ads:27501502216807:拖把7/13:2026-07-26\",\n  \"payload\": {},\n120→  \"evidence\": { \"screenshot_url\": null, \"source_url\": \"...\" }\n}\n```\n\n`idempotency_key` 唯一约束 → 支持重跑不脏数据。\n\n### 3.2 任务引擎（会议规则）\n\n**去重键：** `platform + biz_id + anomaly_type`（如 ASIN + 异常类型）\n\n130→**状态机：**\n\n```\n检出异常\n  ├─ 存在未闭环同键任务 → 只更新进度/数据\n  └─ 否则 → 新建任务，指派第一负责人，写截止时间\nIN_PROGRESS\n  ├─ 每日固定提醒\n  ├─ 人工推进进度\n  └─ 异常消失 → RESOLVED（闭环）\n140→闭环后再次出现 → 新建（不复活旧单）\n```\n\n**账号异常：** 仅异常建任务，正常静默。\n\n### 3.3 调度（对齐会议）\n\n| Job | 时间 | 说明 |\n|-----|------|------|\n| 亚马逊销售异常 | 每日 07:00 | 拉昨日 |\n150→| 亚马逊账号异常 | 05:30 起每 8h，3 次/日 | 前台 + 绩效 |\n| 采购销售天数 | 每周一 07:00 | 赛狐 |\n| TK 广告 | 17:20 | 沿用现网，业务日=昨日 |\n| Temu 监测 | 15min + 09:30/16:30 必提醒 | |\n| 飞书同步 | 5–15min 或事件驱动 | |\n| 库存快照 | 日级 | FBA + FBM/WMS |\n\n### 3.4 飞书同步器\n\n- PostgreSQL = Source of Truth  \n160→- 飞书 = 协作视图 + 告警通道  \n- 维护 `sync_feishu_map(local_id ↔ record_id)`，支持 **update**，禁止只 append 导致重复  \n- 字段别名映射（复用 TK 项目逻辑）\n\n建议多维表：\n\n| 表 | 受众 |\n|----|------|\n| 运营_销售异常跟踪 | 运营 |\n| 运营_账号健康 | 运营 |\n170→| TK_广告日报 | 投流 |\n| Temu_流量与下架 | Temu |\n| 采购_滞销断货 | 采购 |\n| 采购_供应商（脱敏） | 全员 |\n\n### 3.5 通知编排\n\n```\n领域事件 → Router\n  ├─ 企业智能体 IM（主通道）\n180→  ├─ 飞书群机器人\n  └─ 邮件（采购试行）\n收敛：同负责人 N 分钟合并；必提醒可非异常汇总\n```\n\n### 3.6 权限与脱敏\n\n- 用户 → 部门 → 授权店铺  \n- 角色 `procurement_full` 可见供应商名称；其余 API 强制 `name → code`  \n- 采集端使用设备级 API Key + 店铺范围\n190→\n---\n\n## 4. 与现有项目关系\n\n| 项目 | 策略 |\n|------|------|\n| TK 广告 | **最先改造**：先 POST 中心，再由中心同步飞书 |\n| Temu | 插件/monitor 增加 report；下架/限流进任务 |\n| 海外仓发货 | **Phase 0–3 保持独立进程**；仅上报库存与异常事件 |\n200→| 赛狐客户端 | 从 sellfox-bridge 抽出只读 SDK 供 Worker |","absolute_path":"E:\\project\\清泉跨境系统（企业级）\\docs\\架构方案.md","offset":null,"limit":200,"raw_output":"# 清泉跨境系统 · 架构方案\n\n> 版本：v1.1  \n> 日期：2026-07-28  \n> 依据：技术会.xmind + 海外仓 / Temu 监测 / TK 广告 三项目盘点  \n> 产品组织视角补充：[中台产品蓝图.md](./中台产品蓝图.md)（来源 `中台.xmind`，2026-07-28）\n\n---\n\n## 1. 背景与目标\n\n### 1.1 业务目标\n\n建设企业私有化定制平台，汇总 **TikTok Shop、Temu、Amazon** 等电商平台运营数据，支撑：\n\n- 平台销售异常 / 账号异常监控与跟踪任务\n- 采购侧供应商、滞销断货、销售天数\n- 数据落 **线上数据库**，并 **同步导出到飞书多维表格**\n- 以 **企业智能体** 为主通道发送通知（会议红标重点）\n\n### 1.2 现有资产\n\n| 项目 | 路径 | 形态 | 数据落点 | 可复用 |\n|------|------|------|----------|--------|\n| 海外仓 | `E:\\project\\海外仓` | Python + Sellfox OpenAPI + WMS + SQLite | 本地 bridge.db | 赛狐鉴权、包裹流水线、WMS、飞书告警 |\n| Temu 监测 | `E:\\project\\temu` | Chrome MV3 + Node/Playwright | 本地 JSON | 后台 hook、赛狐商品、多店、飞书卡片 |\n| TK 广告 | `E:\\project\\海外TK店铺广告投流数据自动化监测` | Chrome MV3 + 紫鸟 CLI + PS | 飞书多维表 | DOM/API 抓取、Bitable 写入、日报、紫鸟编排 |\n\n共性：本机常驻 + 浏览器登录态 + 飞书触达。  \n缺口：无统一在线库、无统一任务引擎、无 Web 管理端。\n\n### 1.3 架构跃迁\n\n| 维度 | 现在 | 目标 |\n|------|------|------|\n| 存储 | 本机 JSON / SQLite / 直写飞书 | **PostgreSQL 为 SoT**，飞书为同步出口 |\n| 采集 | 三套独立脚本/插件 | 统一 Collector Agent + 平台适配器 |\n| 业务 | 告警为主 | 监控 → 任务闭环 → 运营看板 |\n| 部署 | 个人 PC 计划任务 | 中心服务 + 边缘采集节点 |\n\n---\n\n## 2. 总体架构\n\n### 2.1 逻辑分层\n\n```\n接入层   Web 管理端 │ 飞书多维表/机器人 │ 企业智能体 │ 邮件 │ OpenAPI\n应用层   运营监控 │ 任务引擎 │ 采购 │ 产品中心 │ 报表/导出 │ 权限组织\n领域层   异常判定 │ 去重/状态机 │ 调度 │ 飞书同步器 │ 通知编排\n数据层   PostgreSQL │ Redis │ 对象存储 │ 消息/Outbox\n采集层   Amazon插件 │ Temu插件/Monitor │ TK+紫鸟 │ 赛狐 Worker │ 海外仓 Bridge\n```\n\n### 2.2 部署拓扑\n\n```\n              ┌─────────────────────────┐\n              │  中心（固定 IP / 内网）    │\n              │  API + Web + PG + Redis  │\n              │  Scheduler + Worker      │\n              └───────────┬─────────────┘\n                          │ HTTPS\n     ┌────────────────────┼────────────────────┐\n     ▼                    ▼                    ▼\n采集机A（白名单IP）   采集机B（运营PC）      紫鸟环境\n赛狐 API Worker      Amazon/Temu 插件       TK 多店 RPA\n```\n\n**原则**\n\n1. 中心无头可集群；采集因登录态 / IP 白名单必须边缘化。\n2. 插件 **不直连数据库**，只调中心 Ingest API。\n3. 赛狐 Worker 与现有海外仓机器可共用固定出口 IP。\n\n### 2.3 技术选型\n\n| 层级 | 选型 | 说明 |\n|------|------|------|\n| 后端 | Python 3.12 + FastAPI | 复用海外仓 Python 资产 |\n| 队列 | ARQ 或 Celery + Redis | 定时拉取、异步写飞书 |\n| 主库 | PostgreSQL 16 | SoT；JSONB 兼容平台差异 |\n| 缓存 | Redis 7 | 锁、调度、token |\n| 前端 | Vue 3 + Element Plus | 中后台快速交付 |\n| 插件 | Chrome MV3 | 改造现有三套 |\n| TK 多店 | 紫鸟 + ziniao-cli | 已稳定，封装 Collector |\n| 对象存储 | MinIO 或本地盘 | 巡检截图 |\n| 飞书 | 自建应用 + Bitable + 机器人 | 从 TK 项目抽公共库 |\n| 部署 | Docker Compose | 私有化单机首选 |\n| 鉴权 | JWT + RBAC | 店铺数据权限 + 供应商脱敏 |\n\n---\n\n## 3. 核心子系统\n\n### 3.1 统一采集（Collector）\n\n```\ncollectors/\n├── agent-core/          # SDK：鉴权、心跳、上报、重试\n├── sellfox-worker/      # 源自海外仓 sellfox 客户端\n├── amazon-extension/    # 前台巡检 12 项（新建）\n├── temu-extension/      # 改造自 temu-plugin\n├── temu-monitor/        # 改造自 temu-monitor\n└── tiktok-ads/          # 改造自 TK 项目\n```\n\n上报统一报文：\n\n```json\n{\n  \"source\": \"tiktok_ads\",\n  \"platform\": \"tiktok\",\n  \"shop_id\": \"27501502216807\",\n  \"shop_name\": \"Deal to deal\",\n  \"biz_date\": \"2026-07-26\",\n  \"collected_at\": \"2026-07-27T17:20:00+08:00\",\n  \"idempotency_key\": \"tiktok_ads:27501502216807:拖把7/13:2026-07-26\",\n  \"payload\": {},\n  \"evidence\": { \"screenshot_url\": null, \"source_url\": \"...\" }\n}\n```\n\n`idempotency_key` 唯一约束 → 支持重跑不脏数据。\n\n### 3.2 任务引擎（会议规则）\n\n**去重键：** `platform + biz_id + anomaly_type`（如 ASIN + 异常类型）\n\n**状态机：**\n\n```\n检出异常\n  ├─ 存在未闭环同键任务 → 只更新进度/数据\n  └─ 否则 → 新建任务，指派第一负责人，写截止时间\nIN_PROGRESS\n  ├─ 每日固定提醒\n  ├─ 人工推进进度\n  └─ 异常消失 → RESOLVED（闭环）\n闭环后再次出现 → 新建（不复活旧单）\n```\n\n**账号异常：** 仅异常建任务，正常静默。\n\n### 3.3 调度（对齐会议）\n\n| Job | 时间 | 说明 |\n|-----|------|------|\n| 亚马逊销售异常 | 每日 07:00 | 拉昨日 |\n| 亚马逊账号异常 | 05:30 起每 8h，3 次/日 | 前台 + 绩效 |\n| 采购销售天数 | 每周一 07:00 | 赛狐 |\n| TK 广告 | 17:20 | 沿用现网，业务日=昨日 |\n| Temu 监测 | 15min + 09:30/16:30 必提醒 | |\n| 飞书同步 | 5–15min 或事件驱动 | |\n| 库存快照 | 日级 | FBA + FBM/WMS |\n\n### 3.4 飞书同步器\n\n- PostgreSQL = Source of Truth  \n- 飞书 = 协作视图 + 告警通道  \n- 维护 `sync_feishu_map(local_id ↔ record_id)`，支持 **update**，禁止只 append 导致重复  \n- 字段别名映射（复用 TK 项目逻辑）\n\n建议多维表：\n\n| 表 | 受众 |\n|----|------|\n| 运营_销售异常跟踪 | 运营 |\n| 运营_账号健康 | 运营 |\n| TK_广告日报 | 投流 |\n| Temu_流量与下架 | Temu |\n| 采购_滞销断货 | 采购 |\n| 采购_供应商（脱敏） | 全员 |\n\n### 3.5 通知编排\n\n```\n领域事件 → Router\n  ├─ 企业智能体 IM（主通道）\n  ├─ 飞书群机器人\n  └─ 邮件（采购试行）\n收敛：同负责人 N 分钟合并；必提醒可非异常汇总\n```\n\n### 3.6 权限与脱敏\n\n- 用户 → 部门 → 授权店铺  \n- 角色 `procurement_full` 可见供应商名称；其余 API 强制 `name → code`  \n- 采集端使用设备级 API Key + 店铺范围\n\n---\n\n## 4. 与现有项目关系\n\n| 项目 | 策略 |\n|------|------|\n| TK 广告 | **最先改造**：先 POST 中心，再由中心同步飞书 |\n| Temu | 插件/monitor 增加 report；下架/限流进任务 |\n| 海外仓发货 | **Phase 0–3 保持独立进程**；仅上报库存与异常事件 |\n| 赛狐客户端 | 从 sellfox-bridge 抽出只读 SDK 供 Worker |\n","total_lines":269}}},"_meta":{"totalTokens":27920,"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-648","agentTimestampMs":1785288905183,"promptId":"0526c8d0-8a0e-48ec-acc8-fce279033c11","streamStartMs":1785288902016,"turnStartMs":1785288896942,"updateType":"ToolCallUpdate","updateParams":{"toolCallId":"call-a41ec09c-a6d9-4ca5-a67b-713c45aab783-6","status":"Completed"}}}}
{"timestamp":1785288907,"method":"session/update","params":{"sessionId":"019fab7f-7ed9-7553-a471-73b6cca96147","update":{"sessionUpdate":"tool_call_update","toolCallId":"call-a41ec09c-a6d9-4ca5-a67b-713c45aab783-9","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1→-- 002 Amazon 环比样板：事实 / 规则 / 跑批 / task 扩展\n-- 文档：docs/AMZ环比异常-人维任务草案.md（v0.2）\n-- 依赖：001_init.sql\n-- 业务已确认（2026-07-28）：\n--   自然周/月 · 下列种子阈值 · 多单并行 · listing_owner · 首期指标仅 units+sales_amount\n\n-- 链接日事实\nCREATE TABLE IF NOT EXISTS fact_amz_link_daily (\n    id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n10→    shop_id             UUID REFERENCES shop(id),\n    shop_external_id    TEXT NOT NULL,\n    biz_date            DATE NOT NULL,\n    asin                TEXT,\n    seller_sku          TEXT,\n    parent_asin         TEXT,\n    title               TEXT,\n    units               NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    sales_amount        NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    currency            TEXT DEFAULT 'GBP',\n20→    sessions            NUMERIC(18, 4),\n    conversion_rate     NUMERIC(18, 6),\n    fba_fulfillable     NUMERIC(18, 4),\n    raw_extra           JSONB NOT NULL DEFAULT '{}'::jsonb,\n    ingest_id           UUID REFERENCES ingest_raw(id),\n    collected_at        TIMESTAMPTZ,\n    created_at          TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at          TIMESTAMPTZ NOT NULL DEFAULT now(),\n    biz_key             TEXT GENERATED ALWAYS AS (\n                            CASE\n30→                                WHEN asin IS NOT NULL AND btrim(asin) <> '' THEN 'asin:' || btrim(asin)\n                                ELSE 'sku:' || coalesce(btrim(seller_sku), '')\n                            END\n                        ) STORED,\n    CONSTRAINT chk_amz_link_identity CHECK (\n        (asin IS NOT NULL AND btrim(asin) <> '')\n        OR (seller_sku IS NOT NULL AND btrim(seller_sku) <> '')\n    )\n);\n\n40→CREATE UNIQUE INDEX IF NOT EXISTS uq_fact_amz_link_daily\n    ON fact_amz_link_daily (shop_external_id, biz_date, biz_key);\n\nCREATE INDEX IF NOT EXISTS idx_fact_amz_link_shop_date\n    ON fact_amz_link_daily (shop_id, biz_date DESC);\n\nCREATE INDEX IF NOT EXISTS idx_fact_amz_link_asin_date\n    ON fact_amz_link_daily (asin, biz_date DESC);\n\n-- 环比规则\n50→CREATE TABLE IF NOT EXISTS amz_mom_rule (\n    id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    code                TEXT NOT NULL UNIQUE,\n    name                TEXT NOT NULL,\n    metric              TEXT NOT NULL CHECK (metric IN ('units', 'sales_amount', 'sessions')),\n    period              TEXT NOT NULL CHECK (period IN ('day', 'week', 'month')),\n    compare             TEXT NOT NULL DEFAULT 'mom',\n    drop_ratio_gte      NUMERIC(8, 4) NOT NULL,\n    drop_abs_gte        NUMERIC(18, 4),\n    min_base_value      NUMERIC(18, 4) NOT NULL DEFAULT 0,\n60→    severity            TEXT NOT NULL DEFAULT 'warn'\n                        CHECK (severity IN ('info', 'warn', 'high', 'critical')),\n    enabled             BOOLEAN NOT NULL DEFAULT TRUE,\n    platform            TEXT NOT NULL DEFAULT 'amazon',\n    meta                JSONB NOT NULL DEFAULT '{}'::jsonb,\n    created_at          TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at          TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\n-- 跑批\n70→CREATE TABLE IF NOT EXISTS amz_mom_eval_run (\n    id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    biz_date            DATE NOT NULL,\n    period              TEXT,\n    status              TEXT NOT NULL DEFAULT 'pending'\n                        CHECK (status IN ('pending', 'running', 'success', 'failed')),\n    rules_snapshot      JSONB NOT NULL DEFAULT '[]'::jsonb,\n    stats               JSONB NOT NULL DEFAULT '{}'::jsonb,\n    error_message       TEXT,\n    started_at          TIMESTAMPTZ,\n80→    finished_at         TIMESTAMPTZ,\n    created_at          TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE INDEX IF NOT EXISTS idx_amz_mom_run_date ON amz_mom_eval_run (biz_date DESC);\n\n-- task 轻量扩展\nALTER TABLE task ADD COLUMN IF NOT EXISTS domain TEXT NOT NULL DEFAULT 'ops';\nALTER TABLE task ADD COLUMN IF NOT EXISTS metric_snapshot JSONB NOT NULL DEFAULT '{}'::jsonb;\nALTER TABLE task ADD COLUMN IF NOT EXISTS owner_source TEXT;\n90→\nCREATE INDEX IF NOT EXISTS idx_task_domain_platform ON task (domain, platform, status);\n\n-- ASIN 负责人（可选）\nCREATE TABLE IF NOT EXISTS listing_owner (\n    id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    platform            TEXT NOT NULL,\n    shop_id             UUID REFERENCES shop(id),\n    biz_id              TEXT NOT NULL,\n    biz_id_type         TEXT NOT NULL DEFAULT 'asin',\n100→    owner_user_id       UUID NOT NULL REFERENCES org_user(id),\n    created_at          TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at          TIMESTAMPTZ NOT NULL DEFAULT now(),\n    UNIQUE (platform, shop_id, biz_id_type, biz_id)\n);\n\n-- 种子规则（业务已确认采用；仅 units + sales_amount）\nINSERT INTO amz_mom_rule (code, name, metric, period, drop_ratio_gte, min_base_value, severity)\nVALUES\n    ('link_dod_units_drop', '链接日销量环比下降', 'units', 'day', 0.40, 5, 'warn'),\n110→    ('link_wow_units_drop', '链接周销量环比下降', 'units', 'week', 0.30, 10, 'high'),\n    ('link_mom_units_drop', '链接月销量环比下降', 'units', 'month', 0.30, 20, 'high'),\n    ('link_wow_sales_drop', '链接周销售额环比下降', 'sales_amount', 'week', 0.30, 100, 'warn')\nON CONFLICT (code) DO NOTHING;\n\nCOMMENT ON TABLE fact_amz_link_daily IS 'Amazon 链接日指标；环比样板事实源';\nCOMMENT ON TABLE amz_mom_rule IS 'Amazon 环比异常规则；code=anomaly_type';\nCOMMENT ON TABLE amz_mom_eval_run IS '环比扫描跑批记录';\nCOMMENT ON TABLE listing_owner IS '链接级第一负责人；优先于 shop.primary_owner_user_id';\n"}}],"rawOutput":{"type":"ReadFile","FileContent":{"content":"1→-- 002 Amazon 环比样板：事实 / 规则 / 跑批 / task 扩展\n-- 文档：docs/AMZ环比异常-人维任务草案.md（v0.2）\n-- 依赖：001_init.sql\n-- 业务已确认（2026-07-28）：\n--   自然周/月 · 下列种子阈值 · 多单并行 · listing_owner · 首期指标仅 units+