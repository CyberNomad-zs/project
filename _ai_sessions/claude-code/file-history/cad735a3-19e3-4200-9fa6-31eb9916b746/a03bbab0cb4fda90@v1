from __future__ import annotations

import os
from functools import lru_cache
from pathlib import Path
from typing import Any

import yaml
from pydantic import Field
from pydantic_settings import BaseSettings, SettingsConfigDict

ROOT_DIR = Path(__file__).resolve().parent.parent
DEFAULT_CONFIG_PATH = ROOT_DIR / "config" / "config.yaml"
EXAMPLE_CONFIG_PATH = ROOT_DIR / "config" / "config.example.yaml"
DEFAULT_RULES_PATH = ROOT_DIR / "config" / "rules.default.yaml"


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=str(ROOT_DIR / ".env"),
        env_file_encoding="utf-8",
        extra="ignore",
    )

    sellfox_client_id: str = Field(default="", alias="SELLFOX_CLIENT_ID")
    sellfox_client_secret: str = Field(default="", alias="SELLFOX_CLIENT_SECRET")
    sellfox_base_url: str = Field(
        default="https://openapi.sellfox.com", alias="SELLFOX_BASE_URL"
    )

    feishu_app_id: str = Field(default="", alias="FEISHU_APP_ID")
    feishu_app_secret: str = Field(default="", alias="FEISHU_APP_SECRET")
    feishu_bitable_app_token: str = Field(default="", alias="FEISHU_BITABLE_APP_TOKEN")
    feishu_table_asin_daily: str = Field(default="", alias="FEISHU_TABLE_ASIN_DAILY")
    feishu_table_tasks: str = Field(default="", alias="FEISHU_TABLE_TASKS")
    feishu_table_actions: str = Field(default="", alias="FEISHU_TABLE_ACTIONS")
    feishu_table_config: str = Field(default="", alias="FEISHU_TABLE_CONFIG")
    feishu_table_daily_summary: str = Field(default="", alias="FEISHU_TABLE_DAILY_SUMMARY")
    feishu_table_product_master: str = Field(default="", alias="FEISHU_TABLE_PRODUCT_MASTER")
    feishu_bot_webhook: str = Field(default="", alias="FEISHU_BOT_WEBHOOK")
    # 按店子表注册表路径（JSON）；空则 data/feishu_shop_tables.json
    feishu_shop_tables_path: str = Field(default="", alias="FEISHU_SHOP_TABLES_PATH")

    data_dir: Path = Field(default=ROOT_DIR / "data", alias="DATA_DIR")
    log_level: str = Field(default="INFO", alias="LOG_LEVEL")

    @property
    def db_path(self) -> Path:
        return Path(self.data_dir) / "bridge.db"

    @property
    def shop_tables_path(self) -> Path:
        if self.feishu_shop_tables_path:
            p = Path(self.feishu_shop_tables_path)
            return p if p.is_absolute() else ROOT_DIR / p
        return Path(self.data_dir) / "feishu_shop_tables.json"

    @property
    def has_sellfox(self) -> bool:
        return bool(self.sellfox_client_id and self.sellfox_client_secret)

    @property
    def has_feishu(self) -> bool:
        return bool(self.feishu_app_id and self.feishu_app_secret)


def load_yaml(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        data = yaml.safe_load(f) or {}
    if not isinstance(data, dict):
        raise ValueError(f"YAML root must be mapping: {path}")
    return data


@lru_cache
def get_settings() -> Settings:
    return Settings()


def get_app_config() -> dict[str, Any]:
    """Merge example defaults with optional config.yaml."""
    base = load_yaml(EXAMPLE_CONFIG_PATH)
    override = load_yaml(DEFAULT_CONFIG_PATH)
    return _deep_merge(base, override)


def get_rules_config() -> dict[str, Any]:
    return load_yaml(DEFAULT_RULES_PATH)


def _deep_merge(a: dict[str, Any], b: dict[str, Any]) -> dict[str, Any]:
    out = dict(a)
    for k, v in b.items():
        if k in out and isinstance(out[k], dict) and isinstance(v, dict):
            out[k] = _deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def ensure_data_dir(settings: Settings | None = None) -> Path:
    s = settings or get_settings()
    path = Path(s.data_dir)
    path.mkdir(parents=True, exist_ok=True)
    (path / "snapshots").mkdir(parents=True, exist_ok=True)
    return path
