end, 0) AS ad_spend,\n        COALESCE(a.ad_revenue, 0) AS ad_revenue,\n        COALESCE(a.ad_orders, 0) AS ad_orders,\n        a.ad_currency,\n        h.health_score,\n        h.status_label AS health_status,\n        h.late_dispatch_rate,\n        h.negative_feedback_rate,\n        f.settlement_amount,\n        f.pending_amount,\n        f.refund_amount AS finance_refund,\n        f.currency AS finance_currency\n    FROM tk.fact_tiktok_shop_daily s\n    LEFT JOIN (\n        SELECT\n            shop_external_id,\n            biz_date,\n            SUM(spend) AS ad_spend,\n            SUM(revenue) AS ad_revenue,\n            SUM(orders) AS ad_orders,\n            MAX(currency) AS ad_currency\n        FROM tk.fact_ads_campaign_daily\n        WHERE campaign_name !~ '^【'\n        GROUP BY shop_external_id, biz_date\n    ) a\n      ON a.shop_external_id = s.shop_external_id\n     AND a.biz_date = s.biz_date\n    LEFT JOIN tk.fact_tiktok_health_daily h\n      ON h.shop_external_id = s.shop_external_id\n     AND h.biz_date = s.biz_date\n    LEFT JOIN tk.fact_tiktok_finance_daily f\n      ON f.shop_external_id = s.shop_external_id\n     AND f.biz_date = s.biz_date\n    WHERE (\n            CAST(:filter_biz AS boolean) = false\n            OR s.biz_date = :biz_date\n          )\n      AND (\n            CAST(:filter_since AS boolean) = false\n            OR s.updated_at >= :since\n            OR s.biz_date >= :since_date\n==== AMZ SYNC HEAD ====\n\"\"\"Amazon 驾驶舱：PG 事实表 → 飞书多维表同步。\n\ntable_key:\n  - amz_shop_daily  → fact_amz_shop_daily → T1\n  - amz_link_daily  → fact_amz_link_daily → T3\n  - amz_risk        → fact_amz_risk_alert → T6\n\n正式链路：Ingest → PG → 本模块（由 export / worker 触发）→ 飞书。\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nfrom datetime import date, datetime, timedelta, timezone\nfrom typing import Any\nfrom uuid import uuid4\n\nfrom sqlalchemy import text\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom app.adapters.feishu import bitable\nfrom app.config import Settings, get_settings\n\nlogger = logging.getLogger(\"qingquan.amz_feishu_sync\")\n\nTABLE_SPECS: dict[str, dict[str, Any]] = {\n    \"amz_shop_daily\": {\n        \"local_table\": \"fact_amz_shop_daily\",\n        \"date_col\": \"biz_date\",\n        \"mapper\": bitable.amz_shop_daily_to_fields,\n        \"select\": \"\"\"\n            SELECT id::text, shop_external_id, shop_name, biz_date, marketplace, currency,\n                   sales_amount, orders_cnt, units, sessions, add_to_cart, aov,\n                   refund_units, refund_rate, gross_profit, ad_spend, ad_sales, acos,\n                   ad_contrib_margin, net_profit, net_margin, roi,\n                   sales_mom_ratio, profit_mom_ratio, sales_yoy_ratio,\n                   row_status, source_url, collected_at\n            FROM fact_amz_shop_daily\n            WHERE (:biz_date IS NULL OR biz_date = CAST(:biz_date AS date))\n              AND (:since IS NULL OR updated_at >= CAST(:since AS timestamptz)\n                   OR biz_date >= CAST(:since_date AS date))\n            ORDER BY biz_date DESC, shop_external_id\n            LIMIT :lim\n        \"\"\",\n    },\n    \"amz_link_daily\": {\n        \"local_table\": \"fact_amz_link_daily\",\n        \"date_col\": \"biz_date\",\n        \"mapper\": bitable.amz_link_daily_to_fields,\n        \"select\": \"\"\"\n            SELECT id::text, shop_external_id, biz_date, asin, seller_sku, title, category,\n                   units, sales_amount, currency, sessions, ad_spend, acos, unit_net_profit,\n                   fba_fulfillable, days_of_supply, refund_rate,\n                   units_mom_ratio, sales_mom_ratio, problem_tags, owner_name, collected_at\n            FROM fact_amz_link_daily\n            WHERE (:biz_date IS NULL OR biz_date = CAST(:biz_date AS date))\n              AND (:since IS NULL OR updated_at >= CAST(:since AS timestamptz)\n                   OR biz_date >= CAST(:since_date AS date))\n            ORDER BY biz_date DESC, shop_external_id, asin\n            LIMIT :lim\n==== MIGRATION 009 ====\n-- 009 Amazon 驾驶舱：店铺日经营 + 风险告警（飞书 T1/T6）\n-- 文档：docs/AMZ-飞书驾驶舱建表方案.md\n-- 依赖：001_init.sql · 002_amz_mom_tasks.sql（链接日已有）\n-- 口径：净利润/ROI 列可空（业务未定）；币种必填便于后续合计策略\n\n-- ---------------------------------------------------------------------------\n-- T1 对应：店铺 × 日 经营事实\n-- ---------------------------------------------------------------------------\nCREATE TABLE IF NOT EXISTS fact_amz_shop_daily (\n    id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    shop_id             UUID REFERENCES shop(id),\n    shop_external_id    TEXT NOT NULL,\n    shop_name           TEXT,\n    biz_date            DATE NOT NULL,\n    marketplace         TEXT,\n    currency            TEXT NOT NULL DEFAULT 'GBP',\n    sales_amount        NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    orders_cnt          NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    units               NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    sessions            NUMERIC(18, 4),\n    add_to_cart         NUMERIC(18, 4),\n    aov                 NUMERIC(18, 4),\n    refund_units        NUMERIC(18, 4),\n    refund_rate         NUMERIC(18, 6),\n    gross_profit        NUMERIC(18, 4),\n    ad_spend            NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    ad_sales            NUMERIC(18, 4) NOT NULL DEFAULT 0,\n    acos                NUMERIC(18, 6),\n    ad_contrib_margin   NUMERIC(18, 4),\n    net_profit          NUMERIC(18, 4),\n    net_margin          NUMERIC(18, 6),\n    roi                 NUMERIC(18, 6),\n    organic_sales       NUMERIC(18, 4),\n    ad_orders           NUMERIC(18, 4),\n    organic_orders      NUMERIC(18, 4),\n    cogs                NUMERIC(18, 4),\n    fba_fees            NUMERIC(18, 4),\n    platform_fees       NUMERIC(18, 4),\n    sales_mom_ratio     NUMERIC(18, 6),\n    profit_mom_ratio    NUMERIC(18, 6),\n==== FIELD DICT DIFF ====\nwarning: in the working copy of 'docs/字段映射字典.md', LF will be replaced by CRLF the next time Git touches