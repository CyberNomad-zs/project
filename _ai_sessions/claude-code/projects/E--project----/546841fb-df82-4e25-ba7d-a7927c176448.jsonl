  try:\n            b = page.query_selector(sel)\n            if b and b.is_visible():\n                b.click(); time.sleep(0.6); return\n        except Exception:\n            pass\n    try:\n        page.keyboard.press(\"Escape\")\n    except Exception:\n        pass\n    time.sleep(0.6)\n\n\ndef batch_ship(page):\n    \"\"\"点击'批量发货'，处理'预发货成功'提示。DRY_RUN 下不执行。\"\"\"\n    if config.DRY_RUN:\n        log(\"[WMS][DRY] 将点击'批量发货'（已跳过）\")\n        return True\n    try:\n        page.click(\"button:has-text('批量发货')\", timeout=6000)\n        time.sleep(2)\n        # 可能的二次确认（限可见弹窗）\n        for t in [\"确定\", \"确认\", \"ok\", \"OK\"]:\n            b = page.query_selector(f\".el-message-box__wrapper:visible button:has-text('{t}'), .el-dialog:visible button:has-text('{t}')\")\n            if b and b.is_visible():\n                try: b.click(); time.sleep(1.5)\n                except Exception: pass\n                break\n        time.sleep(2)\n        tips = close_tips(page)   # 捕获并关闭 'Tip: 预发货成功'\n        ok = any(\"预发货成功\" in t or \"成功\" in t for t in tips)\n        log(f\"[WMS] 已执行批量发货  结果Tip={tips}\")\n        return ok if tips else True\n    except Exception as e:\n        log(f\"[WMS] 批量发货失败: {e}\")\n        return False\n\n\ndef read_order_numbers(page):\n    \"\"\"读当前未发货列表的平台订单号（去重）。订单号形如 P2AC6TCD61443。\"\"\"\n    try:\n        nums = page.evaluate(r\"\"\"() => {\n            const s=new Set();\n            document.querySelectorAll('.el-table__row').forEach(r=>{\n                const m=(r.innerText||'').match(/P[0-9A-Z]{9,15}/g); if(m) m.forEach(x=>s.add(x));\n            });\n            return [...s];\n        }\"\"\")\n        return nums or []\n    except Exception:\n        return []\n\n\ndef ship_shop(wms_browser, account, courier):\n    \"\"\"给单个店铺发货：用【独立干净 WMS context】登录 + process_shop，用完即关。\n    独立 context 是根治「多账号共用一个 context 时，第二个账号登录读到前一个账号会话」\n    的关键（实测 2026-07-10：黑猫先登→金猫后登，金猫会读到黑猫的空列表=漏发）。\n    wms_browser: 独立于 ERP 持久 context 的 browser（run_shipping/shipping_loop 里 launch）。\n    返回 process_shop 的结果 dict。\"\"\"\n    wctx = wms_browser.new_context(ignore_https_errors=True)\n    wpage = wctx.new_page()\n    try:\n        return process_shop(wpage, account, courier)\n    finally:\n        try:\n            wctx.close()\n        except Exception:\n            pass\n\n\ndef process_shop(page, account, courier, already_logged_in=False):\n    \"\"\"处理单个店铺：用【该渠道对应的单一快递方 courier】改快递方 + 批量发货一次。\n    失败的单留在'未发货'即留存（不换别的快递方、不轮转，用户规则 2026-07-09）。\n    返回 {shop, courier, before, left, left_orders}。\"\"\"\n    log(f\"[WMS] === 处理店铺 {account['shop']}（{account['login']}），本渠道快递方 = {courier} ===\")\n    if not courier:\n        log(f\"[WMS] ⚠️ {account['shop']} 未解析出快递方，跳过发货（留存交上层处理）\")\n        return {\"shop\": account[\"shop\"], \"courier\": \"\", \"error\": \"无快递方\", \"left_orders\": []}\n    if not already_logged_in and not core.wms_login(page, account):\n        log(f\"[WMS] {account['shop']} 登录失败，跳过\")\n        return {\"shop\": account[\"shop\"], \"courier\": courier, \"error\": \"登录失败\", \"left_orders\": []}\n    open_platform_orders(page)\n    ensure_unshipped_filter(page)\n\n    total_before = count_rows(page)\n    log(f\"[WMS] {account['shop']} 未发货订单 ≈ {total_before} 条\")\n    if total_before == 0:\n        log(f\"[WMS] {account['shop']} 无未发货订单\")\n        return {\"shop\": account[\"shop\"], \"courier\": courier, \"before\": 0, \"left\": 0, \"left_orders\": []}\n\n    limit = config.MAX_ORDERS_PER_RUN\n    if limit and total_before > limit:\n        log(f\"[WMS][安全] 未发货 {total_before} > 单次上限 {limit}，建议调大 MAX_ORDERS_PER_RUN 或分批。\")\n\n    # 单一快递方：全选 -> 改成 courier -> 重新全选（改后列表刷新丢勾选） -> 批量发货。只一次，不轮转。\n    log(f\"[WMS] 用快递方 [{courier}] 处理 {total_before} 条\")\n    if not select_all(page):\n        log(\"[WMS] 无法全选（可能无数据/禁用），本渠道未发货\")\n    elif not set_courier(page, courier):\n        log(f\"[WMS] 改快递方 {courier} 未成功，本渠道未发货\")\n    elif not set_remote_filter(page, \"否\"):\n        # 需求2：偏远筛选失败则不发货（宁可留存，也不误发偏远/全量单）\n        log(\"[WMS] 设置偏远地区=否 未成功，为避免误发偏远单，本渠道未发货\")\n    elif not select_all(page):\n        log(\"[WMS] 改快递方后重新全选失败，本渠道未发货\")\n    else:\n        batch_ship(page)\n        time.sleep(2)\n\n    open_platform_orders(page)\n    ensure_unshipped_filter(page)\n    left = count_rows(page)\n    left_orders = read_order_numbers(page) if left else []\n    dry = \"（DRY_RUN 未真正发货）\" if config.DRY_RUN else \"\"\n    log(f\"[WMS] {account['shop']} 处理完成，仍未发货 ≈ {left} 条{dry}\")\n    if left and not config.DRY_RUN:\n        log(f\"[WMS] ⚠️ {account['shop']} 用 {courier} 发货后仍未发货（留存，不换快递方）：{left_orders}\")\n    core.log.event(\"WMS发货汇总\", shop=account[\"shop\"], account=account[\"login\"], courier=courier,\n                   before=total_before, shipped=max(0, total_before - left),\n                   left=left, left_orders=left_orders)\n    return {\"shop\": account[\"shop\"], \"courier\": courier, \"before\": total_before,\n            \"left\": left, \"left_orders\": left_orders}\n","numLines":169,"startLine":125,"totalLines":293}},"sourceToolAssistantUUID":"8e179acb-8bdc-40b7-af54-806159e02b78","userType":"external","entrypoint":"cli","cwd":"E:\\project\\海外仓","sessionId":"546841fb-df82-4e25-ba7d-a7927c176448","version":"2.1.201","gitBranch":"HEAD"}
