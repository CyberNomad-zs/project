# 在已有飞书多维表格中创建插件所需字段
# 用法：
#   $env:FEISHU_APP_ID="cli_xxx"
#   $env:FEISHU_APP_SECRET="xxx"
#   powershell -ExecutionPolicy Bypass -File .\scripts\feishu-create-fields.ps1
#
# 可选覆盖：
#   $env:FEISHU_APP_TOKEN="NnpObOqZSa5EjCsQjnqcfVgOnFc"
#   $env:FEISHU_TABLE_ID="tblLPhqUkpWxKT9n"

$ErrorActionPreference = 'Stop'

$appId = $env:FEISHU_APP_ID
$appSecret = $env:FEISHU_APP_SECRET
$appToken = if ($env:FEISHU_APP_TOKEN) { $env:FEISHU_APP_TOKEN } else { 'NnpObOqZSa5EjCsQjnqcfVgOnFc' }
$tableId = if ($env:FEISHU_TABLE_ID) { $env:FEISHU_TABLE_ID } else { 'tblLPhqUkpWxKT9n' }

if (-not $appId -or -not $appSecret) {
  Write-Host @'
缺少凭证。请先设置环境变量后重试：

  $env:FEISHU_APP_ID="cli_xxxx"
  $env:FEISHU_APP_SECRET="你的App Secret"
  powershell -ExecutionPolicy Bypass -File .\scripts\feishu-create-fields.ps1

说明：
1. 打开 https://open.feishu.cn/ 创建企业自建应用，拿到 App ID / App Secret
2. 应用开通「多维表格」相关权限（bitable:app 等）并发布
3. 打开多维表格 → 添加该应用为协作者/文档应用
4. 再运行本脚本

目标表：
  app_token = '"@
  Write-Host "  $appToken"
  Write-Host "  table_id  = $tableId"
  exit 1
}

function Invoke-FeishuJson {
  param(
    [string]$Method,
    [string]$Url,
    [hashtable]$Headers,
    [object]$Body
  )
  $params = @{
    Method      = $Method
    Uri         = $Url
    Headers     = $Headers
    ContentType = 'application/json; charset=utf-8'
  }
  if ($null -ne $Body) {
    $params.Body = ($Body | ConvertTo-Json -Depth 10 -Compress)
  }
  $resp = Invoke-RestMethod @params
  return $resp
}

Write-Host "1) 获取 tenant_access_token ..."
$tokenResp = Invoke-FeishuJson -Method POST `
  -Url 'https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal' `
  -Headers @{} `
  -Body @{ app_id = $appId; app_secret = $appSecret }

if ($tokenResp.code -ne 0) {
  throw "获取 token 失败: code=$($tokenResp.code) msg=$($tokenResp.msg)"
}
$token = $tokenResp.tenant_access_token
$auth = @{ Authorization = "Bearer $token" }
Write-Host "   OK"

Write-Host "2) 列出已有字段 ..."
$listUrl = "https://open.feishu.cn/open-apis/bitable/v1/apps/$appToken/tables/$tableId/fields?page_size=100"
$listResp = Invoke-FeishuJson -Method GET -Url $listUrl -Headers $auth -Body $null
if ($listResp.code -ne 0) {
  throw "列字段失败: code=$($listResp.code) msg=$($listResp.msg) —— 请确认应用已加入该多维表格且有编辑权限"
}
$existing = @{}
foreach ($f in @($listResp.data.items)) {
  if ($f.field_name) { $existing[$f.field_name] = $f }
}
Write-Host ("   已有 {0} 个字段: {1}" -f $existing.Count, ($existing.Keys -join ', '))

# 插件 BITABLE_FIELDS 所需字段（名称必须完全一致）
# type: 1=文本 2=数字 3=单选 5=日期 1001=日期时间(部分租户用5+属性)
# 飞书开放平台：1 Text 2 Number 3 SingleSelect 4 MultiSelect 5 DateTime 7 Checkbox 13 Phone 15 URL ...
$fieldsToCreate = @(
  @{ field_name = '日期';       type = 5;  ui_type = 'DateTime'; property = @{ date_formatter = 'yyyy/MM/dd'; auto_fill = $false } },
  @{ field_name = '店铺';       type = 1 },
  @{ field_name = '店铺ID';     type = 1 },
  @{ field_name = '广告系列名称'; type = 1 },
  @{ field_name = '广告花费';     type = 2; property = @{ formatter = '0.00' } },
  @{ field_name = '销量';       type = 2; property = @{ formatter = '0' } },
  @{ field_name = 'ROI';        type = 2; property = @{ formatter = '0.00' } },
  @{ field_name = '总收入';     type = 2; property = @{ formatter = '0.00' } },
  @{ field_name = '抓取时间';   type = 5; ui_type = 'DateTime'; property = @{ date_formatter = 'yyyy/MM/dd HH:mm'; auto_fill = $false } },
  @{ field_name = '数据源URL';  type = 1 },
  @{ field_name = '状态';       type = 3; property = @{
      options = @(
        @{ name = 'success' },
        @{ name = 'partial' },
        @{ name = 'error' }
      )
    }
  }
)

$createUrl = "https://open.feishu.cn/open-apis/bitable/v1/apps/$appToken/tables/$tableId/fields"
$created = 0
$skipped = 0
$failed = @()

Write-Host "3) 创建缺失字段 ..."
foreach ($spec in $fieldsToCreate) {
  $name = $spec.field_name
  if ($existing.ContainsKey($name)) {
    Write-Host "   skip  $name (已存在)"
    $skipped++
    continue
  }
  $body = @{
    field_name = $name
    type       = $spec.type
  }
  if ($spec.ui_type) { $body.ui_type = $spec.ui_type }
  if ($spec.property) { $body.property = $spec.property }

  try {
    $r = Invoke-FeishuJson -Method POST -Url $createUrl -Headers $auth -Body $body
    if ($r.code -eq 0) {
      Write-Host "   OK    $name (type=$($spec.type))"
      $created++
    }
    else {
      # 日期字段兼容：若 type=5 失败，尝试不带 property
      Write-Host "   FAIL  $name code=$($r.code) msg=$($r.msg)"
      $failed += "$name : $($r.msg)"
    }
  }
  catch {
    Write-Host "   ERR   $name $_"
    $failed += "$name : $_"
  }
  Start-Sleep -Milliseconds 200
}

Write-Host ""
Write-Host "完成: 新建 $created , 跳过 $skipped , 失败 $($failed.Count)"
if ($failed.Count -gt 0) {
  Write-Host "失败明细:"
  $failed | ForEach-Object { Write-Host "  - $_" }
  Write-Host "可在飞书表里手动补建失败字段（名称必须一致）。"
}

Write-Host ""
Write-Host "插件设置请填写："
Write-Host "  App ID     = $appId"
Write-Host "  App Secret = (已用，勿截图外传)"
Write-Host "  App Token  = $appToken"
Write-Host "  Table ID   = $tableId"
Write-Host ""
Write-Host "表格链接: https://dcnkj1up67d5.feishu.cn/base/$appToken`?table=$tableId"
