:root {
  color-scheme: light;
  --bg: #f0f4f5;
  --sidebar: #0f3d3a;
  --sidebar-hover: rgba(255, 255, 255, 0.08);
  --sidebar-active: rgba(45, 212, 191, 0.18);
  --sidebar-text: #d1fae5;
  --sidebar-muted: #99bdb8;
  --card: #ffffff;
  --text: #1f2937;
  --muted: #6b7280;
  --line: #e5e7eb;
  --primary: #0f766e;
  --primary-hover: #0d9488;
  --danger: #b91c1c;
  --warn: #b45309;
  --ok: #047857;
  --shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  --sidebar-w: 236px;
  font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; }
#app { min-height: 100vh; }
body {
  background: var(--bg);
  color: var(--text);
}
button, input, select, textarea { font: inherit; }
a { color: var(--primary); }

/* —— Login —— */
.login-wrap {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background: linear-gradient(160deg, #ecfeff 0%, var(--bg) 55%);
}
.login-card { width: min(420px, 100%); }
.login-card h1 { margin: 0 0 6px; font-size: 22px; }
.login-card .sub { color: var(--muted); margin-bottom: 18px; font-size: 13px; }

/* —— Shell: left nav + right content（整页统一滚动，侧栏与右侧同步） —— */
.app-layout {
  display: flex;
  align-items: stretch;
  min-height: 100vh;
}

.sidebar {
  width: var(--sidebar-w);
  flex: 0 0 var(--sidebar-w);
  background: linear-gradient(180deg, #0f3d3a 0%, #0a2e2b 100%);
  color: var(--sidebar-text);
  display: flex;
  flex-direction: column;
  min-height: 100%;
  /* 不 sticky、不独立 height/overflow，随 document 与右侧一起滚动 */
  position: relative;
  align-self: stretch;
}

.sidebar-brand {
  padding: 22px 18px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}
.sidebar-brand .logo {
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #fff;
}
.sidebar-brand .tag {
  margin-top: 6px;
  font-size: 12px;
  color: var(--sidebar-muted);
}

.sidebar-nav {
  flex: 1 1 auto;
  padding: 10px 10px 16px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: visible;
}

.nav-section-label {
  margin: 12px 10px 6px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--sidebar-muted);
  font-weight: 600;
}
.nav-section-label:first-child { margin-top: 4px; }

.nav-group { display: flex; flex-direction: column; gap: 2px; }

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  border: none;
  background: transparent;
  color: var(--sidebar-text);
  text-align: left;
  padding: 10px 12px;
  border-radius: 10px;
  cursor: pointer;
  font-size: 13.5px;
  transition: background 0.15s ease;
}
.nav-item:hover { background: var(--sidebar-hover); }
.nav-item.active {
  background: var(--sidebar-active);
  color: #fff;
  font-weight: 600;
  box-shadow: inset 3px 0 0 #2dd4bf;
}
.nav-item .icon {
  width: 20px;
  text-align: center;
  opacity: 0.9;
  font-size: 15px;
}
.nav-item .label { flex: 1; min-width: 0; }
.nav-item .chevron {
  font-size: 11px;
  color: var(--sidebar-muted);
  width: 14px;
  text-align: center;
}
.nav-item.nav-group-head.open {
  background: rgba(255, 255, 255, 0.06);
}
.nav-item.nav-group-head.active:not(.child) {
  box-shadow: none;
}
.platform-icon {
  width: 20px;
  height: 20px;
  border-radius: 6px;
  background: rgba(45, 212, 191, 0.2);
  color: #5eead4;
  font-size: 11px;
  font-weight: 800;
  display: inline-grid;
  place-items: center;
  line-height: 1;
}
.nav-children {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 2px 0 6px 8px;
  margin-left: 12px;
  border-left: 1px solid rgba(255, 255, 255, 0.1);
}
.nav-item.child {
  padding: 8px 12px;
  font-size: 13px;
  color: #b7d4cf;
}
.nav-item.child.active {
  color: #fff;
}

.platform-entry-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}
.platform-entry {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  text-align: left;
  border: 1px solid var(--line);
  background: #f8fafc;
  border-radius: 12px;
  padding: 14px;
  cursor: pointer;
}
.platform-entry:hover {
  border-color: #99f6e4;
  background: #f0fdfa;
}
.platform-entry strong { font-size: 15px; color: var(--text); }
.platform-entry .phase-tag { margin-top: 4px; }
.boss-entry-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.phase-tag {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  background: #ffedd5;
  color: var(--warn);
  width: fit-content;
}
.plan-card .plan-p {
  margin: 0;
  font-size: 13px;
  line-height: 1.65;
}
.system-label { margin-top: 16px; opacity: 0.9; }
.system-head { opacity: 0.95; }

/* Finance inner tabs */
.inner-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: -4px 0 16px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--line);
}
.inner-tab {
  border: 1px solid var(--line);
  background: #f8fafc;
  color: var(--text);
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 13px;
  cursor: pointer;
}
.inner-tab:hover { border-color: #99f6e4; }
.inner-tab.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}
.finance-panel { min-height: 160px; }

.sidebar-foot {
  padding: 14px 16px 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 12px;
  color: var(--sidebar-muted);
  flex-shrink: 0;
  margin-top: auto;
}
.sidebar-foot .user {
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 4px;
}
.sidebar-foot .status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  margin-right: 6px;
  vertical-align: middle;
}
.sidebar-foot .status-dot.ok { background: #34d399; }
.sidebar-foot .status-dot.down { background: #f87171; }
.sidebar-foot .logout {
  margin-top: 10px;
  width: 100%;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: transparent;
  color: var(--sidebar-text);
  border-radius: 8px;
  padding: 8px;
  cursor: pointer;
}
.sidebar-foot .logout:hover { background: var(--sidebar-hover); }

.main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  min-height: 100%;
}

.main-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 24px 0;
}
.main-header h1 {
  margin: 0;
  font-size: 20px;
  font-weight: 700;
}
.main-header .desc {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.main-body {
  flex: 1;
  padding: 16px 24px 32px;
}

/* —— Cards / forms —— */
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 14px;
  box-shadow: var(--shadow);
  padding: 18px;
}
.card + .card { margin-top: 16px; }
.card h2 { margin: 0 0 14px; font-size: 16px; }
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}
.card-head h2 { margin: 0; }

.grid-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}
.stat {
  background: #f8fafc;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 14px;
}
.stat .label { color: var(--muted); font-size: 12px; }
.stat .value { margin-top: 6px; font-size: 24px; font-weight: 700; }
.stat.accent { border-color: #99f6e4; background: #f0fdfa; }

.row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
.grow { flex: 1 1 auto; }

label.field { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--muted); }
input, select, textarea {
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 10px 12px;
  background: #fff;
  color: var(--text);
  min-width: 140px;
}
textarea { min-height: 72px; width: 100%; resize: vertical; }

.btn {
  border: none;
  border-radius: 10px;
  padding: 10px 14px;
  cursor: pointer;
  background: #e5e7eb;
  color: var(--text);
}
.btn:hover { filter: brightness(0.98); }
.btn:disabled { opacity: 0.55; cursor: not-allowed; }
.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover { background: var(--primary-hover); }
.btn-danger { background: #fee2e2; color: var(--danger); }
.btn-ghost { background: transparent; border: 1px solid var(--line); }

.table-wrap { overflow: auto; border: 1px solid var(--line); border-radius: 12px; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
th { background: #f8fafc; color: var(--muted); font-weight: 600; white-space: nowrap; }
tr:last-child td { border-bottom: none; }
tr.row-alert td { background: #fff7ed; }
tr.row-alert:hover td { background: #ffedd5; }

.badge {
  display: inline-flex; align-items: center;
  border-radius: 999px; padding: 2px 8px; font-size: 12px; font-weight: 600;
}
.badge.open { background: #dbeafe; color: #1d4ed8; }
.badge.in_progress { background: #ffedd5; color: var(--warn); }
.badge.resolved { background: #d1fae5; color: var(--ok); }
.badge.cancelled { background: #e5e7eb; color: #4b5563; }
.badge.ignored { background: #f3e8ff; color: #7c3aed; }

.chip.pri-p0 { background: #fee2e2; color: #b91c1c; }
.chip.pri-p1 { background: #ffedd5; color: #c2410c; }
.chip.pri-p2 { background: #e5e7eb; color: #4b5563; }

.stack { display: grid; gap: 12px; }
.error {
  background: #fef2f2; color: var(--danger); border: 1px solid #fecaca;
  border-radius: 10px; padding: 10px 12px; font-size: 13px;
}
.muted { color: var(--muted); font-size: 12px; }
.actions { display: flex; gap: 8px; flex-wrap: wrap; }
.mono { font-family: ui-monospace, Consolas, monospace; font-size: 12px; }

.panel-empty {
  padding: 40px 20px;
  text-align: center;
  color: var(--muted);
  font-size: 14px;
}

/* —— Dashboard —— */
.dash-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 16px;
}
.bar-list { display: grid; gap: 12px; }
.bar-row { display: grid; gap: 6px; }
.bar-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: var(--text);
}
.bar-track {
  height: 8px;
  background: #f1f5f9;
  border-radius: 999px;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 999px;
  min-width: 0;
  transition: width 0.25s ease;
}
.bar-fill.platform { background: linear-gradient(90deg, #0f766e, #2dd4bf); }
.platform-tag {
  text-transform: capitalize;
  font-weight: 600;
}
.chip {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: #f0fdfa;
  border: 1px solid #99f6e4;
  color: var(--primary);
  font-size: 12px;
  font-weight: 600;
  text-transform: capitalize;
}

@media (max-width: 900px) {
  .dash-grid { grid-template-columns: 1fr; }
}

/* —— Plugin center —— */
.plugin-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}
.plugin-card { display: flex; flex-direction: column; gap: 10px; }
.plugin-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}
.plugin-name { font-size: 15px; font-weight: 700; }
.plugin-desc {
  margin: 0;
  font-size: 13px;
  color: var(--muted);
  line-height: 1.55;
  flex: 1;
}
.badge-status {
  flex-shrink: 0;
  border-radius: 999px;
  padding: 3px 10px;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}
.badge-status.ready { background: #d1fae5; color: var(--ok); }
.badge-status.building { background: #ffedd5; color: var(--warn); }
.badge-status.pending { background: #dbeafe; color: #1d4ed8; }
.badge-status.planned { background: #e5e7eb; color: #4b5563; }

/* —— Shipping —— */
.pipeline {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}
.pipe-step {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #f8fafc;
}
.pipe-num {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: grid;
  place-items: center;
  font-size: 13px;
  font-weight: 700;
  flex-shrink: 0;
}
.pipe-title { font-weight: 600; font-size: 14px; margin-bottom: 4px; }

/* —— AI reports —— */
.tpl-list { display: grid; gap: 12px; }
.tpl-item {
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #f8fafc;
}
.tpl-name {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  font-weight: 600;
  font-size: 13px;
  margin-bottom: 4px;
}
.ai-preview {
  margin: 0;
  padding: 14px 16px;
  background: #0f172a;
  color: #e2e8f0;
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.65;
  white-space: pre-wrap;
  font-family: ui-monospace, Consolas, monospace;
  overflow: auto;
}

@media (max-width: 900px) {
  .plugin-grid { grid-template-columns: 1fr; }
  .pipeline { grid-template-columns: 1fr 1fr; }
  .platform-entry-grid,
  .boss-entry-grid { grid-template-columns: 1fr; }
  .nav-children { margin-left: 0; border-left: none; padding-left: 0; }
}

@media (max-width: 560px) {
  .pipeline { grid-template-columns: 1fr; }
}

.hint-list {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.drawer-mask {
  position: fixed; inset: 0; background: rgba(15, 23, 42, 0.35);
  display: grid; place-items: end center; padding: 24px;
  z-index: 50;
}
.drawer {
  width: min(520px, 100%); background: #fff; border-radius: 16px;
  padding: 18px; box-shadow: var(--shadow);
}

@media (max-width: 900px) {
  .grid-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .app-layout { flex-direction: column; }
  .sidebar {
    width: 100%;
    flex: none;
    height: auto;
    position: relative;
  }
  .sidebar-nav {
    flex-direction: row;
    flex-wrap: wrap;
    overflow-x: auto;
  }
  .nav-item { width: auto; }
  .sidebar-foot { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .sidebar-foot .logout { width: auto; margin-top: 0; }
}

/* ops knowledge guidance panels */
.kb-panel {
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 8px;
  padding: 10px 12px;
  background: var(--panel-2, #fafafa);
}
.kb-title {
  font-weight: 600;
  margin-bottom: 6px;
  font-size: 13px;
}
.kb-list {
  margin: 0;
  padding-left: 18px;
  font-size: 13px;
}
.kb-playbook {
  padding: 6px 0;
  border-top: 1px dashed var(--border, #e5e7eb);
}
.kb-playbook:first-child { border-top: 0; padding-top: 0; }
