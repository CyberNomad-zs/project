{"parentUuid":"9f877a98-6f97-422c-930c-5f4f843655a7","isSidechain":false,"promptId":"de2203fa-b403-45ea-a0b2-6fb8ed3166b3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q9RZFZPPjBDUhtEDuAJAXH","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"\n3\t只读探测：确认『先选模板』会不会让渠道下拉里的可选渠道变少（=漏筛风险）。\n4\t对比同一『待处理』视图下：\n5\t  (A) 全新视图(无模板) 渠道下拉里所有渠道选项 + 每个 CHANNEL_ORDER 渠道筛出的单数\n6\t  (B) 选模板后        渠道下拉里所有渠道选项 + 每个 CHANNEL_ORDER 渠道筛出的单数\n7\t若 B 的渠道选项集合 == A，且每个渠道单数一致或仅因排除取消单而减少，则『先选模板』安全；\n8\t若 B 里某渠道消失/单数异常变 0 而 A 有单，则说明模板压制了渠道下拉 = 漏发风险。\n9\t只读：绝不点物流下单。输出 UTF-8：capture/dumps/erp_probe_chan_after_tpl.txt\n10\t\"\"\"\n11\timport sys, os, time\n12\tsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n13\timport config\n14\tconfig.DRY_RUN = True\n15\timport core, erp\n16\tfrom rules import CHANNEL_ORDER\n17\tfrom playwright.sync_api import sync_playwright\n18\t\n19\tout = []\n20\tdef w(s=\"\"):\n21\t    out.append(str(s))\n22\t    try: print(s)\n23\t    except Exception: pass\n24\t\n25\t\n26\tdef channel_options(page):\n27\t    \"\"\"打开渠道下拉，读所有可选渠道文本，再关掉。\"\"\"\n28\t    try:\n29\t        erp.dismiss_notifications(page)\n30\t        page.click(\"input[placeholder*='渠道']\", timeout=5000, force=True)\n31\t        time.sleep(1.2)\n32\t        opts = page.evaluate(r\"\"\"() => [...document.querySelectorAll('span.main_label')]\n33\t            .filter(e=>e.offsetParent!==null).map(e=>(e.innerText||'').trim()).filter(Boolean)\"\"\")\n34\t        page.keyboard.press(\"Escape\"); time.sleep(0.5)\n35\t        return sorted(set(opts))\n36\t    except Exception as e:\n37\t        w(f\"  读渠道选项失败: {e}\")\n38\t        return []\n39\t\n40\t\n41\tdef counts_per_channel(page, use_template):\n42\t    res = {}\n43\t    for ch in CHANNEL_ORDER:\n44\t        erp.open_order_ship(page)\n45\t        erp.goto_view(page, \"待处理\")\n46\t        if use_template:\n47\t            erp.select_filter_template(page)\n48\t        ok = erp.filter_by_channel(page, ch)\n49\t        res[ch] = erp.count_orders(page) if ok else \"筛选失败/未找到\"\n50\t    return res\n51\t\n52\t\n53\tdef main():\n54\t    with sync_playwright() as p:\n55\t        ctx = core.open_context(p)\n56\t        page = ctx.pages[0] if ctx.pages else ctx.new_page()\n57\t        try:\n58\t            if not core.ensure_erp(page):\n59\t                w(\"!! ERP 会话失效，先 python capture/erp_manual_login.py\")\n60\t                return\n61\t\n62\t            erp.open_order_ship(page); erp.goto_view(page, \"待处理\")\n63\t            w(f\"(A) 无模板 渠道下拉选项 = {channel_options(page)}\")\n64\t\n65\t            erp.open_order_ship(page); erp.goto_view(page, \"待处理\")\n66\t            erp.select_filter_template(page)\n67\t            w(f\"(B) 选模板后 渠道下拉选项 = {channel_options(page)}\")\n68\t\n69\t            w(\"\\n每渠道筛出单数：\")\n70\t            a = counts_per_channel(page, use_template=False)\n71\t            b = counts_per_channel(page, use_template=True)\n72\t            for ch in CHANNEL_ORDER:\n73\t                flag = \"\" if a.get(ch) == b.get(ch) else \"  <- 不同\"\n74\t                w(f\"  {ch}:  无模板={a.get(ch)}   有模板={b.get(ch)}{flag}\")\n75\t        finally:\n76\t            try: ctx.close()\n77\t            except Exception: pass\n78\t\n79\t    path = os.path.join(config.DUMP_DIR, \"erp_probe_chan_after_tpl.txt\")\n80\t    with open(path, \"w\", encoding=\"utf-8\") as f:\n81\t        f.write(\"\\n\".join(out))\n82\t    print(\"WROTE\", path)\n83\t\n84\t\n85\tif __name__ == \"__main__\":\n86\t    main()\n87\t"}]},"uuid":"deb0f2f4-d7cb-4869-b89b-2c32f14d428f","timestamp":"2026-07-10T03:50:37.893Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\project\\海外仓\\automation\\capture\\erp_probe_chan_after_tpl.py","content":"# -*- coding: utf-8 -*-\n\"\"\"\n只读探测：确认『先选模板』会不会让渠道下拉里的可选渠道变少（=漏筛风险）。\n对比同一『待处理』视图下：\n  (A) 全新视图(无模板) 渠道下拉里所有渠道选项 + 每个 CHANNEL_ORDER 渠道筛出的单数\n  (B) 选模板后        渠道下拉里所有渠道选项 + 每个 CHANNEL_ORDER 渠道筛出的单数\n若 B 的渠道选项集合 == A，且每个渠道单数一致或仅因排除取消单而减少，则『先选模板』安全；\n若 B 里某渠道消失/单数异常变 0 而 A 有单，则说明模板压制了渠道下拉 = 漏发风险。\n只读：绝不点物流下单。输出 UTF-8：capture/dumps/erp_probe_chan_after_tpl.txt\n\"\"\"\nimport sys, os, time\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\nimport config\nconfig.DRY_RUN = True\nimport core, erp\nfrom rules import CHANNEL_ORDER\nfrom playwright.sync_api import sync_playwright\n\nout = []\ndef w(s=\"\"):\n    out.append(str(s))\n    try: print(s)\n    except Exception: pass\n\n\ndef channel_options(page):\n    \"\"\"打开渠道下拉，读所有可选渠道文本，再关掉。\"\"\"\n    try:\n        erp.dismiss_notifications(page)\n        page.click(\"input[placeholder*='渠道']\", timeout=5000, force=True)\n        time.sleep(1.2)\n        opts = page.evaluate(r\"\"\"() => [...document.querySelectorAll('span.main_label')]\n            .filter(e=>e.offsetParent!==null).map(e=>(e.innerText||'').trim()).filter(Boolean)\"\"\")\n        page.keyboard.press(\"Escape\"); time.sleep(0.5)\n        return sorted(set(opts))\n    except Exception as e:\n        w(f\"  读渠道选项失败: {e}\")\n        return []\n\n\ndef counts_per_channel(page, use_template):\n    res = {}\n    for ch in CHANNEL_ORDER:\n        erp.open_order_ship(page)\n        erp.goto_view(page, \"待处理\")\n        if use_template:\n            erp.select_filter_template(page)\n        ok = erp.filter_by_channel(page, ch)\n        res[ch] = erp.count_orders(page) if ok else \"筛选失败/未找到\"\n    return res\n\n\ndef main():\n    with sync_playwright() as p:\n        ctx = core.open_context(p)\n        page = ctx.pages[0] if ctx.pages else ctx.new_page()\n        try:\n            if not core.ensure_erp(page):\n                w(\"!! ERP 会话失效，先 python capture/erp_manual_login.py\")\n                return\n\n            erp.open_order_ship(page); erp.goto_view(page, \"待处理\")\n            w(f\"(A) 无模板 渠道下拉选项 = {channel_options(page)}\")\n\n            erp.open_order_ship(page); erp.goto_view(page, \"待处理\")\n            erp.select_filter_template(page)\n            w(f\"(B) 选模板后 渠道下拉选项 = {channel_options(page)}\")\n\n            w(\"\\n每渠道筛出单数：\")\n            a = counts_per_channel(page, use_template=False)\n            b = counts_per_channel(page, use_template=True)\n            for ch in CHANNEL_ORDER:\n                flag = \"\" if a.get(ch) == b.get(ch) else \"  <- 不同\"\n                w(f\"  {ch}:  无模板={a.get(ch)}   有模板={b.get(ch)}{flag}\")\n        finally:\n            try: ctx.close()\n            except Exception: pass\n\n    path = os.path.join(config.DUMP_DIR, \"erp_probe_chan_after_tpl.txt\")\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(out))\n    print(\"WROTE\", path)\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":87,"startLine":1,"totalLines":87}},"sourceToolAssistantUUID":"9f877a98-6f97-422c-930c-5f4f843655a7","userType":"external","entrypoint":"cli","cwd":"E:\\project\\海外仓","sessionId":"f1228b76-7b7b-4dc7-a875-56738d0166fd","version":"2.1.201","gitBranch":"HEAD"}
{"parentUuid":"2bca4ad0-58fe-4aec-9cd4-ecc4ed67945e","isSidechain":false,"promptId":"de2203fa-b403-45ea-a0b2-6fb8ed3166b3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T26yTrvMavP9LBkms4i2Ta","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"\n3\t主流程编排：按【渠道】逐个闭环。\n4\t  遍历 rules.CHANNEL_ORDER（= 优先级顺序）：\n5\t    ① ERP：待处理视图 -> 按「全部渠道」筛选=该渠道 -> 全选 -> 物流下单 -> 记录失败单\n6\t    ② 该渠道有单才继续 -> WMS：登录该渠道对应账号(BLACKCAT->JMCAT / 昇新->JMSM)\n7\t       -> 平台订单未发货 -> 按账号快递方优先级(RM->DPD->EH)逐轮：改快递方+批量发货，失败的换下个快递方再试\n8\t    ③ 该渠道闭环完成，再做下一个渠道\n9\t  失败订单（下单失败/试完所有快递方仍未发货）不自动挪渠道，统一留存 + 提醒。\n10\t\n11\t安全：config.DRY_RUN=True 时不真正点击 物流下单/批量发货，只走筛选与统计。\n12\t用法：\n13\t    1) 先手动登录一次 ERP： python capture/erp_manual_login.py\n14\t    2) 空跑核对：          python run_shipping.py         （config.DRY_RUN=True）\n15\t    3) 核对无误后改 config.DRY_RUN=False 再跑真实发货。\n16\t\"\"\"\n17\timport os, time\n18\timport config, core, secrets, erp, wms, rules\n19\tfrom core import log\n20\tfrom playwright.sync_api import sync_playwright\n21\t\n22\t# ---- 环节开关 ----\n23\tDO_ERP_REPORT = True          # 只读：ERP 各阶段数量\n24\tDO_PER_CHANNEL = True         # 按渠道逐个闭环 ERP下单 -> WMS发货\n25\t# 下面两个已并入其它实现，默认保持 False，勿开：\n26\t#  · 「确认发货」= 「物流下单」同一步（业务确认 2026-07-08），已在按渠道闭环里执行，\n27\t#    再单独跑会重复扣库存/提交平台 → DO_ERP_CONFIRM_SHIP 永久废弃。\n28\t#  · 「获取跟踪单号」实际路径 = 三方仓>待更新>手动更新（erp.update_order_status），\n29\t#    建议全部发完后用独立常驻脚本 status_update_loop.py 定时拉取，而非跟在发货后跑。\n30\tDO_ERP_TRACKING = False\n31\tDO_ERP_CONFIRM_SHIP = False   # 废弃：与物流下单同一步，勿开（会重复下单）\n32\t\n33\t\n34\tdef account_by_login(login):\n35\t    for a in secrets.WMS_ACCOUNTS:\n36\t        if a[\"login\"] == login:\n37\t            return a\n38\t    return None\n39\t\n40\t\n41\tdef write_failures(failures):\n42\t    \"\"\"把失败订单留存到 logs/failures_YYYYMMDD.txt，便于人工跟进。\"\"\"\n43\t    path = os.path.join(config.LOG_DIR, f\"failures_{time.strftime('%Y%m%d', time.localtime(time.time()))}.txt\")\n44\t    try:\n45\t        with open(path, \"a\", encoding=\"utf-8\") as f:\n46\t            f.write(f\"\\n===== {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(time.time()))} =====\\n\")\n47\t            for x in failures:\n48\t                f.write(f\"[{x['stage']}] 渠道={x.get('channel')} 账号={x.get('account','')} 原因={x['reason']}\\n\")\n49\t                for o in x[\"orders\"]:\n50\t                    f.write(f\"    {o}\\n\")\n51\t        log(f\"[留存] 失败订单已写入 {path}\")\n52\t    except Exception as e:\n53\t        log(f\"[留存] 写失败订单文件出错: {e}\")\n54\t\n55\t\n56\tdef run_pipeline(page, wms_browser, report=True):\n57\t    \"\"\"按渠道逐个闭环跑一遍（ERP物流下单->WMS发货）。返回失败订单留存 list。\n58\t    供 run_shipping.main() 与 shipping_loop.py 复用。假定 page 已登录 ERP。\n59\t    wms_browser: 独立于 ERP 持久 context 的 browser，WMS 每店铺用它开干净 context 发货。\"\"\"\n60\t    failures = []\n61\t    if report:\n62\t        erp.open_order_ship(page)\n63\t        erp.report_counts(page)\n64\t\n65\t    for channel in rules.CHANNEL_ORDER:\n66\t        login = rules.channel_account_login(channel)\n67\t        account = account_by_login(login)\n68\t        if not account:\n69\t            log(f\"[渠道] {channel} 找不到对应账号 {login}，跳过\"); continue\n70\t        log(\"-\" * 50)\n71\t        log(f\"[渠道] 处理: {channel}  ->  {account['shop']}({login})\")\n72\t\n73\t        # ① ERP 该渠道物流下单\n74\t        r = erp.place_logistics_orders(page, channel_keyword=channel) or {}\n75\t        if r.get(\"fail_orders\"):\n76\t            failures.append({\"stage\": \"ERP物流下单\", \"channel\": channel,\n77\t                             \"account\": account[\"shop\"], \"orders\": r[\"fail_orders\"],\n78\t                             \"reason\": \"物流下单失败(多为所选仓库无库存)\"})\n79\t        placed = r.get(\"success\")\n80\t        if placed is None:\n81\t            placed = r.get(\"count\", 0) if not r.get(\"error\") else 0\n82\t        if not placed:\n83\t            log(f\"[渠道] {channel} 无成功下单订单，跳过 WMS 发货\")\n84\t            continue\n85\t\n86\t        # ② WMS 该渠道对应账号发货（用该渠道末段对应的单一快递方，失败即留存、不换）\n87\t        courier = rules.channel_courier(channel)\n88\t        res = wms.ship_shop(wms_browser, account, courier) or {}\n89\t        if res.get(\"left_orders\"):\n90\t            failures.append({\"stage\": \"WMS发货\", \"channel\": channel,\n91\t                             \"account\": account[\"shop\"], \"orders\": res[\"left_orders\"],\n92\t                             \"reason\": f\"用快递方 {courier} 发货失败（留存，不换快递方）\"})\n93\t        log(f\"[渠道] {channel} 闭环完成\")\n94\t\n95\t    # ---- 失败订单汇总留存 + 提醒 ----\n96\t    log(\"=\" * 60)\n97\t    if failures:\n98\t        log(\"[!] 本次失败订单留存（不自动处理，需人工跟进）：\")\n99\t        for x in failures:\n100\t            log(f\"   [{x['stage']}] 渠道={x.get('channel')} 账号={x.get('account','')} \"\n101\t                f\"原因={x['reason']}  订单={x['orders']}\")\n102\t        write_failures(failures)\n103\t    else:\n104\t        log(\"[OK] 本次无失败订单。\")\n105\t    return failures\n106\t\n107\t\n108\tdef main():\n109\t    start = core.log.begin_run(\"发货主流程\", max_per_run=config.MAX_ORDERS_PER_RUN,\n110\t                               channels=len(rules.CHANNEL_ORDER))\n111\t    log(f\"开始运行  RUN_ID={core.RUN_ID}  DRY_RUN={config.DRY_RUN}  MAX/次={config.MAX_ORDERS_PER_RUN}\")\n112\t    failures = []\n113\t    with sync_playwright() as p:\n114\t        ctx = core.open_context(p)\n115\t        page = ctx.pages[0] if ctx.pages else ctx.new_page()\n116\t\n117\t        if not core.ensure_erp(page):\n118\t            log(\"[ERP] 会话失效，无法按渠道下单。请先： python capture/erp_manual_login.py\")\n119\t            core.log.end_run(\"发货主流程\", start, result=\"ERP会话失效中止\")\n120\t            ctx.close(); return\n121\t\n122\t        # WMS 用独立 browser（每个店铺一个干净 context），与 ERP 的持久 context 分开，\n123\t        # 杜绝黑猫/金猫账号在同一 context 里串会话导致的漏发（2026-07-10 根因修复）。\n124\t        wms_browser = p.chromium.launch(headless=config.HEADLESS, args=[\"--no-sandbox\"])\n125\t        try:\n126\t            failures = run_pipeline(page, wms_browser, report=DO_ERP_REPORT) or []\n127\t\n128\t            if DO_ERP_CONFIRM_SHIP:\n129\t                log(\"[!] DO_ERP_CONFIRM_SHIP 已废弃（确认发货=物流下单，闭环里已做），忽略，避免重复下单。\")\n130\t            if DO_ERP_TRACKING:\n131\t                log(\"[跟踪号] 建议改用独立脚本 status_update_loop.py；此处按需一次性拉取。\")\n132\t                erp.update_order_status(page)\n133\t\n134\t            log(\"运行结束。\")\n135\t        finally:\n136\t            try:\n137\t                wms_browser.close()\n138\t            except Exception:\n139\t                pass\n140\t        time.sleep(2)\n141\t        ctx.close()\n142\t    core.log.end_run(\"发货主流程\", start, dry_run=config.DRY_RUN,\n143\t                     fail_groups=len(failures),\n144\t                     fail_orders=[o for x in failures for o in x.get(\"orders\", [])])\n145\t\n146\t\n147\tif __name__ == \"__main__\":\n148\t    main()\n149\t"}]},"uuid":"026bb83e-5944-49be-a0a9-81df795e147f","timestamp":"2026-07-10T03:50:37.896Z","toolUseResult":{"type":"text","file":{"filePath":"E:\\project\\海外仓\\automation\\run_shipping.py","content":"# -*- coding: utf-8 -*-\n\"\"\"\n主流程编排：按【渠道】逐个闭环。\n  遍历 rules.CHANNEL_ORDER（= 优先级顺序）：\n    ① ERP：待处理视图 -> 按「全部渠道」筛选=该渠道 -> 全选 -> 物流下单 -> 记录失败单\n    ② 该渠道有单才继续 -> WMS：登录该渠道对应账号(BLACKCAT->JMCAT / 昇新->JMSM)\n       -> 平台订单未发货 -> 按账号快递方优先级(RM->DPD->EH)逐轮：改快递方+批量发货，失败的换下个快递方再试\n    ③ 该渠道闭环完成，再做下一个渠道\n  失败订单（下单失败/试完所有快递方仍未发货）不自动挪渠道，统一留存 + 提醒。\n\n安全：config.DRY_RUN=True 时不真正点击 物流下单/批量发货，只走筛选与统计。\n用法：\n    1) 先手动登录一次 ERP： python capture/erp_manual_login.py\n    2) 空跑核对：          python run_shipping.py         （config.DRY_RUN=True）\n    3) 核对无误后改 config.DRY_RUN=False 再跑真实发货。\n\"\"\"\nimport os, time\nimport config, core, secrets, erp, wms, rules\nfrom core import log\nfrom playwright.sync_api import sync_playwright\n\n# ---- 环节开关 ----\nDO_ERP_REPORT = True          # 只读：ERP 各阶段数量\nDO_PER_CHANNEL = True         # 按渠道逐个闭环 ERP下单 -> WMS发货\n# 下面两个已并入其它实现，默认保持 False，勿开：\n#  · 「确认发货」= 「物流下单」同一步（业务确认 2026-07-08），已在按渠道闭环里执行，\n#    再单独跑会重复扣库存/提交平台 → DO_ERP_CONFIRM_SHIP 永久废弃。\n#  · 「获取跟踪单号」实际路径 = 三方仓>待更新>手动更新（erp.update_order_status），\n#    建议全部发完后用独立常驻脚本 status_update_loop.py 定时拉取，而非跟在发货后跑。\nDO_ERP_TRACKING = False\nDO_ERP_CONFIRM_SHIP = False   # 废弃：与物流下单同一步，勿开（会重复下单）\n\n\ndef account_by_login(login):\n    for a in secrets.WMS_ACCOUNTS:\n        if a[\"login\"] == login:\n            return a\n    return None\n\n\ndef write_failures(failures):\n    \"\"\"把失败订单留存到 logs/failures_YYYYMMDD.txt，便于人工跟进。\"\"\"\n    path = os.path.join(config.LOG_DIR, f\"failures_{time.strftime('%Y%m%d', time.localtime(time.time()))}.txt\")\n    try:\n        with open(path, \"a\", encoding=\"utf-8\") as f:\n            f.write(f\"\\n===== {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(time.time()))} =====\\n\")\n            for x in failures:\n                f.write(f\"[{x['stage']}] 渠道={x.get('channel')} 账号={x.get('account','')} 原因={x['reason']}\\n\")\n                for o in x[\"orders\"]:\n                    f.write(f\"    {o}\\n\")\n        log(f\"[留存] 失败订单已写入 {path}\")\n    except Exception as e:\n        log(f\"[留存] 写失败订单文件出错: {e}\")\n\n\ndef run_pipeline(page, wms_browser, report=True):\n    \"\"\"按渠道逐个闭环跑一遍（ERP物流下单->WMS发货）。返回失败订单留存 list。\n    供 run_shipping.main() 与 shipping_loop.py 复用。假定 page 已登录 ERP。\n    wms_browser: 独立于 ERP 持久 context 的 browser，WMS 每店铺用它开干净 context 发货。\"\"\"\n    failures = []\n    if report:\n        erp.open_order_ship(page)\n        erp.report_counts(page)\n\n    for channel in rules.CHANNEL_ORDER:\n        login = rules.channel_account_login(channel)\n        account = account_by_login(login)\n        if not account:\n            log(f\"[渠道] {channel} 找不到对应账号 {login}，跳过\"); continue\n        log(\"-\" * 50)\n        log(f\"[渠道] 处理: {channel}  ->  {account['shop']}({login})\")\n\n        # ① ERP 该渠道物流下单\n        r = erp.place_logistics_orders(page, channel_keyword=channel) or {}\n        if r.get(\"fail_orders\"):\n            failures.append({\"stage\": \"ERP物流下单\", \"channel\": channel,\n                             \"account\": account[\"shop\"], \"orders\": r[\"fail_orders\"],\n                             \"reason\": \"物流下单失败(多为所选仓库无库存)\"})\n        placed = r.get(\"success\")\n        if placed is None:\n            placed = r.get(\"count\", 0) if not r.get(\"error\") else 0\n        if not placed:\n            log(f\"[渠道] {channel} 无成功下单订单，跳过 WMS 发货\")\n            continue\n\n        # ② WMS 该渠道对应账号发货（用该渠道末段对应的单一快递方，失败即留存、不换）\n        courier = rules.channel_courier(channel)\n        res = wms.ship_shop(wms_browser, account, courier) or {}\n        if res.get(\"left_orders\"):\n            failures.append({\"stage\": \"WMS发货\", \"channel\": channel,\n                             \"account\": account[\"shop\"], \"orders\": res[\"left_orders\"],\n                             \"reason\": f\"用快递方 {courier} 发货失败（留存，不换快递方）\"})\n        log(f\"[渠道] {channel} 闭环完成\")\n\n    # ---- 失败订单汇总留存 + 提醒 ----\n    log(\"=\" * 60)\n    if failures:\n        log(\"[!] 本次失败订单留存（不自动处理，需人工跟进）：\")\n        for x in failures:\n            log(f\"   [{x['stage']}] 渠道={x.get('channel')} 账号={x.get('account','')} \"\n                f\"原因={x['reason']}  订单={x['orders']}\")\n        write_failures(failures)\n    else:\n        log(\"[OK] 本次无失败订单。\")\n    return failures\n\n\ndef main():\n    start = core.log.begin_run(\"发货主流程\", max_per_run=config.MAX_ORDERS_PER_RUN,\n                               channels=len(rules.CHANNEL_ORDER))\n    log(f\"开始运行  RUN_ID={core.RUN_ID}  DRY_RUN={config.DRY_RUN}  MAX/次={config.MAX_ORDERS_PER_RUN}\")\n    failures = []\n    with sync_playwright() as p:\n        ctx = core.open_context(p)\n        page = ctx.pages[0] if ctx.pages else ctx.new_page()\n\n        if not core.ensure_erp(page):\n            log(\"[ERP] 会话失效，无法按渠道下单。请先： python capture/erp_manual_login.py\")\n            core.log.end_run(\"发货主流程\", start, result=\"ERP会话失效中止\")\n            ctx.close(); return\n\n        # WMS 用独立 browser（每个店铺一个干净 context），与 ERP 的持久 context 分开，\n        # 杜绝黑猫/金猫账号在同一 context 里串会话导致的漏发（2026-07-10 根因修复）。\n        wms_browser = p.chromium.launch(headless=config.HEADLESS, args=[\"--no-sandbox\"])\n        try:\n            failures = run_pipeline(page, wms_browser, report=DO_ERP_REPORT) or []\n\n            if DO_ERP_CONFIRM_SHIP:\n                log(\"[!] DO_ERP_CONFIRM_SHIP 已废弃（确认发货=物流下单，闭环里已做），忽略，避免重复下单。\")\n            if DO_ERP_TRACKING:\n                log(\"[跟踪号] 建议改用独立脚本 status_update_loop.py；此处按需一次性拉取。\")\n                erp.update_order_status(page)\n\n            log(\"运行结束。\")\n        finally:\n            try:\n                wms_browser.close()\n            except Exception:\n                pass\n        time.sleep(2)\n        ctx.close()\n    core.log.end_run(\"发货主流程\", start, dry_run=config.DRY_RUN,\n                     fail_groups=len(failures),\n                     fail_orders=[o for x in failures for o in x.get(\"orders\", [])])\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":149,"startLine":1,"totalLines":149}},"sourceToolAssistantUUID":"2bca4ad0-58fe-4aec-9cd4-ecc4ed67945e","userType":"external","entrypoint":"cli","cwd":"E:\\project\\海外仓","sessionId":"f1228b76-7b7b-4dc7-a875-56738d0166fd","version":"2.1.201","gitBranch":"HEAD"}
