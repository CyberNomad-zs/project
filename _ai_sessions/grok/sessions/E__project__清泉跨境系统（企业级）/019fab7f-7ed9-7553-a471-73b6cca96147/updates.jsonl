aign|广告|活动|product|品名|计划/.test(t) && t !== '名称' && t !== 'name') {\n            continue;\n          }\n        }\n        return field;\n      }\n    }\n    return null;\n  }","new_string":"  const HEADER_ALIASES = {\n    planStatus: ['开/关', '开关', '投放开关', 'enable', 'enabled', 'switch', 'on/off', 'toggle'],\n    // P1: 比 spend/roi 更具体的列优先匹配\n    targetRoi: ['目标 roi', '目标roi', '目标 roas', '目标roas', 'target roi', 'target roas'],\n    avgOrderCost: [\n      '平均下单成本',\n      '平均下单',\n      'cost per order',\n      'cost per purchase',\n      'avg order cost',\n      'cpa'\n    ],\n    netCost: ['净成本', 'net cost', 'net spend'],\n    dailyBudget: ['当前预算', '日预算', '预算', 'daily budget', 'budget'],\n    deliveryStatus: ['状态', '投放状态', '计划状态', 'status', 'delivery status'],\n    campaign: [\n      '品名',\n      '广告计划名称',\n      '广告系列',\n      '广告系列名称',\n      '系列名称',\n      'campaign',\n      'campaign name',\n      'product',\n      '名称'\n    ],\n    spend: ['广告花费', '广告成本', '花费', '成本', '消耗', 'cost', 'spend', 'ad spend'],\n    orders: [\n      '销量',\n      '订单',\n      'sku 订单',\n      'sku订单',\n      'sku 订单数',\n      'sku订单数',\n      'orders',\n      'units',\n      'units sold'\n    ],\n    roi: ['roi', 'roas', '投资回报率', '投资回报', '回报率'],\n    revenue: ['销售额', '总收入', '销售收入', '收入', 'gmv', 'revenue', 'gross revenue']\n  };\n\n  const MONEY_FIELDS = {\n    spend: 1,\n    revenue: 1,\n    dailyBudget: 1,\n    netCost: 1,\n    avgOrderCost: 1\n  };\n  const NUM_FIELDS = {\n    spend: 1,\n    revenue: 1,\n    orders: 1,\n    roi: 1,\n    dailyBudget: 1,\n    targetRoi: 1,\n    netCost: 1,\n    avgOrderCost: 1\n  };\n  const TEXT_FIELDS = { campaign: 1, deliveryStatus: 1 };\n\n  function matchHeaderField(headerText) {\n    const t = cleanText(headerText).toLowerCase();\n    if (!t) return null;\n    // 具体列优先，避免「成本」吃掉「净成本/平均下单成本」，「ROI」吃掉「目标 ROI」\n    const order = [\n      'planStatus',\n      'targetRoi',\n      'avgOrderCost',\n      'netCost',\n      'dailyBudget',\n      'deliveryStatus',\n      'roi',\n      'spend',\n      'orders',\n      'revenue',\n      'campaign'\n    ];\n    for (const field of order) {\n      for (const a of HEADER_ALIASES[field]) {\n        const al = a.toLowerCase();\n        if (!(t === al || t.includes(al) || (al.length >= 2 && al.includes(t)))) continue;\n        if (field === 'spend') {\n          if (/平均下单|cost per|per order|\\bcpc\\b|\\bcpa\\b|净成本|net cost|预算|budget/.test(t)) {\n            continue;\n          }\n        }\n        if (field === 'roi') {\n          if (/目标|保护|保障|target|protect|资格/.test(t)) continue;\n        }\n        if (field === 'dailyBudget') {\n          if (/创意|加热|creative|spend|花费|成本|cost|消耗/.test(t) && !/预算|budget/.test(t)) {\n            continue;\n          }\n        }\n        if (field === 'deliveryStatus') {\n          // 避免把开关列当状态；「已生效」在数据列\n          if (/开关|switch|toggle|开\\/关/.test(t)) continue;\n          if (t === '状态' || t === 'status' || /投放状态|计划状态|delivery/.test(t)) {\n            return field;\n          }\n          continue;\n        }\n        if (field === 'planStatus') {\n          if (/投放状态|计划状态|delivery|operation status/.test(t) && !/开关|switch|开\\/关/.test(t)) {\n            // 文案型状态走 deliveryStatus\n            continue;\n          }\n          if (t === al || t === '开关' || t === '开/关' || t === 'switch' || t === 'enable' || t === 'enabled') {\n            return field;\n          }\n          if (/开关|switch|toggle|on\\/off|开\\/关/.test(t) && t.length <= 12) return field;\n          continue;\n        }\n        if (field === 'campaign' && (al === '名称' || al === 'name')) {\n          if (!/系列|campaign|广告|活动|product|品名|计划/.test(t) && t !== '名称' && t !== 'name') {\n            continue;\n          }\n        }\n        return field;\n      }\n    }\n    return null;\n  }"},"_meta":{"x.ai/tool":{"version":1,"name":"search_replace","kind":"edit","namespace":"grok_build","label":"Edit","read_only":false}}},"_meta":{"totalTokens":178367,"eventId":"019fab7f-7ed9-7553-a471