@cli.command("init-shop-tables")
@click.option("--shops", default="", help="逗号分隔规范店名")
@click.option("--dry-run", is_flag=True)
@click.pass_context
def init_shop_tables_cmd(
    ctx: click.Context, shops: str, dry_run: bool
) -> None:
    """创建每店业务子表并写出 data/feishu_shop_tables.json。"""
    import subprocess

    cmd = [sys.executable, str(ROOT / "scripts" / "init_shop_tables.py")]
    if shops:
        cmd.extend(["--shops", shops])
    if dry_run:
        cmd.append("--dry-run")
    raise SystemExit(subprocess.call(cmd))


@cli.command("dashboard")
@click.option("--date", "biz_date", default=None, help="业务日，默认最新")
@click.option("--open", "open_browser", is_flag=True, help="生成后打开浏览器")
@click.option("--trend-days", default=7, show_default=True, type=int)
@click.pass_context
def dashboard_cmd(
    ctx: click.Context,
    biz_date: str | None,
    open_browser: bool,
    trend_days: int,
) -> None:
    """生成集团总览 + 各店静态仪表盘（data/dashboard）。"""
    from app.dashboard.data import build_group_payload, build_shop_payload, latest_biz_date
    from app.dashboard.render import write_dashboard_site
    from app.sync.shops import list_canonical_shops_from_db

    db: Database = ctx.obj["db"]
    settings = ctx.obj["settings"]
    day = biz_date or latest_biz_date(db)
    if not day:
        click.echo("ERROR: 无 asin_daily 数据", err=True)
        raise SystemExit(2)
    out_dir = Path(settings.data_dir) / "dashboard"
    group = build_group_payload(db, biz_date=day, trend_days=trend_days)
    shops = list_canonical_shops_from_db()
    payloads = [
        build_shop_payload(db, s, biz_date=day, trend_days=trend_days) for s in shops
    ]
    write_dashboard_site(out_dir, group, payloads)
    index = out_dir / "index.html"
    click.echo({"biz_date": day, "out": str(out_dir), "shops": shops, "index": str(index)})
    if open_browser:
        import webbrowser

        webbrowser.open(index.resolve().as_uri())


@cli.command("backfill-shop-tables")
@click.option("--date", "biz_date", required=True, help="业务日期 YYYY-MM-DD")
@click.option("--no-asin", is_flag=True, help="不推 ASIN 日数据")
@click.option("--no-tasks", is_flag=True, help="不推任务/动作")
@click.option("--no-summary", is_flag=True, help="不写每日汇总")
@click.pass_context
def backfill_shop_tables_cmd(
    ctx: click.Context,
    biz_date: str,
    no_asin: bool,
    no_tasks: bool,
    no_summary: bool,
) -> None:
    """从 SQLite 按日重推母表+子表（上线补历史）。"""
    from app.notify.summary_table import write_summary_to_feishu
    from app.sync.writer import (
        write_asin_to_feishu,
        write_tasks_to_feishu,
    )

    db: Database = ctx.obj["db"]
    settings = ctx.obj["settings"]
    out: dict = {"biz_date": biz_date}

    if not no_asin:
        rows = db.list_asin_daily(biz_date)
        out["asin"] = write_asin_to_feishu(rows, settings=settings)
        out["asin_source_rows"] = len(rows)

    if not no_tasks:
        tasks = [
            t
            for t in db.list_tasks(biz_date=biz_date)
            if t.get("status") not in ("closed", "resolved")
            and t.get("level") in ("red", "orange")
        ]
        out["tasks"] = write_tasks_to_feishu(tasks, settings=settings)
        out["task_source"] = len(tasks)

    if not no_summary:
        out["summary"] = write_summary_to_feishu(
            db, biz_date, settings=settings
        )

    click.echo(out)


