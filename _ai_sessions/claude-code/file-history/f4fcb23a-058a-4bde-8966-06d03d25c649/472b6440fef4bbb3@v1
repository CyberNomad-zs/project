// Service worker：接收接口数据 → 按【店铺名】分别解析/对比/告警。
// 多店铺：同一账号下有多个店(HomeCove/Twilight Cove/Agnis)，切到哪个店就记哪个店，各自独立快照与告警。
// 数据只存本机 chrome.storage.local，不上传任何服务器。

const GOODS_URL = 'https://agentseller.temu.com/goods/list';
const DEFAULT_CONFIG = { webhook: '', intervalMinutes: 15, enabled: true, storeName: '' };

// ---------------- 解析 ----------------
function parseCountStatus(body) {
  try {
    const j = JSON.parse(body);
    const list = j && j.result && j.result.skcTopStatusCountList;
    if (!Array.isArray(list)) return null;
    const pick = (s) => {
      const x = list.find((e) => e && e.skcTopStatus === s);
      return x && typeof x.skcTotal === 'number' ? x.skcTotal : null;
    };
    return { onSale: pick(100), unpublished: pick(0), removed: pick(200), deleted: pick(300) };
  } catch (e) { return null; }
}
function parsePageQuery(body) {
  try {
    const j = JSON.parse(body);
    const r = j && j.result;
    if (!r) return null;
    return { total: r.total };
  } catch (e) { return null; }
}

// ---------------- 存取 ----------------
async function getConfig() {
  const { config } = await chrome.storage.local.get('config');
  return Object.assign({}, DEFAULT_CONFIG, config || {});
}
async function getStores() {
  const { stores } = await chrome.storage.local.get('stores');
  return stores || {};
}
async function saveStores(stores) {
  await chrome.storage.local.set({ stores });
}
// 更新某店的最新读数
async function updateStoreLatest(name, patch) {
  const stores = await getStores();
  const s = stores[name] || { latest: {}, snapshot: {} };
  s.latest = Object.assign({}, s.latest, patch, { ts: Date.now() });
  stores[name] = s;
  await saveStores(stores);
  return s;
}

// ---------------- 飞书 ----------------
async function sendFeishu(webhook, title, lines) {
  if (!webhook) return { ok: false, msg: '未配置飞书 webhook' };
  const card = {
    msg_type: 'interactive',
    card: {
      header: { title: { tag: 'plain_text', content: title }, template: 'red' },
      elements: [{ tag: 'div', text: { tag: 'lark_md', content: lines.join('\n') } }],
    },
  };
  try {
    const resp = await fetch(webhook, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(card) });
    const data = await resp.json().catch(() => ({}));
    const ok = resp.ok && (data.code === 0 || data.StatusCode === 0 || data.code === undefined);
    return { ok, msg: ok ? '已发送' : ('飞书返回：' + JSON.stringify(data)) };
  } catch (e) {
    return { ok: false, msg: '发送失败：' + (e && e.message) };
  }
}

// ---------------- 商品明细 → 带链接的告警行 ----------------
// 后台商品操作都是弹窗、无深链，唯一稳定可点的是编辑页（实测格式：SPU ID 即 productId）。
function editLink(productId) {
  return 'https://agentseller.temu.com/goods/edit?from=productList&productId=' + productId;
}
// items：当前页可见的限流/下降商品（content.js 扫描 DOM 得到）；total：chip 全量计数。
function itemLines(items, total) {
  const lines = [];
  if (Array.isArray(items) && items.length) {
    for (const it of items) {
      const nm = String(it.name || '商品').replace(/[[\]]/g, '').slice(0, 30);
      lines.push('• [' + nm + '](' + editLink(it.productId) + ')  SKC ' + (it.skc || '-'));
    }
    if (typeof total === 'number' && total > items.length) {
      lines.push('_（本页可见 ' + items.length + ' 条，共 ' + total + ' 条，其余在其它页；点「商品流量待关注」筛选可看全）_');
    }
  } else if (typeof total === 'number' && total > 0) {
    lines.push('_（当前页未显示具体商品，共 ' + total + ' 条；打开「商品流量待关注」筛选可查看）_');
  }
  return lines;
}

// 让 content.js 主动点「商品流量待关注」筛选，捞出这几条被限流的具体商品（productId+name+skc）
async function scanWatchViaTab() {
  const tab = await getGoodsTab();
  if (!tab) return null;
  return await sendTabRetry(tab.id, { cmd: 'scanWatchList' }, 3);
}

// ---------------- 对比 & 告警（按店） ----------------
// 按店串行：同一店的多条读数消息（切店时常一秒内来两条）排队逐个处理，
// 避免"都读到旧快照各报一次"的竞态导致同一事件重复告警。
const alertChains = {};
function diffAndAlert(name) {
  const prev = alertChains[name] || Promise.resolve();
  const next = prev.then(() => _diffAndAlert(name)).catch(() => {});
  alertChains[name] = next;
  return next;
}

async function _diffAndAlert(name) {
  const cfg = await getConfig();
  if (!cfg.enabled) return;
  const stores = await getStores();
  const s = stores[name];
  if (!s) return;
  const latest = s.latest || {};
  const snap = s.snapshot || {};
  const events = [];

  // 在售下降不在这里报「只报数字」——改由 diffOnSale 按在售清单 diff 报「具体哪条下架」（带链接），避免同一事件报两次。
  if (typeof latest.trafficWatch === 'number' && typeof snap.trafficWatch === 'number' && latest.trafficWatch > snap.trafficWatch) {
    events.push(`⚠️ 商品流量待关注增加：${snap.trafficWatch} → ${latest.trafficWatch}`);
    // 被动扫到的 watchItems 往往为空（限流商品散落在其它页）→ 主动点筛选把这几条捞出来，带链接点名。
    let items = Array.isArray(latest.watchItems) ? latest.watchItems : [];
    let total = latest.trafficWatch;
    const scan = await scanWatchViaTab();
    if (scan && scan.applied && Array.isArray(scan.items) && scan.items.length) {
      items = scan.items;
      if (typeof scan.total === 'number') total = scan.total;
    }
    events.push(...itemLines(items, total));
  }
  // 「商品流量近期有下降」商品数增加（相对已建立的基准，首次不报）
  if (typeof latest.trafficDecline === 'number' && typeof snap.trafficDecline === 'number' && latest.trafficDecline > snap.trafficDecline) {
    events.push(`🔴 商品流量近期有下降增加：${snap.trafficDecline} → ${latest.trafficDecline}（本页可见）`);
    events.push(...itemLines(latest.declineItems, null));
  }

  if (events.length > 0) {
    const lines = [`**🏬 ${name}**`, ...events, '', `_检查时间：${new Date().toLocaleString('zh-CN')}_`];
    const r = await sendFeishu(cfg.webhook, '🔔 Temu 店铺监测告警', lines);
    await chrome.storage.local.set({ lastAlert: { ts: Date.now(), ok: r.ok, msg: r.msg, store: name, lines } });
  }

  // 合并式更新该店基准快照（只覆盖本次拿到的数值），幂等只报一次。
  // 重新取一次 store：主动扫筛选期间 content 可能又上报过 latest，避免用旧闭包覆盖。
  const stores2 = await getStores();
  const s2 = stores2[name] || s;
  const L2 = s2.latest || latest;
  const newSnap = Object.assign({}, s2.snapshot || snap);
  if (typeof L2.onSale === 'number') newSnap.onSale = L2.onSale;
  if (typeof L2.total === 'number') newSnap.total = L2.total;
  if (typeof L2.trafficWatch === 'number') newSnap.trafficWatch = L2.trafficWatch;
  if (typeof L2.trafficDecline === 'number') newSnap.trafficDecline = L2.trafficDecline;
  newSnap.ts = Date.now();
  s2.snapshot = newSnap;
  stores2[name] = s2;
  await saveStores(stores2);
}

// 在售清单 diff：找出「上一轮在售、这一轮不在」的商品 = 下架/移出在售，带商品名+编辑链接告警。
// items 为 content.js 扫「在售中」tab 得到的当前在售商品(productId+name+skc)。返回下架数量(供日志)。
async function diffOnSale(name, items) {
  if (!Array.isArray(items) || !items.length) return 0; // 空 = 扫描失败或真 0，稳妥起见不动基准、不报
  const cfg = await getConfig();
  const stores = await getStores();
  const s = stores[name] || { latest: {}, snapshot: {} };
  // 防残缺扫描误判：已知在售数(countStatus)时，扫到的必须不少于它，否则视为没扫全 → 跳过
  const known = s.latest && typeof s.latest.onSale === 'number' ? s.latest.onSale : null;
  if (known != null && items.length < known) return 0;
  const newMap = {};
  for (const it of items) if (it && it.productId) newMap[it.productId] = { name: it.name || '', skc: it.skc || '' };
  const prevMap = s.snapshot && s.snapshot.onSaleIds;
  let delistedCount = 0;
  if (prevMap && cfg.enabled) { // 首次无基准 → 只记录不报
    const delisted = Object.keys(prevMap).filter((pid) => !(pid in newMap));
    delistedCount = delisted.length;
    if (delisted.length) {
      const its = delisted.map((pid) => ({ productId: pid, name: prevMap[pid].name, skc: prevMap[pid].skc }));
      const lines = [`**🏬 ${name}**`, `📉 在售商品下架 ${delisted.length} 个（在售 ${Object.keys(prevMap).length} → ${items.length}）:`,
        ...itemLines(its, null), '', `_检查时间：${new Date().toLocaleString('zh-CN')}_`];
      const r = await sendFeishu(cfg.webhook, '🔔 Temu 店铺监测告警', lines);
      await chrome.storage.local.set({ lastAlert: { ts: Date.now(), ok: r.ok, msg: r.msg, store: name, lines } });
    }
  }
  s.snapshot = Object.assign({}, s.snapshot, { onSaleIds: newMap, onSaleIdsTs: Date.now() });
  stores[name] = s;
  await saveStores(stores);
  return delistedCount;
}

// 解析店铺名：优先用页面读到的店名；读不到则退回配置里手填的，再退回“当前店铺”
async function resolveStore(msgStore) {
  if (msgStore && String(msgStore).trim()) return String(msgStore).trim();
  const cfg = await getConfig();
  return (cfg.storeName && cfg.storeName.trim()) || '当前店铺';
}

// ---------------- 消息处理 ----------------
chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
  (async () => {
    if (msg.type === 'capture') {
      const name = await resolveStore(msg.store);
      if (msg.kind === 'countStatus') {
        const p = parseCountStatus(msg.body);
        if (p && p.onSale != null) {
          await updateStoreLatest(name, { onSale: p.onSale, unpublished: p.unpublished, removed: p.removed, deleted: p.deleted });
          await diffAndAlert(name);
        }
      } else if (msg.kind === 'pageQuery') {
        const p = parsePageQuery(msg.body);
        if (p) await updateStoreLatest(name, { total: p.total });
      }
      sendResponse({ ok: true });
      return;
    }
    if (msg.type === 'chipStats') {
      const patch = {};
      if (typeof msg.trafficWatch === 'number') patch.trafficWatch = msg.trafficWatch;
      if (typeof msg.trafficDecline === 'number') patch.trafficDecline = msg.trafficDecline;
      if (Array.isArray(msg.watchItems)) patch.watchItems = msg.watchItems;
      if (Array.isArray(msg.declineItems)) patch.declineItems = msg.declineItems;
      if (Object.keys(patch).length) {
        const name = await resolveStore(msg.store);
        await updateStoreLatest(name, patch);
        await diffAndAlert(name);
      }
      sendResponse({ ok: true });
      return;
    }
    if (msg.type === 'getStatus') {
      sendResponse({ bgVersion: 'v4-限流点名', config: await getConfig(), stores: await getStores(), ...(await chrome.storage.local.get(['lastAlert', 'lastCycle'])) });
      return;
    }
    if (msg.type === 'addStore') {
      const name = (msg.name || '').trim();
      if (!name) { sendResponse({ ok: false, msg: '店铺名不能为空' }); return; }
      const stores = await getStores();
      if (stores[name]) { sendResponse({ ok: false, msg: '「' + name + '」已存在' }); return; }
      stores[name] = { latest: {}, snapshot: {} };
      await saveStores(stores);
      sendResponse({ ok: true, msg: '已添加「' + name + '」，下次轮巡将尝试切到该店抓数' });
      return;
    }
    if (msg.type === 'deleteStore') {
      const name = (msg.name || '').trim();
      const stores = await getStores();
      if (!stores[name]) { sendResponse({ ok: false, msg: '「' + name + '」不存在' }); return; }
      delete stores[name];
      await saveStores(stores);
      sendResponse({ ok: true, msg: '已删除「' + name + '」' });
      return;
    }
    if (msg.type === 'checkNow') {
      sendResponse(await pollNow());
      return;
    }
    if (msg.type === 'cycleNow') {
      sendResponse(await cycleStores('manual'));
      return;
    }
    if (msg.type === 'testFeishu') {
      const cfg = await getConfig();
      const r = await sendFeishu(cfg.webhook, '✅ Temu 监测测试', ['这是一条测试消息，收到说明飞书配置正常。', '', `_${new Date().toLocaleString('zh-CN')}_`]);
      sendResponse(r);
      return;
    }
  })();
  return true;
});

// ---------------- 自动轮巡（切遍每个店抓数，再切回原店；仅空闲时触发） ----------------
const IDLE_SECONDS = 240; // 无操作 4 分钟视为空闲
let cycling = false;

async function getGoodsTab() {
  const tabs = await chrome.tabs.query({ url: 'https://agentseller.temu.com/*' });
  return tabs.find((t) => /goods\/list/.test(t.url || '')) || tabs[0] || null;
}
function sendTab(tabId, cmd) {
  return new Promise((resolve) => {
    try {
      chrome.tabs.sendMessage(tabId, cmd, (resp) => {
        if (chrome.runtime.lastError) resolve(null); else resolve(resp);
      });
    } catch (e) { resolve(null); }
  });
}
async function sendTabRetry(tabId, cmd, tries) {
  for (let i = 0; i < (tries || 8); i++) {
    const r = await sendTab(tabId, cmd);
    if (r) return r;
    await new Promise((res) => setTimeout(res, 1000)); // 页面重载后 content 未就绪，重试
  }
  return null;
}
function sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }
// 等某店在切换后被重新抓到（latest.ts 比切换前更新、且有 onSale）
async function waitForStoreCapture(name, sinceTs, timeout) {
  const t0 = Date.now();
  while (Date.now() - t0 < (timeout || 25000)) {
    const stores = await getStores();
    const L = stores[name] && stores[name].latest;
    if (L && typeof L.onSale === 'number' && (L.ts || 0) > sinceTs) return true;
    await sleep(1500);
  }
  return false;
}

async function cycleStores(reason) {
  if (cycling) return { ok: false, msg: '轮巡进行中' };
  cycling = true;
  const log = [];
  try {
    const tab = await getGoodsTab();
    if (!tab) return { ok: false, msg: '没有打开的 Temu 商品页' };
    const cur = await sendTabRetry(tab.id, { cmd: 'ping' }, 5);
    const original = cur && cur.store;
    log.push('当前店：' + (original || '未知'));

    // 店铺清单：优先用“已知店”（之前逛各店时按顶栏店名记下的，干净准确）；
    // 不足 2 个才去弹窗探测（探测会混入页面杂项英文，仅作兜底）。
    const known = Object.keys(await getStores()).filter((n) => n && n !== '当前店铺');
    let names;
    if (known.length >= 2) {
      names = known;
      log.push('店铺(已知)：' + names.join(', '));
    } else {
      const listed = await sendTabRetry(tab.id, { cmd: 'listStores' }, 5);
      names = [...new Set([...((listed && listed.names) || []), ...known])].filter(Boolean);
      log.push('店铺(探测)：' + names.join(', '));
    }
    if (names.length === 0) return { ok: false, msg: '没识别到店铺清单' };

    for (const name of names) {
      if (name === original) continue; // 原店最后再确认；先切别的
      const since = Date.now();
      const r = await sendTabRetry(tab.id, { cmd: 'switchTo', target: name }, 5);
      if (!r || !r.ok) { log.push('切到 ' + name + ' 失败：' + (r && r.msg)); continue; }
      const got = await waitForStoreCapture(name, since, 25000);
      log.push((got ? '✓ ' : '✗ ') + name);
      // 扫在售清单 → diff 出下架商品（带链接告警）
      if (got) {
        const os = await sendTabRetry(tab.id, { cmd: 'scanOnSale' }, 3);
        if (os && Array.isArray(os.items)) { const d = await diffOnSale(name, os.items); if (d) log.push('  ↳下架' + d + '个'); }
      }
    }
    // 切回原店
    if (original) {
      const since = Date.now();
      await sendTabRetry(tab.id, { cmd: 'switchTo', target: original }, 5);
      const gotBack = await waitForStoreCapture(original, since, 25000);
      if (gotBack) {
        const os = await sendTabRetry(tab.id, { cmd: 'scanOnSale' }, 3);
        if (os && Array.isArray(os.items)) { const d = await diffOnSale(original, os.items); if (d) log.push('  ↳' + original + '下架' + d + '个'); }
      }
      log.push('已切回 ' + original);
    }
    const summary = log.join(' | ');
    await chrome.storage.local.set({ lastCycle: { ts: Date.now(), reason, summary } });
    return { ok: true, msg: summary };
  } finally { cycling = false; }
}

async function pollNow() {
  const tab = await getGoodsTab();
  if (!tab) return { ok: false, msg: '未找到打开的 Temu 后台标签页，请先登录并打开商品列表页' };
  if (/goods\/list/.test(tab.url || '')) { await chrome.tabs.reload(tab.id, { bypassCache: false }); return { ok: true, msg: '已刷新后台商品页' }; }
  await chrome.tabs.update(tab.id, { url: GOODS_URL });
  return { ok: true, msg: '已导航到商品列表页' };
}

// 定时：空闲则轮巡所有店，否则不打扰（靠随看随记覆盖当前店）
chrome.alarms.onAlarm.addListener((a) => {
  if (a.name !== 'poll') return;
  chrome.idle.queryState(IDLE_SECONDS, (state) => {
    if (state === 'idle' || state === 'locked') cycleStores('idle');
  });
});

async function setupAlarm() {
  await chrome.storage.local.remove('trafficSample'); // 清早期诊断残留
  const cfg = await getConfig();
  await chrome.alarms.clear('poll');
  chrome.alarms.create('poll', { periodInMinutes: Math.max(1, cfg.intervalMinutes || 15) });
}
chrome.runtime.onInstalled.addListener(setupAlarm);
chrome.runtime.onStartup.addListener(setupAlarm);
chrome.storage.onChanged.addListener((changes, area) => { if (area === 'local' && changes.config) setupAlarm(); });
