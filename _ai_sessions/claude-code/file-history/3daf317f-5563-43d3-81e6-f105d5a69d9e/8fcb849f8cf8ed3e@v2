#!/usr/bin/env bash
set -euo pipefail
ENV=/opt/qingquan/.env
PATCH=/tmp/feishu_env_patch.env
test -f "$ENV" || { echo "missing $ENV"; exit 1; }
test -f "$PATCH" || { echo "missing $PATCH"; exit 1; }
cp -a "$ENV" "/opt/qingquan/.env.bak.$(date +%Y%m%d%H%M%S)"
upsert() {
  local key="$1" val="$2"
  if grep -qE "^${key}=" "$ENV"; then
    sed -i -E "s|^${key}=.*|${key}=${val}|" "$ENV"
    echo "updated $key"
  else
    printf '\n%s=%s\n' "$key" "$val" >> "$ENV"
    echo "appended $key"
  fi
}
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && continue
  key="${line%%=*}"
  val="${line#*=}"
  upsert "$key" "$val"
done < "$PATCH"
rm -f "$PATCH"
echo "== FEISHU masked =="
grep -E '^FEISHU_' "$ENV" | sed -E 's/(SECRET|TOKEN)=.+/\1=***/'
echo "== code check =="
test -f /opt/qingquan/backend/app/jobs/tk_feishu_sync.py && echo tk_feishu_sync=OK
grep -c 'tk_ads_campaign' /opt/qingquan/backend/app/api/export_feishu.py || true
grep -c 'feishu_bitable_table_tk' /opt/qingquan/backend/app/config.py || true
grep -c 'tk_shop_daily_to_fields' /opt/qingquan/backend/app/adapters/feishu/bitable.py || true
