gs:    $(Join-Path $Root 'data\\logs')\"\nWrite-Host \"  note:    新异常按 task_id 及时通知负责人；群摘要按业务日去重\"\nWrite-Host \"test now:  Start-ScheduledTask -TaskName '$TaskName'\"\n"}
