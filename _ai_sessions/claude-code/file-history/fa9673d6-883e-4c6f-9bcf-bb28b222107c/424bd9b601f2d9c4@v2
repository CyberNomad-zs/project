// remain: 应发剩余分钟(负=已超时, null=已发货); a=异常代码
const ORDERS=[
  {id:"PO-8842…21",pf:"Temu",sku:"无线蓝牙耳机·黑",qty:2,buyer:"DE·尾号8821",remain:-42,p:"待发货",e:"已推仓",w:"待出库",wh:"德国仓",track:null,a:["LATE","STUCK"]},
