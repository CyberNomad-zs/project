<style>
  :root{
    --ground:#EBEDEF; --surface:#FBFCFC; --surface-2:#F2F4F5;
    --ink:#1A1D24; --ink-2:#535962; --ink-3:#868D97;
    --line:#D9DCE1; --line-2:#E7E9ED;
    --gold:#B0800C; --gold-bright:#CE9718;
    --heat-rgb:183,131,10;
    --good:#2E7D6B; --risk:#B45540;
    --medal-1:#B98A15; --medal-2:#8B929B; --medal-3:#A9743C;
    --shadow:0 1px 2px rgba(20,24,33,.04),0 8px 24px rgba(20,24,33,.06);
    --font-sans:"Microsoft YaHei","PingFang SC","Hiragino Sans GB","Noto Sans CJK SC","Source Han Sans SC",-apple-system,"Segoe UI",Roboto,sans-serif;
    --font-mono:"Cascadia Code","JetBrains Mono","SF Mono","Consolas",ui-monospace,Menlo,monospace;
    --maxw:1120px;
  }
  @media (prefers-color-scheme:dark){
    :root{
      --ground:#101217; --surface:#181B21; --surface-2:#1F232B;
      --ink:#ECEEF1; --ink-2:#A3A9B4; --ink-3:#6C727C;
      --line:#2A2E37; --line-2:#22262E;
      --gold:#E4B141; --gold-bright:#F1C55E;
      --heat-rgb:228,177,65;
      --good:#5FB39C; --risk:#D98066;
      --medal-1:#E4B141; --medal-2:#9AA0A8; --medal-3:#BE8A54;
      --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 26px rgba(0,0,0,.34);
    }
  }
  :root[data-theme="light"]{
    --ground:#EBEDEF; --surface:#FBFCFC; --surface-2:#F2F4F5;
    --ink:#1A1D24; --ink-2:#535962; --ink-3:#868D97;
    --line:#D9DCE1; --line-2:#E7E9ED;
    --gold:#B0800C; --gold-bright:#CE9718; --heat-rgb:183,131,10;
    --good:#2E7D6B; --risk:#B45540;
    --medal-1:#B98A15; --medal-2:#8B929B; --medal-3:#A9743C;
    --shadow:0 1px 2px rgba(20,24,33,.04),0 8px 24px rgba(20,24,33,.06);
  }
  :root[data-theme="dark"]{
    --ground:#101217; --surface:#181B21; --surface-2:#1F232B;
    --ink:#ECEEF1; --ink-2:#A3A9B4; --ink-3:#6C727C;
    --line:#2A2E37; --line-2:#22262E;
    --gold:#E4B141; --gold-bright:#F1C55E; --heat-rgb:228,177,65;
    --good:#5FB39C; --risk:#D98066;
    --medal-1:#E4B141; --medal-2:#9AA0A8; --medal-3:#BE8A54;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 26px rgba(0,0,0,.34);
  }

  *{box-sizing:border-box;}
  body{
    margin:0;background:var(--ground);color:var(--ink);
    font-family:var(--font-sans);line-height:1.7;
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
    font-size:16px;
  }
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 clamp(18px,4vw,40px);}
  section{padding-block:clamp(40px,6vw,72px);}
  h1,h2,h3{margin:0;text-wrap:balance;line-height:1.22;font-weight:800;letter-spacing:-.01em;}
  p{margin:0;}
  a{color:var(--gold);}
  ::selection{background:rgba(var(--heat-rgb),.28);}
  :focus-visible{outline:2px solid var(--gold-bright);outline-offset:2px;border-radius:3px;}

  .mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums;}
  .eyebrow{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:600;}
  .num{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-feature-settings:"tnum";}

  /* ---------- HERO ---------- */
  .hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line);background:var(--surface);}
  .hero::before{
    content:"";position:absolute;inset:0;pointer-events:none;opacity:.55;
    background-image:
      linear-gradient(var(--line-2) 1px,transparent 1px),
      linear-gradient(90deg,var(--line-2) 1px,transparent 1px);
    background-size:34px 34px;
    -webkit-mask-image:radial-gradient(120% 90% at 82% 0%,#000 0%,transparent 62%);
    mask-image:radial-gradient(120% 90% at 82% 0%,#000 0%,transparent 62%);
  }
  .hero .wrap{position:relative;padding-block:clamp(44px,7vw,84px);}
  .hero-top{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;margin-bottom:28px;}
  .badge{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-2);border:1px solid var(--line);border-radius:999px;padding:5px 12px;background:var(--ground);}
  h1.title{font-size:clamp(2rem,5.4vw,3.4rem);letter-spacing:-.025em;max-width:16ch;}
  .title .hl{color:var(--gold);}
  .lede{margin-top:20px;max-width:52ch;color:var(--ink-2);font-size:clamp(1rem,1.6vw,1.14rem);}
  .stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:1px;margin-top:38px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;}
  .stat{background:var(--surface);padding:16px 18px;}
  .stat .k{font-family:var(--font-mono);font-size:1.7rem;font-weight:700;letter-spacing:-.02em;color:var(--ink);}
  .stat .l{font-size:.76rem;color:var(--ink-3);margin-top:2px;letter-spacing:.02em;}

  .rec{margin-top:34px;display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 14px;padding:18px 20px;border:1px solid var(--gold);border-radius:12px;background:linear-gradient(180deg,rgba(var(--heat-rgb),.09),rgba(var(--heat-rgb),.03));}
  .rec .tag{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:700;}
  .rec .name{font-size:1.5rem;font-weight:800;letter-spacing:-.01em;}
  .rec .why{color:var(--ink-2);font-size:.95rem;flex:1 1 260px;min-width:240px;}

  /* ---------- section head ---------- */
  .shead{display:flex;align-items:baseline;gap:16px;margin-bottom:26px;flex-wrap:wrap;}
  .shead h2{font-size:clamp(1.35rem,2.6vw,1.9rem);}
  .shead .idx{font-family:var(--font-mono);font-size:.82rem;color:var(--gold);font-weight:700;letter-spacing:.05em;}
  .shead .sub{color:var(--ink-3);font-size:.86rem;margin-left:auto;}

  /* ---------- LEADERBOARD ---------- */
  .board{display:flex;flex-direction:column;gap:8px;}
  .row{display:grid;grid-template-columns:44px minmax(0,1fr) 168px 82px;gap:14px;align-items:center;
    background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:13px 16px;box-shadow:var(--shadow);
    transition:transform .16s ease,border-color .16s ease;}
  .row:hover{transform:translateX(3px);border-color:var(--gold);}
  .row.win{border-color:var(--gold);background:linear-gradient(90deg,rgba(var(--heat-rgb),.07),var(--surface) 40%);}
  .rank{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;font-family:var(--font-mono);font-weight:700;font-size:1.05rem;background:var(--surface-2);color:var(--ink-2);border:1px solid var(--line);}
  .rank.m1{background:var(--medal-1);color:#221c07;border-color:transparent;}
  .rank.m2{background:var(--medal-2);color:#1a1c1f;border-color:transparent;}
  .rank.m3{background:var(--medal-3);color:#211408;border-color:transparent;}
  .r-main{min-width:0;}
  .r-name{font-weight:800;font-size:1.06rem;letter-spacing:-.01em;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .r-en{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.14em;color:var(--ink-3);font-weight:600;}
  .r-tag{color:var(--ink-2);font-size:.85rem;margin-top:2px;overflow:hidden;text-overflow:ellipsis;}
  .r-meta{display:flex;gap:8px;margin-top:7px;flex-wrap:wrap;}
  .chip{font-family:var(--font-mono);font-size:.66rem;letter-spacing:.03em;color:var(--ink-2);background:var(--surface-2);border:1px solid var(--line-2);border-radius:6px;padding:2px 7px;}
  .bar-wrap{display:flex;flex-direction:column;gap:5px;}
  .bar{height:7px;border-radius:99px;background:var(--surface-2);overflow:hidden;border:1px solid var(--line-2);}
  .bar span{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--gold),var(--gold-bright));width:0;transition:width 1s cubic-bezier(.2,.7,.2,1);}
  .bar-lab{font-family:var(--font-mono);font-size:.64rem;color:var(--ink-3);letter-spacing:.04em;}
  .score{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size:1.5rem;font-weight:700;text-align:right;letter-spacing:-.02em;}
  .score small{font-size:.7rem;color:var(--ink-3);font-weight:400;}

  /* ---------- WINNER ---------- */
  .winner{background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden;}
  .win-head{padding:clamp(22px,3.4vw,34px);border-bottom:1px solid var(--line);position:relative;background:linear-gradient(180deg,rgba(var(--heat-rgb),.06),transparent);}
  .win-crown{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
  .win-crown .m{width:30px;height:30px;border-radius:8px;background:var(--medal-1);color:#221c07;display:grid;place-items:center;font-family:var(--font-mono);font-weight:700;}
  .win-crown .t{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:700;}
  .win-name{font-size:clamp(1.7rem,3.6vw,2.5rem);letter-spacing:-.02em;}
  .win-name .en{display:block;font-family:var(--font-mono);font-size:.78rem;letter-spacing:.24em;color:var(--ink-3);font-weight:600;margin-top:8px;}
  .win-tag{margin-top:16px;color:var(--ink-2);font-size:clamp(1rem,1.7vw,1.16rem);max-width:60ch;}
  .win-judges{display:flex;gap:10px;margin-top:22px;flex-wrap:wrap;}
  .jchip{border:1px solid var(--line);border-radius:10px;padding:9px 14px;background:var(--ground);display:flex;flex-direction:column;gap:1px;}
  .jchip .jn{font-size:.72rem;color:var(--ink-3);}
  .jchip .jv{font-family:var(--font-mono);font-weight:700;font-size:1.15rem;color:var(--ink);}
  .jchip.avg{border-color:var(--gold);background:rgba(var(--heat-rgb),.08);}
  .jchip.avg .jv{color:var(--gold);}

  .win-body{padding:clamp(22px,3.4vw,34px);display:grid;gap:34px;}
  .block-h{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:10px;}
  .block-h::after{content:"";flex:1;height:1px;background:var(--line);}

  .why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;}
  .why-card{border:1px solid var(--line);border-radius:12px;padding:16px;background:var(--surface-2);}
  .why-card .n{font-family:var(--font-mono);color:var(--gold);font-weight:700;font-size:.9rem;}
  .why-card .h{font-weight:700;margin:6px 0 4px;font-size:.98rem;}
  .why-card .d{color:var(--ink-2);font-size:.86rem;line-height:1.6;}

  .dimbars{display:grid;gap:11px;}
  .dimbar{display:grid;grid-template-columns:132px 1fr 40px;gap:12px;align-items:center;}
  .dimbar .dl{font-size:.85rem;color:var(--ink-2);display:flex;flex-direction:column;}
  .dimbar .dl .w{font-family:var(--font-mono);font-size:.62rem;color:var(--ink-3);letter-spacing:.04em;}
  .dimbar .dt{height:20px;border-radius:6px;background:var(--surface-2);border:1px solid var(--line-2);overflow:hidden;}
  .dimbar .dt span{display:block;height:100%;background:linear-gradient(90deg,rgba(var(--heat-rgb),.55),var(--gold));width:0;transition:width .9s cubic-bezier(.2,.7,.2,1);}
  .dimbar .dv{font-family:var(--font-mono);font-weight:700;text-align:right;font-size:.95rem;}

  .timeline{display:grid;gap:2px;}
  .tl-item{display:grid;grid-template-columns:60px 1fr;gap:16px;padding:14px 0;border-top:1px solid var(--line-2);}
  .tl-item:first-child{border-top:none;}
  .tl-t{font-family:var(--font-mono);font-weight:700;color:var(--gold);font-size:.9rem;padding-top:1px;}
  .tl-s{color:var(--ink);font-size:.94rem;line-height:1.66;}

  .plan{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;}
  .pcard{border:1px solid var(--line);border-radius:12px;padding:15px 16px;background:var(--surface-2);position:relative;}
  .pcard .span{font-family:var(--font-mono);font-weight:700;font-size:.8rem;color:var(--gold);letter-spacing:.05em;}
  .pcard .pd{color:var(--ink-2);font-size:.86rem;margin-top:6px;line-height:1.62;}

  .llist{display:grid;gap:9px;list-style:none;padding:0;margin:0;}
  .llist li{display:grid;grid-template-columns:20px 1fr;gap:11px;font-size:.92rem;color:var(--ink);line-height:1.62;}
  .llist li::before{content:"";width:7px;height:7px;border-radius:2px;background:var(--gold);margin-top:9px;transform:rotate(45deg);}
  .llist.risk li::before{background:var(--risk);border-radius:99px;transform:none;width:8px;height:8px;}
  .llist.bonus li::before{background:var(--good);}

  .cols2{display:grid;grid-template-columns:1fr 1fr;gap:34px;}
  @media (max-width:720px){.cols2{grid-template-columns:1fr;}}

  /* ---------- HEATMAP ---------- */
  .scroll{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow);}
  table.heat{border-collapse:collapse;width:100%;min-width:720px;font-size:.9rem;}
  .heat th,.heat td{padding:11px 10px;text-align:center;border-bottom:1px solid var(--line-2);}
  .heat thead th{position:sticky;top:0;background:var(--surface-2);font-size:.74rem;color:var(--ink-2);font-weight:700;border-bottom:1px solid var(--line);white-space:nowrap;}
  .heat thead th .w{display:block;font-family:var(--font-mono);font-size:.62rem;color:var(--ink-3);font-weight:600;margin-top:2px;}
  .heat td.name,.heat th.name{text-align:left;position:sticky;left:0;background:var(--surface);z-index:2;white-space:nowrap;border-right:1px solid var(--line);}
  .heat thead th.name{background:var(--surface-2);z-index:3;}
  .heat td.name .nm{font-weight:700;font-size:.92rem;}
  .heat td.name .rk{font-family:var(--font-mono);color:var(--ink-3);font-size:.72rem;margin-right:8px;}
  .heat tr.win-row td.name{box-shadow:inset 3px 0 0 var(--gold);}
  .cell{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-weight:600;color:var(--ink);border-radius:5px;}
  .heat td.total{font-family:var(--font-mono);font-weight:800;font-size:1.02rem;background:var(--surface-2);}
  .legend{display:flex;align-items:center;gap:12px;margin-top:14px;flex-wrap:wrap;color:var(--ink-3);font-size:.76rem;font-family:var(--font-mono);letter-spacing:.03em;}
  .legend .scale{display:flex;height:12px;border-radius:99px;overflow:hidden;border:1px solid var(--line);}
  .legend .scale i{width:22px;}

  /* ---------- RUNNER UPS ---------- */
  .runners{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
  @media (max-width:720px){.runners{grid-template-columns:1fr;}}
  .rcard{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:14px;}
  .rcard .rh{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;}
  .rcard .silver{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);font-weight:700;}
  .rcard h3{font-size:1.3rem;}
  .rcard .rscore{margin-left:auto;font-family:var(--font-mono);font-weight:700;color:var(--ink-2);}
  .rcard .lbl{font-family:var(--font-mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:700;}
  .rcard p{font-size:.9rem;color:var(--ink-2);line-height:1.66;}
  .rcard .graft{border-left:2px solid var(--gold);padding-left:14px;}
  .rcard .graft p{color:var(--ink);}

  /* ---------- APPENDIX ---------- */
  .cat{display:grid;gap:9px;}
  details.idea{background:var(--surface);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);overflow:hidden;}
  details.idea summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:14px;align-items:center;padding:14px 16px;}
  details.idea summary::-webkit-details-marker{display:none;}
  details.idea summary .rk{width:30px;height:30px;border-radius:8px;background:var(--surface-2);border:1px solid var(--line);display:grid;place-items:center;font-family:var(--font-mono);font-weight:700;color:var(--ink-2);font-size:.9rem;}
  details.idea .snm{font-weight:800;font-size:1rem;display:flex;gap:9px;align-items:center;flex-wrap:wrap;}
  details.idea .stag{color:var(--ink-2);font-size:.83rem;margin-top:2px;}
  details.idea .ssc{font-family:var(--font-mono);font-weight:700;color:var(--gold);font-size:1.05rem;}
  details.idea .caret{font-family:var(--font-mono);color:var(--ink-3);transition:transform .2s;font-size:.8rem;}
  details.idea[open] .caret{transform:rotate(90deg);}
  .idea-body{padding:2px 16px 18px;display:grid;gap:12px;border-top:1px solid var(--line-2);}
  .field{display:grid;grid-template-columns:74px 1fr;gap:12px;font-size:.88rem;}
  .field .fk{font-family:var(--font-mono);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);padding-top:3px;}
  .field .fv{color:var(--ink);line-height:1.62;}
  .field.rk .fv{color:var(--ink-2);}

  /* ---------- STRATEGY ---------- */
  .strat{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media (max-width:720px){.strat{grid-template-columns:1fr;}}
  .scard{display:grid;grid-template-columns:32px 1fr;gap:14px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow);}
  .scard .sn{font-family:var(--font-mono);font-weight:700;color:var(--gold);font-size:1.05rem;}
  .scard .sh{font-weight:700;font-size:.98rem;margin-bottom:3px;}
  .scard .sb{color:var(--ink-2);font-size:.87rem;line-height:1.62;}

  footer{border-top:1px solid var(--line);color:var(--ink-3);font-size:.8rem;padding-block:34px;}
  footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;}
  footer .mono{color:var(--ink-2);}

  @media (max-width:640px){
    .row{grid-template-columns:38px 1fr;gap:10px 12px;}
    .row .bar-wrap{grid-column:2;}
    .row .score{grid-column:1 / -1;text-align:left;}
    .dimbar{grid-template-columns:110px 1fr 36px;}
    .tl-item{grid-template-columns:52px 1fr;gap:12px;}
  }
  @media (prefers-reduced-motion:reduce){
    *{transition:none !important;animation:none !important;}
    .bar span,.dimbar .dt span{width:var(--final) !important;}
  }
</style>

<header class="hero">
  <div class="wrap">
    <div class="hero-top">
      <span class="badge">AI 自动化场景创意比赛</span>
      <span class="badge">评估报告 · v1</span>
      <span class="badge">2026-07-16</span>
    </div>
    <h1 class="title">10 个参赛方案，<span class="hl">3 位评委</span>打分，谁最能夺冠？</h1>
    <p class="lede">面向「技术/开发/产品」岗，围绕真实职场提效场景生成候选方案，按比赛评分导向（<b>简单好用权重最高</b>）多维评审，给出可直接落地的冠军方案与现场演示脚本。</p>

    <div class="stat-row">
      <div class="stat"><div class="k">10</div><div class="l">入围方案</div></div>
      <div class="stat"><div class="k">3</div><div class="l">评委视角</div></div>
      <div class="stat"><div class="k">6</div><div class="l">评分维度</div></div>
      <div class="stat"><div class="k">8.1</div><div class="l">冠军加权均分</div></div>
      <div class="stat"><div class="k">~2</div><div class="l">周开发窗口</div></div>
    </div>

    <div class="rec">
      <span class="tag">推荐夺冠 ★</span>
      <span class="name">图秒成表</span>
      <span class="why">发票 / 白板照 / 表格截图 → 30 秒变可编辑 Excel。链路最短、简单度满分、财务行政瞬间共情——稳中带亮的头名。</span>
    </div>
  </div>
</header>

<section id="board">
  <div class="wrap">
    <div class="shead">
      <span class="idx">01</span>
      <h2>方案排行榜</h2>
      <span class="sub">按三评委加权均分排序（0–10）</span>
    </div>
    <div class="board" id="boardList"></div>
  </div>
</section>

<section id="winner" style="background:var(--surface-2);border-block:1px solid var(--line);">
