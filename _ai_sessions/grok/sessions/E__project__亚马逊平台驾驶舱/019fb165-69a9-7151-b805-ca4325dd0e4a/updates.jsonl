{"timestamp":1785391509,"method":"session/update","params":{"sessionId":"019fb165-69a9-7151-b805-ca4325dd0e4a","update":{"sessionUpdate":"tool_call_update","toolCallId":"call-1ae79113-191a-437f-83f8-4472ce05a11a-14","status":"completed","content":[{"type":"content","content":{"type":"text","text":"WD=E:\\project\\�����\\sellfox-bridge\r\n\"\"\"���˽ű���ֻ�����������ѷ������� ? WMS �˵����𵥺˶ԣ�����/©�ύ/������һ�¸澯��\n\n�������� ��Ŀ˵��.md ��6 / �����¼_ҵ������.md����\n  - �� N ������ has_shipped�����������̣��𵥰�����ѡ WMS �˱��˶��˵�/�����̣�\n  - �N������ �� jinmao����è key����BLACKCAT �� blackcat����è key����\n  - ˳���顸�����ѷ������� submitTime����©�ύ����\n\n��ֻ����ֻ����ѯ��ӿڣ��ɰ�ȫ����/��ʱ��\n\n�÷���\n  python recon.py --config config/config.g2-agnis.yaml\n  python recon.py --days 3 --limit 50\n  python recon.py --probe\n  python recon.py --selftest\n  python recon.py --json recon_out.json\n\"\"\"\nimport argparse\nimport json\nimport logging\nimport sys\n\nimport yaml\n\nfrom bridge.clients.sellfox import SellfoxClient, SellfoxError\nfrom bridge.clients.wms import WmsClient, WmsError\nfrom bridge.notify import Notifier\nfrom main import build_wms_clients\n\nlog = logging.getLogger(\"recon\")\n\nSELLFOX_SHIPPED_STATUS = \"has_shipped\"\nWMS_SHIPPED_STATUSES = {\"2\", \"4\"}\n\nSF_TRACKING_PATHS = [\n    \"logistics.trackingNo\", \"logistics.trackNo\", \"trackingNo\",\n    \"trackNo\", \"trackingNumber\", \"logistics.trackingNumber\",\n]\nSF_SUBMIT_PATHS = [\n    \"submitTime\", \"submitDate\", \"platformSubmitTime\", \"orders.0.submitTime\",\n]\nSF_CHANNEL_PATHS = [\n    \"logistics.channelName\", \"channelName\", \"logistics.shipChannelName\",\n]\nSF_CARRIER_PATHS = [\n    \"logistics.carrier\", \"carrier\", \"logistics.providerName\",\n    \"logistics.logisticsName\",\n]\n\n\ndef _dig(obj, path):\n    cur = obj\n    for part in path.split(\".\"):\n        if cur is None:\n            return None\n        if isinstance(cur, list):\n            try:\n                cur = cur[int(part)]\n            except (ValueError, IndexError):\n                return None\n        elif isinstance(cur, dict):\n            cur = cur.get(part)\n        else:\n            return None\n    return cur\n\n\ndef _first(obj, paths):\n    for p in paths:\n        v = _dig(obj, p)\n        if v not in (None, \"\"):\n            return v\n    return None\n\n\ndef extract_sellfox_fields(pkg):\n    return {\n        \"sn\": pkg.get(\"packageSn\"),\n        \"channel_name\": _first(pkg, SF_CHANNEL_PATHS),\n        \"carrier\": _first(pkg, SF_CARRIER_PATHS),\n        \"tracking\": _first(pkg, SF_TRACKING_PATHS),\n        \"submit_time\": _first(pkg, SF_SUBMIT_PATHS),\n        \"country\": _dig(pkg, \"address.countryCode\"),\n        \"shop_id\": pkg.get(\"shopId\"),\n    }\n\n\ndef match_channel(channels, channel_name):\n    if not channel_name:\n        return None\n    for ch in channels:\n        if channel_name.endswith(ch[\"name\"]):\n            return ch\n    return None\n\n\ndef wms_profile_for_channel(cfg, channel):\n    \"\"\"���� �� WMS profile ������ pipeline._wms_for_channel һ�£���\"\"\"\n    if channel and channel.get(\"wms_profile\"):\n        return channel[\"wms_profile\"]\n    name = (channel or {}).get(\"name\") or \"\"\n    if \"BLACKCAT\" in str(name).upper():\n        return \"blackcat\"\n    return (cfg.get(\"wms\") or {}).get(\"default_profile\") or \"jinmao\"\n\n\ndef _norm(s):\n    return str(s or \"\").strip().upper()\n\n\ndef classify(sf, channel, wms_tracking, wms_status, wms_error, wms_profile=None):\n    \"\"\"���� (severity, code, detail)��\n\n    ˫ WMS ��BLACKCAT Ӧ�� blackcat profile��\n    ������ȷ�˱��Բ��� �� high���������ֻ�ڽ�è���ޣ����߼����󱨡������÷�����ѡ�� client��\n    \"\"\"\n    sn = sf[\"sn\"]\n    is_blackcat = bool(channel and str(channel[\"name\"]).upper().startswith(\"BLACKCAT\"))\n    is_shengxin = bool(channel and not is_blackcat)\n\n    if wms_error and (\n        \"δ��ѯ\" in wms_error or \"no order\" in wms_error.lower() or \"������\" in wms_error\n    ):\n        if is_blackcat:\n            return (\n                \"high\",\n                \"WMS_MISSING_BLACKCAT\",\n                f\"{sn} BLACKCAT ��������è WMS({wms_profile}) ���޴˵���������δ�Ʋ�\r\n===== INSTALL =====\r\n# Install daily recon scheduled task (local Windows).\r\n# Usage: powershell -ExecutionPolicy Bypass -File install_recon_daily.ps1\r\n$ErrorActionPreference = 'Stop'\r\n$Root = Split-Path -Parent $MyInvocation.MyCommand.Path\r\n$Bat = Join-Path $Root 'run_recon_daily.bat'\r\n$TaskName = 'SellfoxBridge-Recon-Daily'\r\n\r\nif (-not (Test-Path -LiteralPath $Bat)) { throw \"Missing $Bat\" }\r\nif (-not (Test-Path -LiteralPath (Join-Path $Root 'recon.py'))) { throw \"Missing recon.py\" }\r\n\r\nUnregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue\r\n\r\n$action = New-ScheduledTaskAction -Execute $Bat -WorkingDirectory $Root\r\n# Daily at 08:07 local time (off the hour to reduce fleet pile-up)\r\n$trigger = New-ScheduledTaskTrigger -Daily -At '08:07'\r\n$settings = New-ScheduledTaskSettingsSet `\r\n  -AllowStartIfOnBatteries `\r\n  -DontStopIfGoingOnBatteries `\r\n  -StartWhenAvailable `\r\n  -ExecutionTimeLimit (New-TimeSpan -Hours 2) `\r\n  -MultipleInstances IgnoreNew\r\n\r\n$principal = New-ScheduledTaskPrincipal -UserId $env:USERNAME -LogonType Interactive -RunLevel Highest\r\n\r\nRegister-ScheduledTask `\r\n  -TaskName $TaskName `\r\n  -Action $action `\r\n  -Trigger $trigger `\r\n  -Settings $settings `\r\n  -Principal $principal `\r\n  -Description 'sellfox-bridge daily recon (read-only). Logs: logs\\recon_YYYYMMDD.log. Config: config.g2-3shops.yaml' |\r\n  Out-Null\r\n\r\nWrite-Host \"Registered task: $TaskName\"\r\nWrite-Host \"  Schedule: daily 08:07 (local)\"\r\nWrite-Host \"  Bat: $Bat\"\r\nWrite-Host \"  User: $env:USERNAME\"\r\nWrite-Host \"\"\r\nWrite-Host \"Run once now:  Start-ScheduledTask -TaskName $TaskName\"\r\nWrite-Host \"Or manual:     .\\run_recon_daily.ba