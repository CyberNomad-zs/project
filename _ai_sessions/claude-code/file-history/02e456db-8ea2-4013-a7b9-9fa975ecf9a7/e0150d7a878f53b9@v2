{
  "manifest_version": 3,
  "name": "Temu 店铺监测",
  "version": "0.2.3",
  "description": "监测 Temu 在售商品限流（严重/一般分级），即时+定点汇总发飞书，可同步多维表与任务。上下架由公司服务器负责。",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "idle"
  ],
  "host_permissions": [
    "https://agentseller.temu.com/*",
    "https://www.temu.com/*",
    "https://open.feishu.cn/*",
    "https://open.larksuite.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Temu 流量监测"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://agentseller.temu.com/*"
      ],
      "js": [
        "logger.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.temu.com/*"
      ],
      "js": [
        "logger.js",
        "content-front.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://agentseller.temu.com/*"
      ]
    }
  ]
}
