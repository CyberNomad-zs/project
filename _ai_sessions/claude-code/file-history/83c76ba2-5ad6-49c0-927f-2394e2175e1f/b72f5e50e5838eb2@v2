(function(){
  var body = document.body && document.body.innerText ? document.body.innerText.slice(0, 2000) : "";
  var tables = document.querySelectorAll("table").length;
  var ths = [];
  var thNodes = document.querySelectorAll("th");
  for (var i = 0; i < thNodes.length && i < 20; i++) {
    ths.push((thNodes[i].textContent || "").replace(/\s+/g, " ").trim().slice(0, 40));
  }
  var links = [];
  var as = document.querySelectorAll("a[href]");
  for (var j = 0; j < as.length && links.length < 20; j++) {
    var href = as[j].href || "";
    if (/product|manage|goods|listing/i.test(href)) {
      links.push(href.slice(0, 140));
    }
  }
  var captcha = /验证|拼图|captcha|Verify/i.test(body);
  return JSON.stringify({
    url: location.href,
    title: document.title || "",
    tables: tables,
    ths: ths,
    captcha: captcha,
    body: body,
    links: links
  });
})();
