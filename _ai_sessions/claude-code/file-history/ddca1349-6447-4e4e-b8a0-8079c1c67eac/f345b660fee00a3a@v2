                )
                ON CONFLICT (shop_external_id, period_start, period_end, currency) DO UPDATE SET
                    shop_id = COALESCE(EXCLUDED.shop_id, tk.fact_sellfox_tk_profit_shop.shop_id),
                    shop_name = COALESCE(EXCLUDED.shop_name, tk.fact_sellfox_tk_profit_shop.shop_name),
