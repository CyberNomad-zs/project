async def sync_profit_sku(
    db: AsyncSession,
    client: SellfoxClient,
    index: ShopIndex,
    *,
    start: date,
    end: date,
    grain: str = "sku",
) -> dict[str, int]:
    stats = {"fetched": 0, "upserted": 0, "unmapped": 0}
    assert grain in ("sku", "msku")

    async def fetch_page(page_num: int = 1, page_size: int = 50, **_k: Any) -> Any:
        fn = client.tiktok_report_sku if grain == "sku" else client.tiktok_report_msku
        return await fn(
            start_date=start.isoformat(),
            end_date=end.isoformat(),
            page_num=page_num,
            page_size=page_size,
            currency="",
        )

    rows = await _paginate(fetch_page, page_size=50, max_pages=100)
    now = datetime.now(timezone.utc)
    for r in rows:
        stats["fetched"] += 1
        shop = index.resolve(
            sellfox_shop_id=r.get("shopId") or r.get("shopIds"),
            shop_name=r.get("shopName"),
            shop_name_list=r.get("shopNameList"),
            shop_ids_field=r.get("shopIds"),
        )
        if not shop:
            stats["unmapped"] += 1
            # 仍尽量用 sellfox id 占位 external = sf:{id}
            sfid = str(r.get("shopIds") or r.get("shopId") or "unknown").strip()
            shop = {
                "shop_uuid": None,
                "ziniao_store_id": f"sf:{sfid}",
                "name": (
                    (_as_list(r.get("shopNameList")) or [None])[0]
                    or r.get("shopName")
                    or f"sellfox:{sfid}"
                ),
                "sellfox_shop_id": sfid,
            }
        sku_list = _as_list(r.get("skuList"))
        msku_list = _as_list(r.get("mskuList"))
        commodity = _as_list(r.get("commodityNameList"))
        if grain == "sku":
            sku_key = _join_key(sku_list or msku_list or commodity)
        else:
            sku_key = _join_key(msku_list or sku_list or commodity)
        core = _profit_core(r)
        extra = {k: v for k, v in r.items() if k not in _PROFIT_PROMOTED}
        extra["source"] = "sellfox"
        extra["period"] = f"{start}..{end}"
        shop_uuid = shop.get("shop_uuid")
        await db.execute(
            text(
                """
                INSERT INTO tk.fact_sellfox_tk_profit_sku (
                    id, shop_id, shop_external_id, shop_name, sellfox_shop_id,
                    period_start, period_end, grain, sku_key,
                    sku_list, msku_list, commodity_name_list, currency,
                    sales_qty, return_qty, gross_sales_amount, gross_sales_refund,
                    settlement_amount, gross_profit, gross_rate, ads_cost,
                    raw_extra, collected_at, created_at, updated_at
                ) VALUES (
                    CAST(:id AS uuid),
                    CAST(:shop_id AS uuid),
                    :shop_external_id, :shop_name, :sellfox_shop_id,
                    :period_start, :period_end, :grain, :sku_key,
