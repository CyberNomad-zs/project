{"timestamp":1785383304,"method":"session/update","params":{"sessionId":"019fab7f-7ed9-7553-a471-73b6cca96147","update":{"sessionUpdate":"tool_call","toolCallId":"call-00317f83-417d-461c-90e3-331c8757f541-213","title":"search_replace","rawInput":{"file_path":"E:\\project\\清泉跨境系统（企业级）\\scripts\\start-api.ps1","new_string":"# 清泉 API 常驻启动（后台进程，不占当前终端）\n# 用法:\n#   .\\scripts\\start-api.ps1\n#   .\\scripts\\start-api.ps1 -Port 8000 -ForceRestart\n#\n# 停止: .\\scripts\\stop-api.ps1\n# 状态: .\\scripts\\status-api.ps1\n\nparam(\n  [int]$Port = 8000,\n  [switch]$ForceRestart\n)\n\n$ErrorActionPreference = 'Stop'\n$root = Split-Path $PSScriptRoot -Parent\n$backend = Join-Path $root 'backend'\n$venvPy = Join-Path $backend '.venv\\Scripts\\python.exe'\n$envFile = Join-Path $root '.env'\n$logsDir = Join-Path $root 'logs'\n$pidFile = Join-Path $logsDir 'api.pid'\n$outLog = Join-Path $logsDir 'api-daemon.out.log'\n$errLog = Join-Path $logsDir 'api-daemon.err.log'\n\nif (-not (Test-Path $logsDir)) { New-Item -ItemType Directory -Path $logsDir | Out-Null }\n\nfunction Get-DotEnv([string]$path) {\n  $map = @{}\n  if (-not (Test-Path $path)) { return $map }\n  Get-Content $path -Encoding UTF8 | ForEach-Object {\n    $line = $_.Trim()\n    if (-not $line -or $line.StartsWith('#')) { return }\n    $i = $line.IndexOf('=')\n    if ($i -lt 1) { return }\n    $map[$line.Substring(0, $i).Trim()] = $line.Substring($i + 1).Trim().Trim('\"').Trim(\"'\")\n  }\n  return $map\n}\n\nfunction Test-ApiHealth([int]$p) {\n  try {\n    $h = Invoke-RestMethod -Uri \"http://127.0.0.1:$p/health\" -TimeoutSec 2\n    return ($h.status -eq 'ok')\n  } catch { return $false }\n}\n\nfunction Get-ListenerPids([int]$p) {\n  $pids = @()\n  try {\n    $conns = Get-NetTCPConnection -LocalPort $p -State Listen -ErrorAction SilentlyContinue\n    foreach ($c in @($conns)) {\n      if ($c.OwningProcess) { $pids += [int]$c.OwningProcess }\n    }\n  } catch {}\n  return ($pids | Select-Object -Unique)\n}\n\nif (-not (Test-Path $venvPy)) {\n  Write-Error \"未找到 venv Python: $venvPy  请先跑 .\\scripts\\dev-local.ps1 或创建 backend\\.venv\"\n}\n\n# 已健康则直接退出\nif ((Test-ApiHealth $Port) -and -not $ForceRestart) {\n  $existing = Get-ListenerPids $Port\n  Write-Host \"API 已在运行 http://127.0.0.1:$Port/health  PID=$($existing -join ',')\" -ForegroundColor Green\n  if ($existing.Count -gt 0) { $existing[0] | Set-Content -Path $pidFile -Encoding ascii }\n  exit 0\n}\n\nif ($ForceRestart) {\n  Write-Host \"ForceRestart: 停止占用 $Port 的进程...\"\n  foreach ($procId in (Get-ListenerPids $Port)) {\n    try { Stop-Process -Id $procId -Force -ErrorAction SilentlyContinue } catch {}\n  }\n  if (Test-Path $pidFile) {\n    $old = Get-Content $pidFile -ErrorAction SilentlyContinue\n    if ($old) { try { Stop-Process -Id ([int]$old) -Force -ErrorAction SilentlyContinue } catch {} }\n    Remove-Item $pidFile -Force -ErrorAction SilentlyContinue\n  }\n  Start-Sleep -Seconds 1\n}\n\n# 端口被占但 health 不通 → 清掉\nif (-not (Test-ApiHealth $Port)) {\n  foreach ($procId in (Get-ListenerPids $Port)) {\n    Write-Host \"清理僵死监听 PID=$procId\"\n    try { Stop-Process -Id $procId -Force -ErrorAction SilentlyContinue } catch {}\n  }\n  Start-Sleep -Seconds 1\n}\n\n$envMap = Get-DotEnv $envFile\n$pgUser = if ($envMap['POSTGRES_USER']) { $envMap['POSTGRES_USER'] } else { 'qingquan' }\n$pgPass = if ($envMap['POSTGRES_PASSWORD']) { $envMap['POSTGRES_PASSWORD'] } else { 'qingquan' }\n$pgDb = if ($envMap['POSTGRES_DB']) { $envMap['POSTGRES_DB'] } else { 'qingquan' }\n$pgPort = if ($envMap['POSTGRES_PORT']) { $envMap['POSTGRES_PORT'] } else { '5432' }\n\n# 子进程环境：用 cmd set 写入启动批处理，避免 Start-Process 丢 env\n$bat = Join-Path $logsDir 'api-daemon-run.cmd'\n$dbUrl = if ($envMap['DATABASE_URL']) {\n  ($envMap['DATABASE_URL'] -replace 'postgresql\\+asyncpg', 'postgresql+asyncpg')\n} else {\n  \"postgresql+asyncpg://${pgUser}:${pgPass}@127.0.0.1:${pgPort}/${pgDb}\"\n}\n# 若 .env 指向 docker 主机名 db，本机常驻改连 127.0.0.1\n$dbUrl = $dbUrl -replace '@db:', '@127.0.0.1:'\n\n$appSecret = if ($envMap['APP_SECRET_KEY']) { $envMap['APP_SECRET_KEY'] } else { 'dev-secret' }\n$ingestKey = if ($envMap['INGEST_DEFAULT_API_KEY']) { $envMap['INGEST_DEFAULT_API_KEY'] } else { 'dev-ingest-key' }\n\n$batLines = @(\n  '@echo off',\n  \"cd /d `\"$backend`\"\",\n  \"set DATABASE_URL=$dbUrl\",\n  \"set APP_SECRET_KEY=$appSecret\",\n  \"set INGEST_DEFAULT_API_KEY=$ingestKey\",\n  \"set APP_ENV=dev\",\n  \"set TZ=Asia/Shanghai\"\n)\n# 透传飞书等可选变量\nforeach ($k in @('FEISHU_APP_ID','FEISHU_APP_SECRET','FEISHU_BITABLE_APP_TOKEN','FEISHU_BITABLE_TABLE_TASKS','REDIS_URL','ADMIN_USERNAME','ADMIN_PASSWORD')) {\n  if ($envMap[$k]) { $batLines += \"set $k=$($envMap[$k])\" }\n}\n$batLines += \"`\"$venvPy`\" -m uvicorn app.main:app --host 127.0.0.1 --port $Port\"\n$batLines -join \"`r`n\" | Set-Content -Path $bat -Encoding ASCII\n\nWrite-Host \"启动 API 常驻: http://127.0.0.1:$Port ...\" -ForegroundColor Cyan\n$p = Start-Process -FilePath 'cmd.exe' `\n  -ArgumentList @('/c', \"`\"$bat`\"\") `\n  -WorkingDirectory $backend `\n  -WindowStyle Hidden `\n  -RedirectStandardOutput $outLog `\n  -RedirectStandardError $errLog `\n  -PassThru\n\n# uvicorn 可能是子进程；用监听端口找真实 PID\n$ready = $false\n$apiPid = $null\nfor ($i = 0; $i -lt 40; $i++) {\n  Start-Sleep -Seconds 1\n  if (Test-ApiHealth $Port) {\n    $ready = $true\n    $apiPid = @(Get-ListenerPids $Port) | Select-Object -First 1\n    if (-not $apiPid) { $apiPid = $p.Id }\n    break\n  }\n  if ($p.HasExited) {\n    Write-Host \"启动进程已退出。err log:\" -ForegroundColor Red\n    if (Test-Path $errLog) { Get-Content $errLog -Tail 30 }\n    exit 1\n  }\n}\n\nif (-not $ready) {\n  Write-Host \"health 超时。err log:\" -ForegroundColor Red\n  if (Test-Path $errLog) { Get-Content $errLog -Tail 40 }\n  exit 1\n}\n\n$apiPid | Set-Content -Path $pidFile -Encoding ascii\nWrite-Host \"API 常驻已启动 PID=$apiPid  health=ok\" -ForegroundColor Green\nWrite-Host \"  文档: http://127.0.0.1:$Port/docs\"\nWrite-Host \"  日志: $outLog / $errLog\"\nWrite-Host \"  停止: .\\scripts\\stop-api.ps1\"\n","old_string":""},"_meta":{"x.ai/tool":{"version":1,"name":"search_replace","kind":"edit","namespace":"grok_build","label":"Edit","read_only":false}}},"_meta":{"totalTokens":260782,"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-30743","agentTimestampMs":1785383304722,"promptId":"af26f68d-cb66-4e37-a35e-ca92f473cb84","streamStartMs":1785383273857,"turnStartMs":1785383246818,"updateType":"ToolCall","updateParams":{"toolCallId":"call-00317f83-417d-461c-90e3-331c8757f541-213","title":"search_replace","kind":"Other","status":"Pending"}}}}
