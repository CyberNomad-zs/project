海外TK店铺广告投流数据自动化监测\\scripts\\run-multi-store.ps1","matches":[{"line_number":1,"content":"# Multi-store TikTok ad scrape via ziniao-cli (dynamic store list)"},{"line_number":8,"content":"# Requires: Ziniao client running + ziniao-cli doctor OK"},{"line_number":20,"content":"# ziniao-cli writes progress to stderr; do not treat as terminating"},{"line_number":39,"content":"$qingquanLib = Join-Path $PSScriptRoot 'qingquan-client.ps1'"},{"line_number":40,"content":"if (Test-Path $qingquanLib) { . $qingquanLib }"},{"line_number":97,"content":"      Write-Host \"HINT: 紫鸟 Bridge 不可用。请打开并登录「紫鸟」桌面客户端后重试。\" -ForegroundColor Yellow"},{"line_number":98,"content":"      Write-Host \"      仅安装 Node/ziniao-cli 不够；本机客户端须在线 (127.0.0.1:9481)。\" -ForegroundColor Yellow"},{"line_number":125,"content":"  $spend = 0.0"},{"line_number":126,"content":"  if ($null -ne $row.spend) { $spend = [double]$row.spend }"},{"line_number":129,"content":"  return ($spend -eq 0 -and $revenue -eq 0)"},{"line_number":195,"content":"  # 紫鸟开店默认常是小窗；Win32 最大化有助于广告表完整渲染"},{"line_number":221,"content":"      // 紫鸟店铺窗多为 Chromium；标题常含 TikTok / seller / 店铺名"},{"line_number":227,"content":"               || t.IndexOf(\"紫鸟\", StringComparison.OrdinalIgnoreCase) >= 0"},{"line_number":357,"content":"    campaign   = Pick-Name $A_CAMPAIGN"},{"line_number":358,"content":"    spend      = Pick-Name $A_SPEND"},{"line_number":368,"content":"  if (-not $fn.campaign -or -not $fn.store) {"},{"line_number":381,"content":"    if ($fn.campaign) { $fields[$fn.campaign] = $row.campaign }"},{"line_number":382,"content":"    if ($fn.spend) { $fields[$fn.spend] = [double]$row.spend }"},{"line_number":440,"content":"# Cache: npm ziniao-cli is a .ps1 shim — Process.Start cannot run it; invoke node + run.js directly"},{"line_number":448,"content":"  if (-not $nodeCmd) { throw \"node not found in PATH (required by ziniao-cli)\" }"},{"line_number":454,"content":"    $candidates += (Join-Path $npmDir 'node_modules\\@ziniao-open\\cli\\scripts\\run.js')"},{"line_number":456,"content":"  $cmd = Get-Command ziniao-cli -ErrorAction SilentlyContinue"},{"line_number":459,"content":"    $candidates += (Join-Path $base 'node_modules\\@ziniao-open\\cli\\scripts\\run.js')"},{"line_number":468,"content":"    throw \"ziniao-cli run.js not found. Install: npm i -g @ziniao-open/cli  (looked under %APPDATA%\\npm\\node_modules\\@ziniao-open\\cli)\""},{"line_number":470,"content":"  Write-Step (\"ziniao runtime: node={0} run.js={1}\" -f $script:ZiniaoNode, $script:ZiniaoRunJs)"},{"line_number":474,"content":"  # UTF-8 capture via ProcessStartInfo. npm ziniao-cli is .ps1 — call node run.js instead."},{"line_number":496,"content":"    throw \"Failed to start ziniao (node): $($_.Exception.Message)\""},{"line_number":567,"content":"  # ziniao-cli page exec shapes seen in the wild:"},{"line_number":655,"content":"Write-Step \"check ziniao-cli...\""},{"line_number":662,"content":"  Write-Step \"WARN: ziniao doctor 未明确通过，若随后 store list 失败请先打开紫鸟客户端\""},{"line_number":680,"content":"    $hint = \"无法连接紫鸟 Bridge (http://127.0.0.1:9481)。请打开并登录紫鸟桌面客户端后重试。\""},{"line_number":682,"content":"    Write-Host \"===== 紫鸟未连接 =====\" -ForegroundColor Red"},{"line_number":684,"content":"    Write-Host \"步骤: 启动紫鸟客户端 → 登录 → 等待就绪 → 再点「预览店铺列表」\" -ForegroundColor Yellow"},{"line_number":691,"content":"Write-Step (\"ziniao stores total: {0}\" -f $all.Count)"},{"line_number":756,"content":"Write-Step (\"skipZeroDisabledCampaigns={0} (C: skip off+spend0+revenue0 only)\" -f $skipZeroDisabled)"},{"line_number":801,"content":"    qingquanAccepted = 0"},{"line_number":802,"content":"    qingquanDup      = 0"},{"line_number":803,"content":"    qingquanError    = $null"},{"line_number":813,"content":"    # 默认尽量拉大窗口：紫鸟 open 支持 --window-ratio；再配合 page 内 resize / Win32 最大化"}]}]}},"_meta":{"totalTokens":73338,"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-8166","agentTimestampMs":1785291580672,"promptId":"2ad4aed2-7f90-4710-ad70-500b446c164e","streamStartMs":1785291574991,"turnStartMs":1785291565762,"updateType":"ToolCallUpdate","updateParams":{"toolCallId":"call-bcb3aa94-9ec3-4930-b59e-d9ecd3fb70de-43","status":"Completed"}}}}
{"timestamp":1785291586,"method":"session/update","params":{"sessionId":"019fab7f-7ed9-7553-a471-73b6cca96147","update":{"sessionUpdate":"agent_thought_chunk","content":{"type":"text","text":"I have a clear picture. The user wants to grab \"all TK platform data\" using either:"}},"_meta":{"totalTokens":74139,"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-8186","agentTimestampMs":1785291583157,"promptId":"2ad4aed2-7f90-4710-ad70-500b446c164e","streamStartMs":1785291581860,"turnStartMs":1785291565762,"updateType":"AgentThoughtChunk","chunkId":20}}}
{"timestamp":1785291601,"method":"session/update","params":{"sessionId":"019fab7f-7ed9-7553-a471-73b6cca96147","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"# TK 全量抓数：两种方法怎么选\n\n## 先泼一盆冷水\n**「TK 所有数据」一次做不完。**  \n现成脚本**只抓广告**（系列名 / 花费 / 销量 / ROI / 收入），不是订单、商品、库存、售后全站。\n\n清泉侧目前也只接了：`tiktok_ads` → `fact_ads_campaign_daily`。\n\n---\n\n## 两种方法对比（极简）\n\n| | **现有脚本（紫鸟开店 + 页内抓）** | **紫鸟开放平台 API** |\n|--|--|--|\n| 现在能干什么 | 广告日报，**已在跑**；旁路上报清泉代码也有了 | 管店、自动化、在浏览器环境里跑任务/采页 |\n| 优点 | 落地快、字段已对齐飞书/清泉 | 好调度、可扩多任务、少改本地脏脚本 |\n| 缺点 | 依赖桌面紫鸟；页面一改就脆；扩域要新写爬取 | **不是** TikTok 官方全量业务 API；业务数据仍多靠页面/插件 |\n| 适合 | **先把广告稳进清泉库** | 编排、扩店、后续多页面采集 |\n\n**结论：**  \n- **业务数**：主要还是「紫鸟环境里打开 TK 页 → 抓 → 上报」  \n- **开放 API**：更像「调度/管店的壳」，不能指望一个 API 吐出全部 TK 经营数据  \n\n推荐：**脚本（或插件）出数 + 统一打进清泉 Ingest**；紫鸟 API 用来开店/串店/跑任务。\n\n---\n\n## 建议路线（只 TK）\n\n| 阶段 | 做什么 |\n|------|--------|\n| **先做** | 广告：现有 `run-multi-store` → 打开 `qingquan.enabled` → 进清泉库（Stage A，已有 `qingquan-client.ps1`） |\n| **再扩** | 按业务点名：订单 / 商品 / GMV / 售后… 各加一个 `source` + 事实表 |\n| **后做** | 异常规则、看板；不要和第一刀绑死 |\n\n统一铁律：**只上报清泉，不直连 PG；飞书可 dual。**\n\n---\n\n## 你需要拍板的 3 件事（回这三项即可）\n\n1. **「所有数据」第一批要哪些？**  \n   例：`只要广告` / `广告+订单` / `广告+商品+GMV`（请点名）\n\n2. **是否保留现网 17:20 写飞书？**  \n   - `dual`：中心 + 飞书（稳妥）  \n   - `center`：只进中心  \n\n3. **清泉中心地址**  \n   本机 `http://127.0.0.1:8000` 还是已有服务器 URL？\n\n你回这三句后，我按你的范围列**最短改造清单**（改哪几个文件、怎么验收），再动代码。"}},"_meta":{"totalTokens":74139,"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-8887","agentTimestampMs":1785291600936,"promptId":"2ad4aed2-7f90-4710-ad70-500b446c164e","streamStartMs":1785291581860,"turnStartMs":1785291565762,"updateType":"AgentMessageChunk","chunkId":721}}}
