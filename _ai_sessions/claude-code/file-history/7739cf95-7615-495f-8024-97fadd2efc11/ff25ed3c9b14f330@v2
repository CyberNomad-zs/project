                    "property": {
                        "filter_info": {
                            "conjunction": "and",
                            "conditions": [
                                {
                                    "field_id": "fld9R1LGOG",
                                    "operator": "is",
                                    "value": ["Deal to deal"],
                                }
                            ],
                        }
                    },
                }
            },
            {
                "property": {
                    "filter_info": {
                        "conjunction": "and",
                        "conditions": [
                            {
                                "field_id": "fld9R1LGOG",
                                "operator": "is",
                                "value": ["Deal to deal"],
                            }
                        ],
                    }
                }
            },
            {
                "view": {
                    "property": {
                        "filter_info": {
                            "conjunction": "and",
                            "conditions": [
                                {
                                    "field_name": "店铺",
                                    "operator": "is",
                                    "value": ["Deal to deal"],
                                }
