## 9. 常用核对 SQL

```sql
-- Schema 与对象
SELECT table_schema, table_type, table_name
FROM information_schema.tables
WHERE table_schema IN ('public', 'tk', 'temu')
ORDER BY 1, 2, 3;

-- 行数
SELECT schemaname || '.' || relname AS tbl, n_live_tup
FROM pg_stat_user_tables
ORDER BY 1;

-- 采集源
SELECT source, process_status, count(*)
FROM ingest_raw GROUP BY 1, 2 ORDER BY 1, 2;

-- TK 广告窗口
SELECT min(biz_date), max(biz_date), count(*), count(DISTINCT shop_external_id)
FROM tk.fact_ads_campaign_daily;

-- 任务堆积
SELECT platform, status, count(*) FROM task GROUP BY 1, 2 ORDER BY 1, 2;

-- Outbox 积压
SELECT status, count(*) FROM outbox_event GROUP BY 1;
```

