from __future__ import annotations

import logging
import time
from typing import Any

import httpx

from app.config import Settings, get_settings

logger = logging.getLogger(__name__)


class FeishuError(Exception):
    def __init__(self, code: int | str, message: str, payload: Any = None) -> None:
        super().__init__(f"[{code}] {message}")
        self.code = code
        self.message = message
        self.payload = payload


class FeishuClient:
    """飞书开放平台客户端骨架：tenant token + 多维表格 + 机器人 webhook。

    凭证未配置时，调用方应检查 settings.has_feishu，不要强制实例化。
    """

    BASE = "https://open.feishu.cn/open-apis"

    def __init__(self, settings: Settings | None = None, timeout: float = 30.0) -> None:
        self.settings = settings or get_settings()
        if not self.settings.has_feishu:
            raise FeishuError("config", "缺少 FEISHU_APP_ID / FEISHU_APP_SECRET")
        self._http = httpx.Client(timeout=timeout)
        self._token: str | None = None
        self._token_expire_at: float = 0.0

    def close(self) -> None:
        self._http.close()

    def __enter__(self) -> FeishuClient:
        return self

    def __exit__(self, *args: object) -> None:
        self.close()

    def get_tenant_access_token(self, *, force: bool = False) -> str:
        if not force and self._token and self._token_expire_at - 60 > time.time():
            return self._token
        url = f"{self.BASE}/auth/v3/tenant_access_token/internal"
        resp = self._http.post(
            url,
            json={
                "app_id": self.settings.feishu_app_id,
                "app_secret": self.settings.feishu_app_secret,
            },
        )
        resp.raise_for_status()
        data = resp.json()
        if data.get("code") != 0:
            raise FeishuError(data.get("code"), data.get("msg") or "token failed", data)
        self._token = data["tenant_access_token"]
        self._token_expire_at = time.time() + int(data.get("expire") or 7200)
        return self._token

    def _headers(self) -> dict[str, str]:
        return {
            "Authorization": f"Bearer {self.get_tenant_access_token()}",
            "Content-Type": "application/json; charset=utf-8",
        }

    def bitable_list_records(
        self,
        app_token: str,
        table_id: str,
        *,
        page_size: int = 100,
        page_token: str | None = None,
        filter_expr: str | None = None,
    ) -> dict[str, Any]:
        url = f"{self.BASE}/bitable/v1/apps/{app_token}/tables/{table_id}/records"
        params: dict[str, Any] = {"page_size": page_size}
        if page_token:
            params["page_token"] = page_token
        if filter_expr:
            params["filter"] = filter_expr
        resp = self._http.get(url, headers=self._headers(), params=params)
        resp.raise_for_status()
        data = resp.json()
        if data.get("code") != 0:
            raise FeishuError(data.get("code"), data.get("msg") or "list failed", data)
        return data.get("data") or {}

    def bitable_batch_create(
        self,
        app_token: str,
        table_id: str,
        records: list[dict[str, Any]],
    ) -> dict[str, Any]:
        """records: [{"fields": {...}}, ...] 每次最多 500。"""
        url = f"{self.BASE}/bitable/v1/apps/{app_token}/tables/{table_id}/records/batch_create"
        resp = self._http.post(
            url,
            headers=self._headers(),
            json={"records": records},
        )
        resp.raise_for_status()
        data = resp.json()
        if data.get("code") != 0:
            raise FeishuError(data.get("code"), data.get("msg") or "create failed", data)
        return data.get("data") or {}

    def bitable_batch_update(
        self,
        app_token: str,
        table_id: str,
        records: list[dict[str, Any]],
    ) -> dict[str, Any]:
        """records: [{"record_id": "...", "fields": {...}}, ...]"""
        url = f"{self.BASE}/bitable/v1/apps/{app_token}/tables/{table_id}/records/batch_update"
        resp = self._http.post(
            url,
            headers=self._headers(),
            json={"records": records},
        )
        resp.raise_for_status()
        data = resp.json()
        if data.get("code") != 0:
            raise FeishuError(data.get("code"), data.get("msg") or "update failed", data)
        return data.get("data") or {}

    def send_webhook_text(self, text: str, webhook: str | None = None) -> None:
        url = webhook or self.settings.feishu_bot_webhook
        if not url:
            logger.warning("FEISHU_BOT_WEBHOOK 未配置，跳过消息: %s", text[:200])
            return
        resp = self._http.post(url, json={"msg_type": "text", "content": {"text": text}})
        resp.raise_for_status()
        data = resp.json()
        # custom bot returns StatusCode/code variants
        if data.get("code") not in (None, 0) and data.get("StatusCode") not in (None, 0):
            raise FeishuError(data.get("code") or data.get("StatusCode"), str(data), data)
