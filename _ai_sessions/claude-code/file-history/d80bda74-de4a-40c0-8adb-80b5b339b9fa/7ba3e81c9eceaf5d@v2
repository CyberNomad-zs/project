# 本地默认配置（可按环境修改；密钥放 .env）

sellfox:
  min_interval_seconds: 1.1
  page_size: 100
  field_modules:
    - PRODUCT_INFO
    - SALE_INFO
    - SESSION_PERFORMANCE_INFO
    - PERFORMANCE_INFO
    - AD_INFO
    - FBA_INVENTORY_INFO
    - REVIEW_PERFORMANCE_INFO
  shop_id_list: []
  is_new_or_moving_or_in_stock: "0"
  dim_type: "1"
  compare_type_list:
    - "1"

sync:
  save_raw_snapshot: false
  sink: sqlite

