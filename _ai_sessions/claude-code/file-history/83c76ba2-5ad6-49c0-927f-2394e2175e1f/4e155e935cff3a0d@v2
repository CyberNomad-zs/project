/* TikTok Shop orders list scraper for ziniao-cli page exec. No // line comments (one-line minify). */
(function () {
  function cleanText(t) {
    return String(t ?? '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function detectCurrency(text) {
    const s = String(text ?? '');
    if (/[£]|GBP|英镑/i.test(s)) return 'GBP';
    if (/[€]|EUR|欧元/i.test(s)) return 'EUR';
    if (/[¥￥]|CNY|RMB|元/i.test(s) && !/\$/.test(s)) return 'CNY';
    if (/\$|USD|美金|美元/i.test(s)) return 'USD';
    return null;
  }

  function parseNumber(value) {
    if (value == null || value === '') return null;
    if (typeof value === 'number' && Number.isFinite(value)) return value;
    let s = String(value).trim();
    if (!s || s === '-' || s === '—') return null;
    s = s
      .replace(/[,\s]/g, '')
      .replace(/[¥$€£￥]/g, '')
      .replace(/USD|GBP|EUR|CNY|RMB|美金|美元|英镑|欧元/gi, '')
      .replace(/%/g, '');
    const paren = s.match(/^\((.+)\)$/);
    if (paren) s = `-${paren[1]}`;
    const n = Number(s);
    return Number.isFinite(n) ? n : null;
  }

  const HEADER_ALIASES = {
    orderId: [
      '订单号',
      '订单编号',
      'order id',
      'order no',
      'order number',
      'order_id',
      '订单 id'
    ],
    orderStatus: ['订单状态', '状态', 'order status', 'status'],
    payTime: ['支付时间', '付款时间', 'pay time', 'paid time', 'payment time'],
    createTime: ['下单时间', '创建时间', 'order time', 'created time', 'create time'],
    productName: [
      '商品',
      '商品名称',
      '产品名称',
      '品名',
      'product',
      'product name',
      'item'
    ],
    sellerSku: ['商家sku', 'seller sku', 'sku', '商家编码', '货号'],
    skuId: ['skuid', 'sku id', '平台sku'],
    quantity: ['数量', '件数', 'qty', 'quantity', 'units'],
    payAmount: [
      '实付',
      '订单金额',
      '应付',
      '金额',
      'pay amount',
      'order amount',
      'payment',
      'total'
    ],
    shippingStatus: ['物流状态', '发货状态', 'shipping status', 'fulfillment'],
    buyerRegion: ['国家', '地区', '收货地', 'region', 'country', 'ship to']
  };

  function normHeader(h) {
    return cleanText(h).toLowerCase();
  }

  function matchField(header) {
    const h = normHeader(header);
    if (!h) return null;
    let best = null;
    let bestLen = 0;
    for (const [field, aliases] of Object.entries(HEADER_ALIASES)) {
      for (const a of aliases) {
        const al = a.toLowerCase();
        if (h === al || h.includes(al) || al.includes(h)) {
          if (al.length >= bestLen) {
            best = field;
            bestLen = al.length;
          }
        }
      }
    }
    return best;
  }

  function scoreTable(table) {
    const trs = Array.from(table.querySelectorAll('tr'));
    if (trs.length < 2) return 0;
    const headCells = Array.from(trs[0].querySelectorAll('th,td')).map((c) => cleanText(c.textContent));
    let hits = 0;
    for (const h of headCells) if (matchField(h)) hits++;
    return hits * 10 + Math.min(trs.length, 50);
  }

  function pickBestTable() {
    const tables = Array.from(document.querySelectorAll('table'));
    let best = null;
    let bestScore = 0;
    for (const t of tables) {
      const s = scoreTable(t);
      if (s > bestScore) {
        bestScore = s;
        best = t;
      }
    }
    return bestScore >= 10 ? best : null;
  }

  function parseHtmlTable(table) {
    const trs = Array.from(table.querySelectorAll('tr'));
    const headCells = Array.from(trs[0].querySelectorAll('th,td')).map((c) => cleanText(c.textContent));
    const colMap = {};
    headCells.forEach((h, i) => {
      const f = matchField(h);
      if (f && colMap[f] == null) colMap[f] = i;
    });
    const rows = [];
    for (let r = 1; r < trs.length; r++) {
      const cells = Array.from(trs[r].querySelectorAll('td,th')).map((c) => cleanText(c.textContent));
      if (!cells.length) continue;
      const get = (f) => (colMap[f] != null ? cells[colMap[f]] : '');
      const orderId = get('orderId') || '';
      if (!orderId || orderId.length < 3) continue;
      const payAmount = parseNumber(get('payAmount'));
      const quantity = parseNumber(get('quantity'));
      const blob = cells.join(' ');
      rows.push({
        orderId: orderId,
        orderStatus: get('orderStatus') || '',
        payTime: get('payTime') || '',
        createTime: get('createTime') || '',
        productName: get('productName') || '',
        sellerSku: get('sellerSku') || '',
        skuId: get('skuId') || '',
        quantity: quantity != null ? quantity : 0,
        payAmount: payAmount != null ? payAmount : 0,
        shippingStatus: get('shippingStatus') || '',
        buyerRegion: get('buyerRegion') || '',
        currencyHint: detectCurrency(blob),
        rawCells: cells
      });
    }
    return { colMap: colMap, rows: rows, headers: headCells };
  }

  /** 无 table 时：尝试 role=row 网格（部分 TK 后台） */
  function parseRoleGrid() {
    const rowEls = Array.from(document.querySelectorAll('[role="row"]'));
    if (rowEls.length < 2) return null;
    const headerRow = rowEls[0];
    const headers = Array.from(headerRow.querySelectorAll('[role="columnheader"],[role="cell"]')).map((c) =>
      cleanText(c.textContent)
    );
    if (!headers.some((h) => matchField(h))) return null;
    const colMap = {};
    headers.forEach((h, i) => {
      const f = matchField(h);
      if (f && colMap[f] == null) colMap[f] = i;
    });
    const rows = [];
    for (let i = 1; i < rowEls.length; i++) {
      const cells = Array.from(rowEls[i].querySelectorAll('[role="cell"],[role="gridcell"]')).map((c) =>
        cleanText(c.textContent)
      );
      if (!cells.length) continue;
      const get = (f) => (colMap[f] != null ? cells[colMap[f]] : '');
      const orderId = get('orderId') || '';
      if (!orderId || orderId.length < 3) continue;
      const payAmount = parseNumber(get('payAmount'));
      const quantity = parseNumber(get('quantity'));
      rows.push({
        orderId: orderId,
        orderStatus: get('orderStatus') || '',
        payTime: get('payTime') || '',
        createTime: get('createTime') || '',
        productName: get('productName') || '',
        sellerSku: get('sellerSku') || '',
        skuId: get('skuId') || '',
        quantity: quantity != null ? quantity : 0,
        payAmount: payAmount != null ? payAmount : 0,
        shippingStatus: get('shippingStatus') || '',
        buyerRegion: get('buyerRegion') || '',
        currencyHint: detectCurrency(cells.join(' ')),
        rawCells: cells
      });
    }
    return { colMap: colMap, rows: rows, headers: headers, source: 'role-grid' };
  }

  function extractOrderIdFromText(text) {
    const s = cleanText(text);
    const m =
      s.match(/\b(\d{10,24})\b/) ||
      s.match(/订单号\s*[:：]?\s*([A-Za-z0-9_-]{6,})/i) ||
      s.match(/Order\s*(?:ID|No\.?|#)\s*[:：]?\s*([A-Za-z0-9_-]{6,})/i);
    return m ? m[1] : '';
  }

  try {
    const url = location.href || '';
    const title = document.title || '';
    let parsed = null;
    let source = 'none';
    const table = pickBestTable();
    if (table) {
      parsed = parseHtmlTable(table);
      source = 'html-table';
    } else {
      const grid = parseRoleGrid();
      if (grid) {
        parsed = grid;
        source = grid.source || 'role-grid';
      }
    }

    const rows = parsed && parsed.rows ? parsed.rows : [];
    let currencyHits = { USD: 0, GBP: 0, EUR: 0, CNY: 0 };
    for (const r of rows) {
      const c = r.currencyHint;
      if (c && currencyHits[c] != null) currencyHits[c]++;
    }
    let currency = 'USD';
    let max = -1;
    for (const [k, v] of Object.entries(currencyHits)) {
      if (v > max) {
        max = v;
        currency = k;
      }
    }

    const ok = rows.length > 0;
    return JSON.stringify({
      ok: ok,
      source: source,
      module: 'orders',
      url: url,
      title: title,
      currency: currency,
      currencyHits: currencyHits,
      headers: parsed && parsed.headers ? parsed.headers : [],
      colMap: parsed && parsed.colMap ? parsed.colMap : {},
      rows: rows,
      rowCount: rows.length,
      error: ok
        ? null
        : '未识别到订单表格（请确认已打开订单列表页；表头需含订单号等）。url=' + url
    });
  } catch (e) {
    return JSON.stringify({
      ok: false,
      source: 'none',
      module: 'orders',
      url: location.href || '',
      rows: [],
      error: String(e && e.message ? e.message : e)
    });
  }
})();
