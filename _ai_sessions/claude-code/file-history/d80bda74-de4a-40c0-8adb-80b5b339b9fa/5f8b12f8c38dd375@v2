    "page_view",
    "conversion_rate",
    "conversion_rate_change_pp",
    "buy_box_percent",
    "ad_impression",
    "ad_clicks",
    "ad_ctr",
    "ad_cost",
    "ad_cost_change_pct",
    "cpc",
    "acos",
    "ad_sales",
