// ---------- compute ----------
const JKEYS=["技术","业务","老板"];
function avgDim(idea,di){let s=0;JKEYS.forEach(k=>s+=idea.j[k][di]);return s/3;}
function avgTotal(idea){let s=0;JKEYS.forEach(k=>s+=idea.j[k][6]);return s/3;}
IDEAS.forEach(i=>{i.total=avgTotal(i);i.dims=DIMS.map((_,di)=>avgDim(i,di));});
const RANKED=[...IDEAS].sort((a,b)=>b.total-a.total);
RANKED.forEach((i,ix)=>i.rank=ix+1);

const F=n=>n.toFixed(1);
function heatBg(v){const a=Math.max(0,Math.min(1,(v-4)/(10-4)));return `rgba(var(--heat-rgb),${(0.06+a*0.66).toFixed(3)})`;}

// ---------- leaderboard ----------
const bl=document.getElementById("boardList");
RANKED.forEach(i=>{
  const m=i.rank<=3?`m${i.rank}`:"";
  const el=document.createElement("div");
  el.className="row"+(i.rank===1?" win":"");
  el.innerHTML=`
    <div class="rank ${m}">${i.rank}</div>
    <div class="r-main">
      <div class="r-name">${i.name}<span class="r-en">${i.en}</span></div>
      <div class="r-tag">${i.tag}</div>
      <div class="r-meta"><span class="chip">${i.cat}</span><span class="chip">工期 ${i.effort} 天</span></div>
    </div>
    <div class="bar-wrap">
      <div class="bar"><span data-w="${i.total*10}"></span></div>
      <div class="bar-lab">加权均分</div>
    </div>
    <div class="score num">${F(i.total)}<small>/10</small></div>`;
  bl.appendChild(el);
});

// ---------- winner ----------
document.getElementById("whyGrid").innerHTML=WINNER.why.map(w=>
  `<div class="why-card"><div class="n">${w.n}</div><div class="h">${w.h}</div><div class="d">${w.d}</div></div>`).join("");
document.getElementById("whatItDoes").textContent=WINNER.what;
const win=IDEAS[0];
document.getElementById("winDims").innerHTML=DIMS.map((d,di)=>{
  const v=win.dims[di];
  return `<div class="dimbar"><div class="dl">${d.k}<span class="w">权重 ${d.w}%</span></div><div class="dt"><span data-w="${v*10}"></span></div><div class="dv num">${F(v)}</div></div>`;
}).join("");
document.getElementById("demoTl").innerHTML=WINNER.demo.map(s=>
  `<div class="tl-item"><div class="tl-t">${s.t}</div><div class="tl-s">${s.s}</div></div>`).join("");
document.getElementById("planGrid").innerHTML=WINNER.plan.map(p=>
  `<div class="pcard"><div class="span">${p.span}</div><div class="pd">${p.d}</div></div>`).join("");
document.getElementById("wowList").innerHTML=WINNER.wow.map(x=>`<li>${x}</li>`).join("");
document.getElementById("riskList").innerHTML=WINNER.risk.map(x=>`<li>${x}</li>`).join("");
document.getElementById("bonusList").innerHTML=WINNER.bonus.map(x=>`<li>${x}</li>`).join("");

// ---------- heatmap ----------
const ht=document.getElementById("heatTable");
let head=`<thead><tr><th class="name">方案</th>`;
DIMS.forEach(d=>head+=`<th>${d.k}<span class="w">${d.w}%</span></th>`);
head+=`<th class="total-h">总分</th></tr></thead>`;
let body="<tbody>";
RANKED.forEach(i=>{
  body+=`<tr class="${i.rank===1?"win-row":""}"><td class="name"><span class="rk num">${String(i.rank).padStart(2,"0")}</span><span class="nm">${i.name}</span></td>`;
  i.dims.forEach(v=>body+=`<td><span class="cell" data-heat="${v}" style="display:inline-block;min-width:34px;padding:4px 6px;">${F(v)}</span></td>`);
  body+=`<td class="total num">${F(i.total)}</td></tr>`;
});
body+="</tbody>";
ht.innerHTML=head+body;

// ---------- runners ----------
document.getElementById("runnerList").innerHTML=RUNNERS.map(r=>
  `<div class="rcard">
     <div class="rh"><span class="silver">${r.rank} 备选</span><h3>${r.name}</h3><span class="rscore num">${r.score}</span></div>
     <div><div class="lbl" style="margin-bottom:6px;">为何入选</div><p>${r.why}</p></div>
     <div class="graft"><div class="lbl" style="margin-bottom:6px;">可嫁接回冠军</div><p>${r.graft}</p></div>
   </div>`).join("");

// ---------- catalog ----------
