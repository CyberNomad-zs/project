import yaml
from bridge.clients.sellfox import SellfoxClient

cfg = yaml.safe_load(open("config/config.g2-3shops.yaml", encoding="utf-8"))
sf = cfg["sellfox"]
client = SellfoxClient(sf["base_url"], sf["client_id"], sf["client_secret"])

# 1) token + 业务连通：查三方仓渠道（未加白会 40005）
