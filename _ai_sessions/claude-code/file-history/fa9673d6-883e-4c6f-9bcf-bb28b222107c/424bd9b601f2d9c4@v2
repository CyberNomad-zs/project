const $=s=>document.querySelector(s);
const stateClass=(t)=>{
  if(["已出库","已发货","已推仓"].includes(t))return "g";
  if(["拣货中","待出库","已拉取"].includes(t))return "w";
  if(["未同步","无记录"].includes(t))return t==="未同步"?"c":"n";
  return "n";
};
const maxSev=o=>{let s=null;o.a.forEach(c=>{const v=ANO[c].sev;if(v==="crit")s="crit";else if(v==="warn"&&s!=="crit")s="warn";else if(v==="info"&&!s)s="info";});return s;};
const fmtRemain=m=>{
  if(m===null)return {t:"已发货",cls:"ok"};
  const over=m<0, abs=Math.abs(m), h=Math.floor(abs/60), mm=abs%60;
  const txt=(h>0?h+"h":"")+mm+"m";
  return {t:(over?"超 ":"")+txt,cls:over?"over":(m<=60?"near":"ok")};
};

// filters
let F={anom:null,pf:null,onlyAnom:false,q:""};

// ---- sources ----
$("#sources").innerHTML=[
  {n:"Temu 欧区",c:ORDERS.filter(o=>o.pf==="Temu").length+" 单"},
  {n:"赛狐 ERP",c:ORDERS.length+" 单"},
  {n:"海外仓 WMS",c:ORDERS.filter(o=>o.w!=="无记录").length+" 单"}
].map(s=>`<div class="src"><span class="dot"></span><b>${s.n}</b><span class="c">${s.c}</span></div>`).join("");

// ---- KPI ----
function renderKPIs(){
  const total=ORDERS.length;
  const waiting=ORDERS.filter(o=>o.p==="待发货").length;
  const stuck=ORDERS.filter(o=>o.a.includes("STUCK")).length;
  const late=ORDERS.filter(o=>o.a.includes("LATE")).length;
  const notrack=ORDERS.filter(o=>o.a.includes("NOTRACK")).length;
  const anom=ORDERS.filter(o=>o.a.length).length;
  const k=[
    {l:"总订单",v:total,s:"近 24h",cls:""},
    {l:"待发货",v:waiting,s:"进行中",cls:""},
    {l:"卡在仓",v:stuck,s:"已推仓未出库",cls:"crit"},
    {l:"超时风险",v:late,s:"临近/已超时效",cls:"crit"},
    {l:"已出未回填",v:notrack,s:"缺运单号",cls:"warn"},
    {l:"异常合计",v:anom,s:`占比 ${Math.round(anom/total*100)}%`,cls:anom?"warn":""}
  ];
  $("#kpis").innerHTML=k.map(x=>`<div class="kpi ${x.cls}"><div class="tick"></div><div class="l">${x.l}</div><div class="v mono">${x.v}</div><div class="s">${x.s}</div></div>`).join("");
}

// ---- AI summary ----
function renderAI(){
  const late=ORDERS.filter(o=>o.a.includes("LATE")).length;
  const stuck=ORDERS.filter(o=>o.a.includes("STUCK")).length;
  const anom=ORDERS.filter(o=>o.a.length).length;
  const over=ORDERS.filter(o=>o.remain!==null&&o.remain<0).length;
  const whs={};ORDERS.filter(o=>o.a.includes("STUCK")).forEach(o=>whs[o.wh]=(whs[o.wh]||0)+1);
  const topWh=Object.keys(whs).sort((a,b)=>whs[b]-whs[a])[0]||"德国仓";
  $("#aiSummary").innerHTML=`<div class="ic">🤖</div><div class="txt">今日共 <b>${anom} 单</b>存在履约风险 —— 其中 <b>${over} 单已超时</b>、<span class="g">${stuck} 单卡在仓未出库</span>、<span class="g">${late} 单临近平台时效</span>。建议优先催 <b>${topWh}</b> 出库，并回填 Temu 运单号以免降权。<span style="color:var(--ink-3)">（点下方预警卡片可下钻）</span></div>`;
}

// ---- anomaly rail ----
function renderRail(){
  const counts={};Object.keys(ANO).forEach(c=>counts[c]=ORDERS.filter(o=>o.a.includes(c)).length);
  $("#rail").innerHTML=Object.keys(ANO).map(c=>{
    const a=ANO[c];
    return `<div class="acard sev-${a.sev} ${F.anom===c?"on":""}" data-a="${c}" role="button" tabindex="0">
      <div class="an">${a.label}</div><div class="av mono">${counts[c]}</div><div class="ad">${a.desc}</div></div>`;
  }).join("");
  document.querySelectorAll(".acard").forEach(el=>{
    const h=()=>{F.anom=F.anom===el.dataset.a?null:el.dataset.a;render();};
    el.onclick=h;el.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();h();}};
  });
}

// ---- presets & platforms ----
const PRESETS=[
  {t:"超时风险",f:o=>o.a.includes("LATE")},
  {t:"卡在仓",f:o=>o.a.includes("STUCK")},
  {t:"未回填运单",f:o=>o.a.includes("NOTRACK")},
  {t:"未同步ERP",f:o=>o.a.includes("NOSYNC")}
];
let activePreset=null;
function renderPresets(){
  $("#presets").innerHTML=PRESETS.map((p,i)=>`<button class="chip ${activePreset===i?"on":""}" data-p="${i}">${p.t}</button>`).join("");
  document.querySelectorAll("#presets .chip").forEach(el=>el.onclick=()=>{
    const i=+el.dataset.p;activePreset=activePreset===i?null:i;$("#nlInput").value=activePreset!==null?PRESETS[i].t:"";render();
  });
  $("#platforms").innerHTML=Object.keys(PF).map(p=>`<button class="chip pf ${F.pf===p?"on":""}" data-pf="${p}"><span class="pd" style="background:${PF[p].c}"></span>${p}</button>`).join("");
  document.querySelectorAll("#platforms .chip").forEach(el=>el.onclick=()=>{F.pf=F.pf===el.dataset.pf?null:el.dataset.pf;render();});
}

// ---- table ----
function applyFilters(){
  return ORDERS.filter(o=>{
    if(F.onlyAnom&&!o.a.length)return false;
    if(F.anom&&!o.a.includes(F.anom))return false;
    if(F.pf&&o.pf!==F.pf)return false;
    if(activePreset!==null&&!PRESETS[activePreset].f(o))return false;
    if(F.q){
      const q=F.q.toLowerCase();
      const kw=[["超时","LATE"],["卡仓","STUCK"],["卡在仓","STUCK"],["运单","NOTRACK"],["回填","NOTRACK"],["同步","NOSYNC"],["库存","STOCK"]];
      let hit=false;
      kw.forEach(([k,c])=>{if(q.includes(k)&&o.a.includes(c))hit=true;});
      if(q.includes("temu")&&o.pf==="Temu")hit=true;
      if(q.includes("amazon")&&o.pf==="Amazon")hit=true;
      if(q.includes("仓")&&o.wh.includes(q.replace(/[的还在卡]/g,"").slice(0,2)))hit=true;
      if(o.sku.toLowerCase().includes(q)||o.id.toLowerCase().includes(q))hit=true;
      if(!hit)return false;
    }
    return true;
  });
}
function renderTable(){
  const rows=applyFilters();
  $("#rowCnt").textContent=rows.length+" / "+ORDERS.length+" 单";
  if(!rows.length){$("#tbody").innerHTML=`<tr><td colspan="10" class="empty">没有符合条件的订单 —— 试试点掉筛选或清空搜索</td></tr>`;return;}
  $("#tbody").innerHTML=rows.map(o=>{
    const sev=maxSev(o), r=fmtRemain(o.remain);
    const flags=o.a.map(c=>{const s=ANO[c].sev;return `<span class="flag ${s==="crit"?"c":s==="warn"?"w":"i"}">${ANO[c].label}</span>`;}).join("");
    return `<tr class="${sev?"sev-"+sev:""}">
      <td><div class="oid">${o.id}</div><div class="buyer">${o.buyer} · ${o.wh}</div></td>
      <td><div class="pf-cell"><span class="pd" style="background:${PF[o.pf].c}"></span>${o.pf}</div></td>
      <td><div class="sku" title="${o.sku}">${o.sku}</div></td>
      <td class="qty">×${o.qty}</td>
      <td>${o.remain===null?'<span class="pill g">已发货</span>':`<span class="clock ${r.cls}" data-remain="${o.remain}">${r.cls==="over"?"⚠ ":"⏱ "}${r.t}</span>`}</td>
      <td><span class="pill ${stateClass(o.p)}">${o.p}</span></td>
      <td><span class="pill ${stateClass(o.e)}">${o.e}</span></td>
      <td><span class="pill ${stateClass(o.w)}">${o.w}</span></td>
      <td>${o.track?`<span class="track">${o.track}</span>`:`<span class="track none">缺运单号</span>`}</td>
      <td><div class="flags">${flags||'<span style="color:var(--ink-3);font-size:.72rem">—</span>'}</div></td>
    </tr>`;
  }).join("");
}

function render(){renderRail();renderPresets();renderTable();}
renderKPIs();renderAI();render();

// nl input
let qt;$("#nlInput").addEventListener("input",e=>{clearTimeout(qt);qt=setTimeout(()=>{F.q=e.target.value.trim();if(!F.q)activePreset=activePreset;render();},160);});
// only-anomaly toggle
$("#onlyAnom").addEventListener("click",e=>{F.onlyAnom=!F.onlyAnom;e.currentTarget.classList.toggle("on",F.onlyAnom);e.currentTarget.setAttribute("aria-checked",F.onlyAnom);render();});
$("#onlyAnom").addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();$("#onlyAnom").click();}});
// export (demo)
$("#exportBtn").addEventListener("click",()=>{
  const rows=applyFilters().filter(o=>o.a.length);
  const head=["订单号","平台","SKU","数量","仓库","应发剩余分钟","平台状态","ERP状态","WMS状态","运单号","异常"];
  const lines=rows.map(o=>[o.id,o.pf,o.sku,o.qty,o.wh,o.remain===null?"":o.remain,o.p,o.e,o.w,o.track||"",o.a.map(c=>ANO[c].label).join("|")].join(","));
  const csv="﻿"+head.join(",")+"\n"+lines.join("\n");
  const blob=new Blob([csv],{type:"text/csv;charset=utf-8"});
  const url=URL.createObjectURL(blob);const link=document.createElement("a");link.href=url;link.download="催发货清单_demo.csv";link.click();URL.revokeObjectURL(url);
});

// live countdown tick
const reduce=window.matchMedia("(prefers-reduced-motion:reduce)").matches;
if(!reduce){
  setInterval(()=>{
    document.querySelectorAll(".clock[data-remain]").forEach(el=>{
      let m=+el.dataset.remain-(1/60);el.dataset.remain=m;
      const r=fmtRemain(Math.round(m));el.className="clock "+r.cls;el.textContent=(r.cls==="over"?"⚠ ":"⏱ ")+r.t;
    });
  },1000);
}
</script>
