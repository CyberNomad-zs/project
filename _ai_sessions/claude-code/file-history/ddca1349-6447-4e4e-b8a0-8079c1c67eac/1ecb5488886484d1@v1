# 2) 拉白名单店待处理
from datetime import datetime, timedelta
end = datetime.now()
start = end - timedelta(days=7)
data = client.get_package_page(
    status="to_process",
    date_start=start.strftime("%Y-%m-%d %H:%M:%S"),
    date_end=end.strftime("%Y-%m-%d %H:%M:%S"),
