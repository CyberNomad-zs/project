# -*- coding: utf-8 -*-
import cv2, os
VID = r"E:\project\海外仓\2026-07-08 09-47-00.mp4"
OUT = r"C:\Users\Administrator\AppData\Local\Temp\claude\E--project----\cb8e0d45-d92d-43e4-9eab-a459f923bdd8\scratchpad\frames"
os.makedirs(OUT, exist_ok=True)
cap = cv2.VideoCapture(VID)
fps = cap.get(cv2.CAP_PROP_FPS)
total = cap.get(cv2.CAP_PROP_FRAME_COUNT)
print("fps=", fps, "总帧=", total, "时长(s)=", round(total/fps, 1))
# 抽 48s ~ 86s，每 2s 一帧
for sec in range(48, 87, 2):
    cap.set(cv2.CAP_PROP_POS_MSEC, sec * 1000)
    ok, frame = cap.read()
    if not ok:
        print("读取失败 @", sec); continue
    p = os.path.join(OUT, f"t{sec:03d}.jpg")
    cv2.imwrite(p, frame, [cv2.IMWRITE_JPEG_QUALITY, 80])
    print("saved", p)
cap.release()
