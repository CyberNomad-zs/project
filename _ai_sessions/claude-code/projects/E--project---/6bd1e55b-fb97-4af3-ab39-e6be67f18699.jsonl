cret: str = \"\"\n     feishu_bitable_app_token: str = \"\"\n     feishu_bitable_table_tasks: str = \"\"\n+    # AMZ 驾驶舱多维表（同一 Base 下三张表；可与 tasks 分 Base）\n+    feishu_bitable_app_token_amz: str = \"\"\n+    feishu_bitable_table_amz_shop_daily: str = \"\"\n+    feishu_bitable_table_amz_link_daily: str = \"\"\n+    feishu_bitable_table_amz_risk: str = \"\"\n+    # TK 驾驶舱（模块 2 多店对比 / 模块 3 广告；空 token 回退 FEISHU_BITABLE_APP_TOKEN）\n+    feishu_bitable_app_token_tk: str = \"\"\n+    feishu_bitable_table_tk_shop_daily: str = \"\"\n+    feishu_bitable_table_tk_ads_campaign: str = \"\"\n     default_task_due_days: int = 3\n     tz: str = \"Asia/Shanghai\"\n \ndiff --git a/backend/app/jobs/worker.py b/backend/app/jobs/worker.py\nindex 8b5c2e8..cbdad88 100644\n--- a/backend/app/jobs/worker.py\n+++ b/backend/app/jobs/worker.py\n@@ -147,11 +147,35 @@ async def drain_outbox_once() -> int:\n             await db.commit()\n             try:\n                 if row[\"event_type\"] in (\"feishu.sync\", \"feishu.job\"):\n-                    # feishu.job 可扩展为全表扫描；Phase0 对 sync 按 task 处理\n                     if row[\"event_type\"] == \"feishu.sync\":\n                         await process_feishu_task_sync(row[\"aggregate_id\"])\n                     else:\n-                        logger.info(\"feishu.job queued %s (phase0: manual drain via task events)\", row[\"aggregate_id\"])\n+                        # 驾驶舱：sync_feishu_job.id = aggregate_id；按 table_key 分发\n+                        async with SessionLocal() as db_job:\n+                            meta = (\n+                                await db_job.execute(\n+                                    text(\n+                                        \"\"\"\n+                                        SELECT table_key FROM sync_feishu_job\n+                                        WHERE id = CAST(:id AS uuid)\n+                                        \"\"\"\n+                                    ),\n+                                    {\"id