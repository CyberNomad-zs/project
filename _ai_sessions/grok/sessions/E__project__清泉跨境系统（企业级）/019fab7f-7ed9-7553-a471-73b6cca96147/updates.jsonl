{"timestamp":1785318250,"method":"session/update","params":{"sessionId":"019fab7f-7ed9-7553-a471-73b6cca96147","update":{"sessionUpdate":"tool_call","toolCallId":"call-6a573696-e318-4e99-a920-2c50befbca7e-181","title":"run_terminal_command","rawInput":{"command":"$root = \"E:\\project\\清泉跨境系统（企业级）\"\n$py = \"$root\\backend\\.venv\\Scripts\\python.exe\"\n$env:DATABASE_URL = \"postgresql+asyncpg://qingquan:qingquan@127.0.0.1:5432/qingquan\"\n$env:INGEST_DEFAULT_API_KEY = \"dev-ingest-key\"\n$env:APP_SECRET_KEY = \"dev\"\n# 前台短时跑 API + 单条中文测试\n$job = Start-Job -ScriptBlock {\n  param($py,$root)\n  $env:DATABASE_URL = \"postgresql+asyncpg://qingquan:qingquan@127.0.0.1:5432/qingquan\"\n  $env:INGEST_DEFAULT_API_KEY = \"dev-ingest-key\"\n  Set-Location \"$root\\backend\"\n  & $py -m uvicorn app.main:app --host 127.0.0.1 --port 8000 2>&1\n} -ArgumentList $py,$root\nStart-Sleep 4\ntry {\n  $h = Invoke-RestMethod http://127.0.0.1:8000/health -TimeoutSec 5\n  Write-Host \"health $($h.status)\"\n  $body = '{\"items\":[{\"platform\":\"tiktok\",\"shop_id\":\"27328767468273\",\"shop_name\":\"SHOP INOUT\",\"biz_date\":\"2026-07-28\",\"collected_at\":\"2026-07-29T09:00:00+00:00\",\"idempotency_key\":\"tiktok_ads:27328767468273:拖把7/13:2026-07-28\",\"payload\":{\"campaign_name\":\"拖把7/13\",\"spend\":178.82,\"orders\":115,\"roi\":9.85,\"revenue\":1762.21,\"daily_budget\":null,\"target_roi\":10.3,\"net_cost\":175.63,\"avg_order_cost\":1.55,\"delivery_status\":\"已生效\",\"plan_status\":\"on\",\"currency\":\"USD\",\"row_status\":\"success\",\"source_url\":\"https://seller-uk.tiktok.com/\"},\"evidence\":{\"source_url\":\"https://seller-uk.tiktok.com/\"}}]}'\n  $bytes = [System.Text.Encoding]::UTF8.GetBytes($body)\n  try {\n    $r = Invoke-WebRequest -Method Post -Uri http://127.0.0.1:8000/api/v1/ingest/tiktok_ads -Headers @{'X-Api-Key'='dev-ingest-key'} -ContentType 'application/json; charset=utf-8' -Body $bytes -TimeoutSec 30\n    Write-Host \"status $($r.StatusCode) $($r.Content)\"\n  } catch {\n    Write-Host \"POST fail: $($_.Exception.Message)\"\n    if ($_.Exception.Response) { $sr = New-Object IO.StreamReader($_.Exception.Response.GetResponseStream()); Write-Host $sr.ReadToEnd() }\n  }\n} finally {\n  Receive-Job $job -ErrorAction SilentlyContinue | Select-Object -Last 40\n  Stop-Job $job -ErrorAction SilentlyContinue\n  Remove-Job $job -Force -ErrorAction SilentlyContinue\n}\n","description":"Foreground API job; test Chinese campaign ingest"},"_meta":{"x.ai/tool":{"version":1,"name":"run_terminal_command","kind":"execute","namespace":"grok_build","label":"Run Command","read_only":false}}},"_meta":{"totalTokens":222118,"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-26398","agentTimestampMs":1785318250460,"promptId":"task-completed-call-e91e8f80-d8bf-42f7-ac98-7b8f64b96106-157","streamStartMs":1785318240623,"turnStartMs":1785317694312,"updateType":"ToolCall","updateParams":{"toolCallId":"call-6a573696-e318-4e99-a920-2c50befbca7e-181","title":"run_terminal_command","kind":"Other","status":"Pending"}}}}
