  "_qingquan_note": "Stage A 旁路：failOpen=true 时中心失败只告警，不阻断飞书。生产把 baseUrl 改成中心地址。",
  "filter": {
    "platformContains": ["TikTok"],
    "nameContains": [],
    "nameExclude": [],
    "requireIp": true,
    "includeStoreIds": [],
    "excludeStoreIds": []
  },
  "_filter_note": "excludeStoreIds 示例：Nookora Home 核验未完成时填 \"27841084722470\"，核验通过后删掉。",
  "adsUrl": {
    "default": "https://seller-uk.tiktok.com/ads-creation/dashboard?shop_region=GB",
