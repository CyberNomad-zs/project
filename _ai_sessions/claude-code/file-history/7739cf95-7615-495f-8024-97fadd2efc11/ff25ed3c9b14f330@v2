        ("GET", f"/base/v2/apps/{APP_TOKEN}/blocks"),
        ("GET", f"/base/v2/apps/{APP_TOKEN}/content"),
        # view get detail
        ("GET", f"/bitable/v1/apps/{APP_TOKEN}/tables/{T1}/views"),
    ]
    for method, path in probes:
        r = req(method, f"https://open.feishu.cn/open-apis{path}", token=token)
        print(f"\n{method} {path}")
