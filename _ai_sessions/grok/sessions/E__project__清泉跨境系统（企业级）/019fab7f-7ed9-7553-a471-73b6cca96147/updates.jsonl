 revenue,\n                \"daily_budget\": r.get(\"dailyBudget\"),\n                \"target_roi\": r.get(\"targetRoi\"),\n                \"net_cost\": r.get(\"netCost\"),\n                \"avg_order_cost\": r.get(\"avgOrderCost\"),\n                \"delivery_status\": r.get(\"deliveryStatus\") or \"\",\n                \"plan_status\": ps,\n                \"currency\": currency,\n                \"row_status\": \"success\",\n                \"source_url\": url or \"\",\n            },\n            \"evidence\": {\"source_url\": url or \"\"},\n        })\n    return items\n\nd = json.loads(DEBUG.read_text(encoding=\"utf-8-sig\"))\npayload = d.get(\"payload\") or {}\nbiz = \"2026-07-28\"  # dateMode yesterday relative to run day 29\nitems = rows_to_items(\n    str(d.get(\"storeId\")),\n    str(d.get(\"displayName\") or d.get(\"storeName\") or \"\"),\n    biz,\n    str(payload.get(\"url\") or d.get(\"adsUrl\") or \"\"),\n    payload.get(\"rows\") or [],\n    str(payload.get(\"currency\") or \"USD\"),\n)\nprint(\"items\", len(items), \"store\", d.get(\"storeId\"))\nprint(post_items(items))\n'@\n$path = \"E:\\project\\清泉跨境系统（企业级）\\collectors\\tiktok-ads\\logs\\_ingest_from_debug.py\"\n[System.IO.File]::WriteAllText($path, $ingestPy)\n& \"E:\\project\\清泉跨境系统（企业级）\\backend\\.venv\\Scripts\\python.exe\" $path\n# verify health still ok after\nInvoke-RestMethod 'http://127.0.0.1:8000/health' -TimeoutSec 5 | ConvertTo-Json -Compress\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"E:\\project\\清泉跨境系统（企业级）","output_file":"","total_bytes":2775,"output_delta":[73,110,118,111,107,101,45,82,101,115,116,77,101,116,104,111,100,32,58,32,206,222,183,168,193,172,189,211,181,189,212,182,179,204,183,254,206,241,198,247,13,10]}},"_meta":{"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-26231","agentTimestampMs":1785318096426}}}
