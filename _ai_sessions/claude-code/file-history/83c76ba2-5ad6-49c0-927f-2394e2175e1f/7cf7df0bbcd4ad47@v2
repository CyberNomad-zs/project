                :quantity, :pay_amount, :currency, :shipping_status, :buyer_region,
                :source_url, CAST(:raw_extra AS jsonb), :collected_at, :ingest_id, now(), now()
            )
            ON CONFLICT (shop_external_id, order_id) DO UPDATE SET
                shop_id = COALESCE(EXCLUDED.shop_id, fact_tiktok_order.shop_id),
                shop_name = COALESCE(EXCLUDED.shop_name, fact_tiktok_order.shop_name),
                order_status = COALESCE(EXCLUDED.order_status, fact_tiktok_order.order_status),
                pay_time = COALESCE(EXCLUDED.pay_time, fact_tiktok_order.pay_time),
                create_time = COALESCE(EXCLUDED.create_time, fact_tiktok_order.create_time),
                biz_date = COALESCE(EXCLUDED.biz_date, fact_tiktok_order.biz_date),
                product_name = COALESCE(EXCLUDED.product_name, fact_tiktok_order.product_name),
                seller_sku = COALESCE(EXCLUDED.seller_sku, fact_tiktok_order.seller_sku),
                sku_id = COALESCE(EXCLUDED.sku_id, fact_tiktok_order.sku_id),
                quantity = EXCLUDED.quantity,
                pay_amount = EXCLUDED.pay_amount,
                currency = COALESCE(EXCLUDED.currency, fact_tiktok_order.currency),
                shipping_status = COALESCE(EXCLUDED.shipping_status, fact_tiktok_order.shipping_status),
                buyer_region = COALESCE(EXCLUDED.buyer_region, fact_tiktok_order.buyer_region),
                source_url = COALESCE(EXCLUDED.source_url, fact_tiktok_order.source_url),
                raw_extra = EXCLUDED.raw_extra,
                collected_at = EXCLUDED.collected_at,
                ingest_id = EXCLUDED.ingest_id,
                updated_at = now()
            """
        ),
        {
