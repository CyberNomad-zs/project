tps://qingquan.jmzlai.com'\n  # keep local as comment alternative in note - actually example can show prod with note\n  [System.IO.File]::WriteAllText($ex, $ex2)\n  Write-Host \"example baseUrl set to prod host (dev can override)\"\n}\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"E:\\project\\清泉跨境系统（企业级）","output_file":"","total_bytes":70,"output_delta":[112,114,111,100,32,104,101,97,108,116,104,58,32,123,34,115,116,97,116,117,115,34,58,34,111,107,34,44,34,116,105,109,101,34,58,34,50,48,50,54,45,48,55,45,51,48,84,48,52,58,53,56,58,48,48,46,50,54,49,52,54,54,43,48,48,58,48,48,34,125]}},"_meta":{"eventId":"019fab7f-7ed9-7553-a471-73b6cca96147-36067","agentTimestampMs":1785387480311}}}
