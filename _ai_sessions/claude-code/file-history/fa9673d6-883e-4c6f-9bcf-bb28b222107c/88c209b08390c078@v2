  `<details class="idea">
     <summary>
       <span class="rk num">${i.rank}</span>
       <span><span class="snm">${i.name}<span class="r-en">${i.en}</span></span><span class="stag">${i.tag}</span></span>
       <span style="display:flex;align-items:center;gap:12px;"><span class="ssc num">${F(i.total)}</span><span class="caret">▸</span></span>
     </summary>
     <div class="idea-body">
       <div class="field"><div class="fk">痛点</div><div class="fv">${i.problem}</div></div>
       <div class="field"><div class="fk">原理</div><div class="fv">${i.how}</div></div>
       <div class="field"><div class="fk">Wow</div><div class="fv">${i.wow}</div></div>
       <div class="field rk"><div class="fk">风险</div><div class="fv">${i.risk}</div></div>
       <div class="field"><div class="fk">评委</div><div class="fv" style="color:var(--ink-2)">${i.verdict}</div></div>
     </div>
   </details>`).join("");

// ---------- strategy ----------
document.getElementById("stratList").innerHTML=STRAT.map((s,ix)=>
  `<div class="scard"><div class="sn num">${String(ix+1).padStart(2,"0")}</div><div><div class="sh">${s.h}</div><div class="sb">${s.b}</div></div></div>`).join("");

// ---------- paint heat cells ----------
document.querySelectorAll(".cell[data-heat]").forEach(c=>{
  c.style.background=heatBg(parseFloat(c.dataset.heat));
});

// ---------- animate bars (staggered "light up", subject-grounded) ----------
const reduce=window.matchMedia("(prefers-reduced-motion:reduce)").matches;
function fill(){
  document.querySelectorAll(".bar span[data-w],.dimbar .dt span[data-w]").forEach((b,ix)=>{
    const w=b.dataset.w+"%";
    b.style.setProperty("--final",w);
    if(reduce){b.style.width=w;return;}
    setTimeout(()=>{b.style.width=w;},80+ix*45);
  });
}
if(reduce){fill();}
else{requestAnimationFrame(()=>requestAnimationFrame(fill));}
</script>
